      <body>
         <div type="edition"
              xml:lang="syc"
              n="urn:cts:pta:pta9999.pta080.pta-syc1">
            <head>
               <title><w xml:id="w1">ܐܓܪܬܐ</w> <w xml:id="w2">ܕܦܘܠܘܣ</w> <w xml:id="w3">ܕܠܘܬ</w> <w xml:id="w4">ܦܝܠܝܡܘܢ</w></title>
            </head>
            <div type="textpart" subtype="chapter" n="1">
               <div type="textpart" subtype="verse" n="1">
                  <p><w xml:id="w5">ܦ݁ܰܘܠܳܘܣ</w> <w xml:id="w6">ܐܰܣܺܝܪܶܗ</w> <w xml:id="w7">ܕ݁ܝܶܫܽܘܥ</w> <w xml:id="w8">ܡܫܺܝܚܳܐ</w> <w xml:id="w9">܁</w> <w xml:id="w10">ܘܛܺܝܡܳܬ݂ܶܐܳܘܣ</w> <w xml:id="w11">ܐܰܚܳܐ</w> <w xml:id="w12">܆</w>
                    <w xml:id="w13">ܠܦ݂ܺܝܠܺܡܳܘܢ</w> <w xml:id="w14">ܚܰܒ݁ܺܝܒ݂ܳܐ</w> <w xml:id="w15">ܘܦ݂ܳܠܚܳܐ</w> <w xml:id="w16">ܕ݁ܥܰܡܰܢ</w> <w xml:id="w17">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="2">
                  <p><w xml:id="w18">ܘܠܰܐܦ݁ܝܰܐ</w> <w xml:id="w19">ܚܰܒ݁ܺܝܒ݂ܬ݁ܰܢ</w> <w xml:id="w20">.</w> <w xml:id="w21">ܘܠܰܐܪܟ݂ܺܝܦ݁ܳܘܣ</w> <w xml:id="w22">ܦ݁ܳܠܚܳܐ</w> <w xml:id="w23">ܕ݁ܥܰܡܰܢ</w> <w xml:id="w24">.</w>
                    <w xml:id="w25">ܘܰܠܥܺܕ̱݁ܬ݁ܳܐ</w> <w xml:id="w26">ܕ݁ܰܒ݂ܒ݂ܰܝܬ݁ܳܟ݂</w> <w xml:id="w27">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="3">
                  <p><w xml:id="w28">ܛܰܝܒ݁ܽܘܬ݂ܳܐ</w> <w xml:id="w29">ܥܰܡܟ݂ܽܘܢ</w> <w xml:id="w30">ܘܰܫܠܳܡܳܐ</w> <w xml:id="w31">܁</w> <w xml:id="w32">ܡܶܢ</w> <w xml:id="w33">ܐܰܠܳܗܳܐ</w> <w xml:id="w34">ܐܰܒ݂ܽܘܢ</w> <w xml:id="w35">܆</w> <w xml:id="w36">ܘܡܶܢ</w>
                    <w xml:id="w37">ܡܳܪܰܢ</w> <w xml:id="w38">ܝܶܫܽܘܥ</w> <w xml:id="w39">ܡܫܺܝܚܳܐ</w> <w xml:id="w40">܀</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w41">ܡܰܘܕ݁ܶܐ</w> <w xml:id="w42">ܐ̱ܢܳܐ</w> <w xml:id="w43">ܠܰܐܠܳܗܝ</w> <w xml:id="w44">ܒ݁ܟ݂ܽܠܙܒ݂ܰܢ</w> <w xml:id="w45">.</w> <w xml:id="w46">ܘܡܶܬ݁ܕ݁ܟ݂ܰܪ</w> <w xml:id="w47">ܐ̱ܢܳܐ</w> <w xml:id="w48">ܠܳܟ݂</w>
                    <w xml:id="w49">ܒ݁ܰܨܠܰܘܳܬ݂ܝ̈</w> <w xml:id="w50">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
                  <p><w xml:id="w51">ܗܳܐ</w> <w xml:id="w52">ܡܶܢ</w> <w xml:id="w53">ܕ݁ܫܶܡܥܶܬ݂</w> <w xml:id="w54">ܗܰܝܡܳܢܽܘܬ݂ܳܟ݂</w> <w xml:id="w55">.</w> <w xml:id="w56">ܘܚܽܘܒ݁ܳܐ</w> <w xml:id="w57">܁</w> <w xml:id="w58">ܕ݁ܺܐܝܬ݂</w> <w xml:id="w59">ܠܳܟ݂</w>
                    <w xml:id="w60">ܠܘܳܬ݂</w> <w xml:id="w61">ܡܳܪܰܢ</w> <w xml:id="w62">ܝܶܫܽܘܥ</w> <w xml:id="w63">ܘܰܠܘܳܬ݂</w> <w xml:id="w64">ܟ݁ܽܠܗܽܘܢ</w> <w xml:id="w65">ܩܰܕ݁ܺܝܫܶܐ̈</w> <w xml:id="w66">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w67">ܕ݁ܬ݂ܶܗܘܶܐ</w> <w xml:id="w68">܆</w> <w xml:id="w69">ܫܰܘܬ݁ܳܦ݂ܽܘܬ݂ܳܐ</w> <w xml:id="w70">ܕ݁ܗܰܝܡܳܢܽܘܬ݂ܳܟ݂</w> <w xml:id="w71">ܝܳܗܒ݁ܳܐ</w> <w xml:id="w72">ܦ݁ܺܐܪܶܐ̈</w> <w xml:id="w73">܇</w>
                    <w xml:id="w74">ܒ݁ܰܥܒ݂ܳܕ݂ܶܐ̈</w> <w xml:id="w75">܁</w> <w xml:id="w76">ܘܒ݂ܺܝܕ݂ܰܥܬ݂ܳܐ</w> <w xml:id="w77">ܕ݁ܟ݂ܽܠ</w> <w xml:id="w78">ܛܳܒ݂ܳܢ̈</w> <w xml:id="w79">܁</w> <w xml:id="w80">ܕ݁ܺܐܝܬ݂</w> <w xml:id="w81">ܠܟ݂ܽܘܢ</w> <w xml:id="w82">ܒ݁ܝܶܫܽܘܥ</w> <w xml:id="w83">ܡܫܺܝܚܳܐ</w>
                    <w xml:id="w84">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w85">ܚܰܕ݂ܽܘܬ݂ܳܐ</w> <w xml:id="w86">ܓ݁ܶܝܪ</w> <w xml:id="w87">ܣܰܓ݁ܺܝܐܬ݂ܳܐ</w> <w xml:id="w88">ܐܺܝܬ݂</w> <w xml:id="w89">ܠܰܢ</w> <w xml:id="w90">ܘܒ݂ܽܘܝܳܐܳܐ</w> <w xml:id="w91">܆</w> <w xml:id="w92">ܕ݁ܰܒ݂ܝܰܕ݂</w>
                    <w xml:id="w93">ܚܽܘܒ݂ܳܟ݂</w> <w xml:id="w94">ܐܶܬ݁ܬ݁ܢܺܝܚܘ</w> <w xml:id="w95">ܪܰܚܡܶܐ̈</w> <w xml:id="w96">ܕ݁ܩܰܕ݁ܺܝܫܶܐ̈</w> <w xml:id="w97">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w98">ܡܶܛܽܠ</w> <w xml:id="w99">ܗܳܕ݂ܶܐ</w> <w xml:id="w100">ܦ݁ܰܪܶܗ̱ܣܺܝܰܐ</w> <w xml:id="w101">ܣܰܓ݁ܺܝܐܬ݂ܳܐ</w> <w xml:id="w102">ܐܺܝܬ݂</w> <w xml:id="w103">ܠܺܝ</w> <w xml:id="w104">ܒ݁ܰܡܫܺܝܚܳܐ</w> <w xml:id="w105">܆</w>
                    <w xml:id="w106">ܕ݁ܶܐܦ݂ܩܽܘܕ݂</w> <w xml:id="w107">ܠܳܟ݂</w> <w xml:id="w108">ܐܰܝܠܶܝܢ</w> <w xml:id="w109">ܕ݁ܙܳܕ݂ܩܳܢ̈</w> <w xml:id="w110">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w111">ܡܶܛܽܠ</w> <w xml:id="w112">ܚܽܘܒ݁ܳܐ</w> <w xml:id="w113">ܕ݁ܶܝܢ</w> <w xml:id="w114">ܡܶܒ݂ܥܳܐ</w> <w xml:id="w115">ܗ̱ܽܘ</w> <w xml:id="w116">ܒ݁ܳܥܶܐ</w> <w xml:id="w117">ܐ̱ܢܳܐ</w> <w xml:id="w118">ܡܶܢܳܟ݂</w> <w xml:id="w119">܁</w> <w xml:id="w120">ܐܶܢܳܐ</w>
                    <w xml:id="w121">ܦ݁ܰܘܠܳܘܣ</w> <w xml:id="w122">܆</w> <w xml:id="w123">ܕ݁ܺܐܝܬ݂ܰܝ</w> <w xml:id="w124">ܣܳܒ݂ܳܐ</w> <w xml:id="w125">ܐܰܝܟ݂</w> <w xml:id="w126">ܕ݁ܝܳܕ݂ܰܥ</w> <w xml:id="w127">ܐܰܢ̱ܬ݁</w> <w xml:id="w128">܇</w> <w xml:id="w129">ܗܳܫܳܐ</w> <w xml:id="w130">ܕ݁ܶܝܢ</w> <w xml:id="w131">ܐܳܦ݂</w> <w xml:id="w132">ܐܰܣܺܝܪܳܐ</w>
                    <w xml:id="w133">ܕ݁ܝܶܫܽܘܥ</w> <w xml:id="w134">ܡܫܺܝܚܳܐ</w> <w xml:id="w135">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w136">ܘܒ݂ܳܥܶܐ</w> <w xml:id="w137">ܐ̱ܢܳܐ</w> <w xml:id="w138">ܡܶܢܳܟ݂</w> <w xml:id="w139">܆</w> <w xml:id="w140">ܥܰܠ</w> <w xml:id="w141">ܒ݁ܶܪܝ</w> <w xml:id="w142">ܐܰܝܢܳܐ</w> <w xml:id="w143">ܕ݁ܝܶܠܕ݁ܶܬ݂</w>
                    <w xml:id="w144">ܒ݁ܰܐܣܽܘܪܰܝ̈</w> <w xml:id="w145">.</w> <w xml:id="w146">ܐܳܢܺܣܺܝܡܳܘܣ</w> <w xml:id="w147">܇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w148">ܗܰܘ</w> <w xml:id="w149">ܕ݁ܒ݂ܰܙܒ݂ܰܢ</w> <w xml:id="w150">ܠܰܝܬ݁</w> <w xml:id="w151">ܗ̱ܘܳܐ</w> <w xml:id="w152">ܠܳܟ݂</w> <w xml:id="w153">ܒ݁ܶܗ</w> <w xml:id="w154">ܚܰܫܚܽܘ</w> <w xml:id="w155">܇</w> <w xml:id="w156">ܗܳܫܳܐ</w> <w xml:id="w157">ܕ݁ܶܝܢ</w>
                    <w xml:id="w158">ܐܳܦ݂</w> <w xml:id="w159">ܠܳܟ݂</w> <w xml:id="w160">ܐܳܦ݂</w> <w xml:id="w161">ܠܺܝ</w> <w xml:id="w162">ܛܳܒ݂</w> <w xml:id="w163">ܚܳܫܰܚ</w> <w xml:id="w164">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w165">ܘܫܰܕ݁ܰܪܬ݁ܶܗ</w> <w xml:id="w166">ܠܳܟ݂</w> <w xml:id="w167">.</w> <w xml:id="w168">ܐܰܢ̱ܬ݁</w> <w xml:id="w169">ܕ݁ܶܝܢ</w> <w xml:id="w170">ܐܰܝܟ݂</w> <w xml:id="w171">ܕ݁ܰܠܝܰܠܕ݁ܳܐ</w> <w xml:id="w172">ܕ݁ܺܝܠܝ</w> <w xml:id="w173">܁</w>
                    <w xml:id="w174">ܗܳܟ݂ܰܢܳܐ</w> <w xml:id="w175">ܩܰܒ݁ܶܠܳܝܗ̱ܝ</w> <w xml:id="w176">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w177">ܨܳܒ݂ܶܐ</w> <w xml:id="w178">ܗ̱ܘܺܝܬ݂</w> <w xml:id="w179">ܓ݁ܶܝܪ</w> <w xml:id="w180">ܕ݁ܰܠܘܳܬ݂ܝ</w> <w xml:id="w181">ܐܶܚܕ݁ܺܝܘܗ̱ܝ</w> <w xml:id="w182">܆</w> <w xml:id="w183">ܕ݁ܢܶܗܘܶܐ</w> <w xml:id="w184">ܡܫܰܡܶܫ</w>
                    <w xml:id="w185">ܠܺܝ</w> <w xml:id="w186">ܚܠܳܦ݂ܰܝܟ݁</w> <w xml:id="w187">ܒ݁ܰܐܣܽܘܪܶܐ̈</w> <w xml:id="w188">ܕ݁ܶܐܘܰܢܓ݁ܶܠܺܝܳܘܢ</w> <w xml:id="w189">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w190">ܒ݁ܶܠܥܳܕ݂</w> <w xml:id="w191">ܡܶܠܟ݁ܳܟ݂</w> <w xml:id="w192">ܕ݁ܶܝܢ</w> <w xml:id="w193">ܠܳܐ</w> <w xml:id="w194">ܨܒ݂ܺܝܬ݂</w> <w xml:id="w195">ܡܶܕ݁ܶܡ</w> <w xml:id="w196">ܠܡܶܥܒ݁ܰܕ݂</w> <w xml:id="w197">܆</w> <w xml:id="w198">ܕ݁ܠܳܐ</w>
                    <w xml:id="w199">ܐܰܝܟ݂</w> <w xml:id="w200">ܕ݁ܒ݂ܰܩܛܺܝܪܳܐ</w> <w xml:id="w201">ܬ݁ܶܗܘܶܐ</w> <w xml:id="w202">ܛܳܒ݂ܬ݂ܳܟ݂</w> <w xml:id="w203">܇</w> <w xml:id="w204">ܐܶܠܳܐ</w> <w xml:id="w205">ܒ݁ܨܶܒ݂ܝܳܢܳܟ݂</w> <w xml:id="w206">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w207">ܟ݁ܒ݂ܰܪ</w> <w xml:id="w208">ܕ݁ܶܝܢ</w> <w xml:id="w209">ܐܳܦ݂</w> <w xml:id="w210">ܡܶܛܽܠ</w> <w xml:id="w211">ܗܳܕ݂ܶܐ</w> <w xml:id="w212">ܫܰܢܺܝ</w> <w xml:id="w213">ܕ݁ܫܳܥܬ݂ܳܐ</w> <w xml:id="w214">܆</w> <w xml:id="w215">ܕ݁ܰܠܥܳܠܰܡ</w>
                    <w xml:id="w216">ܬ݁ܶܐܚܕ݁ܺܝܘܗ̱ܝ</w> <w xml:id="w217">܇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w218">ܠܳܐ</w> <w xml:id="w219">ܡܶܟ݁ܺܝܠ</w> <w xml:id="w220">ܐܰܝܟ݂</w> <w xml:id="w221">ܥܰܒ݂ܕ݁ܳܐ</w> <w xml:id="w222">.</w> <w xml:id="w223">ܐܶܠܳܐ</w> <w xml:id="w224">ܝܰܬ݁ܺܝܪ</w> <w xml:id="w225">ܡܶܢ</w> <w xml:id="w226">ܥܰܒ݂ܕ݁ܳܐ</w> <w xml:id="w227">.</w>
                    <w xml:id="w228">ܐܰܚܳܐ</w> <w xml:id="w229">ܚܰܒ݁ܺܝܒ݂ܳܐ</w> <w xml:id="w230">ܕ݁ܺܝܠܝ</w> <w xml:id="w231">ܚܰܕ݂</w> <w xml:id="w232">ܟ݁ܡܳܐ</w> <w xml:id="w233">ܕ݁ܺܝܠܳܟ݂</w> <w xml:id="w234">.</w> <w xml:id="w235">ܘܒ݂ܰܒ݂ܣܰܪ</w> <w xml:id="w236">ܘܰܒ݂ܡܳܪܰܢ</w> <w xml:id="w237">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w238">ܐܶܢ</w> <w xml:id="w239">ܗܳܟ݂ܺܝܠ</w> <w xml:id="w240">ܐܺܝܬ݂ܰܝܟ݁</w> <w xml:id="w241">ܠܺܝ</w> <w xml:id="w242">ܫܰܘܬ݁ܳܦ݂ܳܐ</w> <w xml:id="w243">܆</w> <w xml:id="w244">ܩܰܒ݁ܶܠܳܝܗ̱ܝ</w> <w xml:id="w245">ܐܰܝܟ݂</w>
                    <w xml:id="w246">ܕ݁ܠܺܝ</w> <w xml:id="w247">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="18">
                  <p><w xml:id="w248">ܘܶܐܢ</w> <w xml:id="w249">ܡܶܕ݁ܶܡ</w> <w xml:id="w250">ܚܰܣܪܳܟ݂</w> <w xml:id="w251">ܐܰܘ</w> <w xml:id="w252">ܚܰܝܳܒ݂</w> <w xml:id="w253">܆</w> <w xml:id="w254">ܗܳܕ݂ܶܐ</w> <w xml:id="w255">ܥܠܰܝ</w> <w xml:id="w256">ܚܫܽܘܒ݂</w> <w xml:id="w257">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w258">ܐܶܢܳܐ</w> <w xml:id="w259">ܦ݁ܰܘܠܳܘܣ</w> <w xml:id="w260">ܟ݁ܶܬ݂ܒ݁ܶܬ݂</w> <w xml:id="w261">ܒ݁ܺܐܝܕ݂ܰܝ̈</w> <w xml:id="w262">.</w> <w xml:id="w263">ܐܶܢܳܐ</w> <w xml:id="w264">ܦ݁ܳܪܰܥ</w> <w xml:id="w265">ܐ̱ܢܳܐ</w> <w xml:id="w266">܆</w>
                    <w xml:id="w267">ܕ݁ܠܳܐ</w> <w xml:id="w268">ܐܺܡܰܪ</w> <w xml:id="w269">ܠܳܟ݂</w> <w xml:id="w270">܇</w> <w xml:id="w271">ܕ݁ܳܐܦ݂</w> <w xml:id="w272">ܢܰܦ݂ܫܳܟ݂</w> <w xml:id="w273">ܚܰܝܳܒ݂</w> <w xml:id="w274">ܐܰܢ̱ܬ݁</w> <w xml:id="w275">ܠܺܝ</w> <w xml:id="w276">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="20">
                  <p><w xml:id="w277">ܐܺܝܢ</w> <w xml:id="w278">ܐܳܚܝ</w> <w xml:id="w279">.</w> <w xml:id="w280">ܐܶܢܳܐ</w> <w xml:id="w281">ܐܶܬ݁ܬ݁ܢܺܝܚ</w> <w xml:id="w282">ܒ݁ܳܟ݂</w> <w xml:id="w283">ܒ݁ܡܳܪܰܢ</w> <w xml:id="w284">.</w> <w xml:id="w285">ܐܰܢܺܝܚ</w> <w xml:id="w286">ܪܰܚܡܰܝ̈</w>
                    <w xml:id="w287">ܒ݁ܰܡܫܺܝܚܳܐ</w> <w xml:id="w288">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="21">
                  <p><w xml:id="w289">ܡܶܛܽܠ</w> <w xml:id="w290">ܕ݁ܰܬ݂ܟ݂ܺܝܠ</w> <w xml:id="w291">ܐ̱ܢܳܐ</w> <w xml:id="w292">ܕ݁ܫܳܡܰܥ</w> <w xml:id="w293">ܐܰܢ̱ܬ݁</w> <w xml:id="w294">ܠܺܝ</w> <w xml:id="w295">܆</w> <w xml:id="w296">ܟ݁ܶܬ݂ܒ݁ܶܬ݂</w> <w xml:id="w297">ܠܳܟ݂</w>
                    <w xml:id="w298">.</w> <w xml:id="w299">ܘܝܳܕ݂ܰܥ</w> <w xml:id="w300">ܐ̱ܢܳܐ</w> <w xml:id="w301">܁</w> <w xml:id="w302">ܕ݁ܝܰܬ݁ܺܝܪ</w> <w xml:id="w303">ܡܶܢ</w> <w xml:id="w304">ܡܳܐ</w> <w xml:id="w305">ܕ݁ܳܐܡܰܪ</w> <w xml:id="w306">ܐ̱ܢܳܐ</w> <w xml:id="w307">܇</w> <w xml:id="w308">ܥܳܒ݂ܶܕ݂</w> <w xml:id="w309">ܐܰܢ̱ܬ݁</w> <w xml:id="w310">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="22">
                  <p><w xml:id="w311">ܒ݁ܰܚܕ݂ܳܐ</w> <w xml:id="w312">ܕ݁ܶܝܢ</w> <w xml:id="w313">ܐܳܦ݂</w> <w xml:id="w314">ܛܰܝܶܒ݂</w> <w xml:id="w315">ܠܺܝ</w> <w xml:id="w316">ܒ݁ܶܝܬ݂</w> <w xml:id="w317">ܡܰܫܪܝܳܐ</w> <w xml:id="w318">.</w> <w xml:id="w319">ܡܣܰܒ݁ܰܪ</w>
                    <w xml:id="w320">ܐ̱ܢܳܐ</w> <w xml:id="w321">ܓ݁ܶܝܪ</w> <w xml:id="w322">܆</w> <w xml:id="w323">ܕ݁ܒ݂ܰܨܠܰܘܳܬ݂ܟ݂ܽܘܢ̈</w> <w xml:id="w324">ܡܶܬ݂ܺܝܗܶܒ݂</w> <w xml:id="w325">ܐ̱ܢܳܐ</w> <w xml:id="w326">ܠܟ݂ܽܘܢ</w> <w xml:id="w327">܀</w></p>
               </div>
               <div type="textpart" subtype="verse" n="23">
                  <p><w xml:id="w328">ܫܳܐܶܠ</w> <w xml:id="w329">ܒ݁ܰܫܠܳܡܳܟ݂</w> <w xml:id="w330">ܐܶܦ݁ܰܦ݂ܪܰܐ</w> <w xml:id="w331">ܫܰܒ݂ܝܳܐ</w> <w xml:id="w332">ܕ݁ܥܰܡܝ</w> <w xml:id="w333">ܒ݁ܝܶܫܽܘܥ</w> <w xml:id="w334">ܡܫܺܝܚܳܐ</w>
                    <w xml:id="w335">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="24">
                  <p><w xml:id="w336">ܘܡܰܪܩܳܘܣ</w> <w xml:id="w337">ܘܰܐܪܺܣܛܰܪܟ݂ܳܘܣ</w> <w xml:id="w338">.</w> <w xml:id="w339">ܘܕ݂ܺܡܰܐ</w> <w xml:id="w340">.</w> <w xml:id="w341">ܘܠܽܘܩܰܐ</w> <w xml:id="w342">ܡܥܰܕ݁ܪܳܢܰܝ̈</w>
                    <w xml:id="w343">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="25">
                  <p><w xml:id="w344">ܛܰܝܒ݁ܽܘܬ݂ܶܗ</w> <w xml:id="w345">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w346">ܝܶܫܽܘܥ</w> <w xml:id="w347">ܡܫܺܝܚܳܐ</w> <w xml:id="w348">ܥܰܡ</w> <w xml:id="w349">ܪܽܘܚܟ݂ܽܘܢ</w> <w xml:id="w350">܂</w> <w xml:id="w351">ܐܰܡܺܝܢ</w>
                    <w xml:id="w352">܀</w><w xml:id="w353">.</w><w xml:id="w354">܀</w><w xml:id="w355">.</w><w xml:id="w356">܀</w><w xml:id="w357">܀</w></p>
               </div>
            </div>
         </div>
      </body>
