               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w824">ܢܬܬܥܝܪܘܢ</w> <w xml:id="w825">ܘܢܣܩܘܢ</w> <w xml:id="w826">ܥܡ̈ܡܐ</w> <w xml:id="w827">ܠܥܘܡܩܐ</w> <w xml:id="w828">ܕܝܘܫܦܛ</w> <w xml:id="w829">ܡܛܠ</w> <w xml:id="w830">ܕܬܡܢ</w> <w xml:id="w831">ܐܬܒ</w> <w xml:id="w832">ܠܡܕܢ</w> <w xml:id="w833">ܠܟܠܗܘܢ</w> <w xml:id="w834">ܥܡ̈ܡܐܕܚܕܝܪ̈ܝܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w835">ܫܪܪܘ</w> <w xml:id="w836">ܡ̈ܓܠܐ</w> <w xml:id="w837">ܡܛܠ</w> <w xml:id="w838">ܕܒܫܠ</w> <w xml:id="w839">ܩܛܦܐ</w> <w xml:id="w840">ܥܘܠܘ</w> <w xml:id="w841">ܕܘܫܘ</w> <w xml:id="w842">ܡܛܠ</w> <w xml:id="w843">ܕܡܠܘ</w> <w xml:id="w844">ܓܘ̈ܒܐ</w> <w xml:id="w845">ܘܫܦܥ</w> <w xml:id="w846">ܡܥܨܪ̈ܬܐ</w> <w xml:id="w847">ܡܛܠܕܣܓܝܬ</w> <w xml:id="w848">ܒܝܫܘܬܗܘܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w849">ܪܓܫܐ</w> <w xml:id="w850">ܕܪ̈ܓܘܫܝܐ</w> <w xml:id="w851">ܒܥܘܡܩܐ</w> <w xml:id="w852">ܕܦܣ̈ܝܩܬܐ</w> <w xml:id="w853">ܡܛܠ</w> <w xml:id="w854">ܕܩܪܝܒ</w> <w xml:id="w855">ܗܘ</w> <w xml:id="w856">ܝܘܡܗ</w> <w xml:id="w857">ܕܡܪܝܐ</w> <w xml:id="w858">ܒܥܘܡܩܐ</w> <w xml:id="w859">ܕܦܣܝ̈ܩܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w860">ܫܡܫܐ</w> <w xml:id="w861">ܘܣܗܪܐ</w> <w xml:id="w862">ܚܫܟܘ</w> <w xml:id="w863">ܘܥܪܒ</w> <w xml:id="w864">ܢܘܗܪܐ</w> <w xml:id="w865">ܕܟܘ̈ܟܒܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w866">ܘܡܪܝܐ</w> <w xml:id="w867">ܡܢ</w> <w xml:id="w868">ܨܗܝܘܢ</w> <w xml:id="w869">ܢܢܗܡ</w> <w xml:id="w870">ܘܡܢ</w> <w xml:id="w871">ܐܘܪܫܠܡ</w> <w xml:id="w872">ܢܬܠ</w> <w xml:id="w873">ܩܠܗ</w> <w xml:id="w874">ܘܢܙܘܥܘܢ</w> <w xml:id="w875">ܫܡܝܐ</w> <w xml:id="w876">ܘܐܪܥܐ</w> <w xml:id="w877">ܘܡܪܝܐ</w> <w xml:id="w878">ܢܚܘܣܥܠ</w> <w xml:id="w879">ܥܡܗ</w> <w xml:id="w880">ܘܢܚܝܠ</w> <w xml:id="w881">ܠܒܢ̈ܝ</w> <w xml:id="w882">ܐܝܣܪܝܠ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w883">ܘܬܕܥܘܢ</w> <w xml:id="w884">ܕܐܢܐ</w> <w xml:id="w885">ܐܢܐ</w> <w xml:id="w886">ܡܪܝܐ</w> <w xml:id="w887">ܐܠܗܟܘܢ</w> <w xml:id="w888">ܕܥܡܪ</w> <w xml:id="w889">ܐܢܐ</w> <w xml:id="w890">ܒܨܗܝܘܢ</w> <w xml:id="w891">ܛܘܪܐ</w> <w xml:id="w892">ܕܩܘܕܫܝ</w> <w xml:id="w893">ܘܬܗܘܐ</w> <w xml:id="w894">ܐܘܪܫܠܡܩܕܝܫܐ</w> <w xml:id="w895">ܘܢܘܟܪ̈ܝܐ</w> <w xml:id="w896">ܬܘܒ</w> <w xml:id="w897">ܠܐ</w> <w xml:id="w898">ܢܥܡܪܘܢ</w> <w xml:id="w899">ܒܗ̇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="18">
                  <p><w xml:id="w900">ܒܗ</w> <w xml:id="w901">ܒܝܘܡܐ</w> <w xml:id="w902">ܗ̇ܘ</w> <w xml:id="w903">ܢܛܦܘܢ</w> <w xml:id="w904">ܛܘܪ̈ܐ</w> <w xml:id="w905">ܚܠܝܘܬܐ</w> <w xml:id="w906">ܘܪ̈ܡܬܐ</w> <w xml:id="w907">ܢܪ̈ܕܝܢ</w> <w xml:id="w908">ܚܠܒܐ</w> <w xml:id="w909">ܘܟܠܗܘܢ</w> <w xml:id="w910">ܦܨ̈ܝܕܐܕܝܗܘܕܐ</w> <w xml:id="w911">ܢܪܕܘܢ</w> <w xml:id="w912">ܡ̈ܝܐ</w> <w xml:id="w913">ܘܡܒܘܥܐ</w> <w xml:id="w914">ܡܢ</w> <w xml:id="w915">ܒܝܬܗ</w> <w xml:id="w916">ܕܡܪܝܐ</w> <w xml:id="w917">ܢܦܘܩ</w> <w xml:id="w918">ܘܢܫܩܐ</w> <w xml:id="w919">ܠܢܚܠܐ</w> <w xml:id="w920">ܕܣܛܝܡ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w921">ܡܨܪܝܢ</w> <w xml:id="w922">ܠܚܒܠܐ</w> <w xml:id="w923">ܬܗܘܐ</w> <w xml:id="w924">ܘܐܕܘܡ</w> <w xml:id="w925">ܠܡܕܒܪܐ</w> <w xml:id="w926">ܚܪܒܐ</w> <w xml:id="w927">ܡܢ</w> <w xml:id="w928">ܚܛܘܦܝܐ</w> <w xml:id="w929">ܕܒܢ̈ܝ</w> <w xml:id="w930">ܝܗܘܕܐ</w> <w xml:id="w931">ܕܐܫܕܘ</w> <w xml:id="w932">ܕܡܐܙܟܝܐ</w> <w xml:id="w933">ܒܐܪܥܗܘܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="20">
                  <p><w xml:id="w934">ܝܗܘܕܐ</w> <w xml:id="w935">ܠܥܠܡ</w> <w xml:id="w936">ܬܬܒ</w> <w xml:id="w937">ܘܐܘܪܫܠܡ</w> <w xml:id="w938">ܠܕܪ̈ܕܪܝܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="21">
                  <p><w xml:id="w939">ܘܐܬܒܥ</w> <w xml:id="w940">ܕܡܗܘܢ</w> <w xml:id="w941">ܘܠܐ</w> <w xml:id="w942">ܐܚܣܐ</w> <w xml:id="w943">ܘܡܪܝܐ</w> <w xml:id="w944">ܥܡܪ</w> <w xml:id="w945">ܒܨܗܝܘܢ</w></p>
               </div>
            </div>
         </div>
      </body>
