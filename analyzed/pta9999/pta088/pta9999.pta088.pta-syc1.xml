              n="urn:cts:pta:pta9999.pta088.pta-syc1">
            <head>
               <title><w xml:id="w1">ܐܓܪܬܐ</w> <w xml:id="w2">ܕܝܗܘܕܐ</w> <w xml:id="w3">ܫܠܝܚܐ</w></title>
            </head>
            <div type="textpart" subtype="chapter" n="1">
               <div type="textpart" subtype="verse" n="1">
                  <p><w xml:id="w4">ܝܺܗܽܘܕ݂ܳܐ</w> <w xml:id="w5">ܥܰܒ݂ܕ݁ܳܐ</w> <w xml:id="w6">ܕ݁ܝܶܫܽܘܥ</w> <w xml:id="w7">ܡܫܺܝܚܳܐ</w> <w xml:id="w8">܇</w> <w xml:id="w9">ܐܰܚܳܐ</w> <w xml:id="w10">ܕ݁ܶܝܢ</w> <w xml:id="w11">ܕ݁ܝܰܥܩܽܘܒ݂</w>
                    <w xml:id="w12">܆</w> <w xml:id="w13">ܠܥܰܡ̱ܡܶܐ̈</w> <w xml:id="w14">ܩܪܰܝܳܐ̈</w> <w xml:id="w15">ܕ݁ܒ݂ܰܐܠܳܗܳܐ</w> <w xml:id="w16">ܐܰܒ݂ܳܐ</w> <w xml:id="w17">ܪܚܺܝܡܺܝܢ</w> <w xml:id="w18">܇</w> <w xml:id="w19">ܘܰܒ݂ܝܶܫܽܘܥ</w> <w xml:id="w20">ܡܫܺܝܚܳܐ</w> <w xml:id="w21">ܢܛܺܝܪܺܝܢ</w>
                    <w xml:id="w22">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="2">
                  <p><w xml:id="w23">ܪܰܚܡܶܐ̈</w> <w xml:id="w24">ܘܰܫܠܳܡܳܐ</w> <w xml:id="w25">ܘܚܽܘܒ݁ܳܐ</w> <w xml:id="w26">܂</w> <w xml:id="w27">ܢܶܣܓ݁ܶܐ</w> <w xml:id="w28">ܠܟ݂ܽܘܢ</w> <w xml:id="w29">܀</w></p>
               </div>
               <div type="textpart" subtype="verse" n="3">
                  <p><w xml:id="w30">ܚܰܒ݁ܺܝܒ݂ܰܝ̈</w> <w xml:id="w31">܆</w> <w xml:id="w32">ܟ݁ܰܕ݂</w> <w xml:id="w33">ܟ݁ܽܠܳܗ</w> <w xml:id="w34">ܝܰܨܺܝܦ݂ܽܘܬ݂ܳܐ</w> <w xml:id="w35">ܥܳܒ݂ܶܕ݂</w> <w xml:id="w36">ܐ̱ܢܳܐ</w>
                    <w xml:id="w37">ܠܡܶܟ݂ܬ݁ܰܒ݂</w> <w xml:id="w38">ܠܟ݂ܽܘܢ</w> <w xml:id="w39">܁</w> <w xml:id="w40">ܥܰܠ</w> <w xml:id="w41">ܚܰܝܶܐ̈</w> <w xml:id="w42">ܕ݁ܺܝܠܰܢ</w> <w xml:id="w43">ܕ݁ܓ݂ܰܘܳܐ</w> <w xml:id="w44">܆</w> <w xml:id="w45">ܐܰܢܰܢܩܺܐ</w> <w xml:id="w46">ܐܺܝܬ݂</w> <w xml:id="w47">ܠܺܝ</w> <w xml:id="w48">ܠܡܶܟ݂ܬ݁ܰܒ݂</w>
                    <w xml:id="w49">ܠܟ݂ܽܘܢ</w> <w xml:id="w50">܇</w> <w xml:id="w51">ܟ݁ܰܕ݂</w> <w xml:id="w52">ܡܦ݁ܺܝܣ</w> <w xml:id="w53">ܐ̱ܢܳܐ</w> <w xml:id="w54">܆</w> <w xml:id="w55">ܕ݁ܰܐܓ݂ܽܘܢܳܐ</w> <w xml:id="w56">ܬ݁ܶܥܒ݁ܕ݂ܽܘܢ</w> <w xml:id="w57">ܚܠܳܦ݂</w> <w xml:id="w58">ܗܰܝܡܳܢܽܘܬ݂ܳܐ</w> <w xml:id="w59">܇</w>
                    <w xml:id="w60">ܐܰܝܕ݂ܳܐ</w> <w xml:id="w61">ܕ݁ܰܚܕ݂ܳܐ</w> <w xml:id="w62">ܙܒ݂ܰܢ</w> <w xml:id="w63">ܐܶܫܬ݁ܰܠܡܰܬ݂</w> <w xml:id="w64">ܠܩܰܕ݁ܺܝܫܶܐ̈</w> <w xml:id="w65">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w66">ܩܢܰܘ</w> <w xml:id="w67">ܓ݁ܶܝܪ</w> <w xml:id="w68">ܐ̱ܢܳܫܺܝܢ̈</w> <w xml:id="w69">ܡܰܥܠܳܢܽܘܬ݂ܳܐ</w> <w xml:id="w70">܇</w> <w xml:id="w71">ܐܰܝܠܶܝܢ</w> <w xml:id="w72">ܕ݁ܡܶܢ</w> <w xml:id="w73">ܫܽܘܪܳܝܳܐ</w>
                    <w xml:id="w74">ܩܰܕ݁ܶܡܘ</w> <w xml:id="w75">ܐܶܬ݂ܟ݁ܬ݂ܶܒ݂ܘ</w> <w xml:id="w76">ܒ݁ܚܽܘܝܳܒ݂ܳܐ</w> <w xml:id="w77">ܗܳܢܳܐ</w> <w xml:id="w78">.</w> <w xml:id="w79">ܐ̱ܢܳܫܳܐ</w> <w xml:id="w80">ܪܰܫܺܝܥܶܐ̈</w> <w xml:id="w81">.</w> <w xml:id="w82">ܕ݁ܰܠܛܰܝܒ݁ܽܘܬ݂ܶܗ</w>
                    <w xml:id="w83">ܕ݁ܰܐܠܳܗܰܢ</w> <w xml:id="w84">ܡܰܗܦ݁ܟ݂ܺܝܢ</w> <w xml:id="w85">ܠܛܰܢܦ݁ܽܘܬ݂ܳܐ</w> <w xml:id="w86">.</w> <w xml:id="w87">ܘܰܒ݂ܗܰܘ</w> <w xml:id="w88">ܕ݁ܺܐܝܬ݂ܰܘܗ̱ܝ</w> <w xml:id="w89">ܒ݁ܰܠܚܽܘܕ݂ܰܘܗ̱ܝ</w> <w xml:id="w90">ܡܳܪܳܐ</w>
                    <w xml:id="w91">ܐܰܠܳܗܳܐ</w> <w xml:id="w92">ܘܡܳܪܰܢ</w> <w xml:id="w93">ܝܶܫܽܘܥ</w> <w xml:id="w94">ܡܫܺܝܚܳܐ</w> <w xml:id="w95">܂</w> <w xml:id="w96">ܟ݁ܳܦ݂ܪܺܝܢ</w> <w xml:id="w97">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
                  <p><w xml:id="w98">ܠܡܰܥ̱ܗܳܕ݂ܽܘܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w99">ܕ݁ܶܝܢ</w> <w xml:id="w100">ܨܳܒ݂ܶܐ</w> <w xml:id="w101">ܐ̱ܢܳܐ</w> <w xml:id="w102">܇</w> <w xml:id="w103">ܟ݁ܰܕ݂</w> <w xml:id="w104">ܝܳܕ݂ܥܺܝܢ</w>
                    <w xml:id="w105">ܐܢ̱ܬ݁ܽܘܢ</w> <w xml:id="w106">ܟ݁ܽܠܗܶܝܢ</w> <w xml:id="w107">܆</w> <w xml:id="w108">ܕ݁ܰܐܠܳܗܳܐ</w> <w xml:id="w109">ܟ݁ܰܕ݂</w> <w xml:id="w110">ܚܕ݂ܳܐ</w> <w xml:id="w111">ܙܒ݂ܰܢ</w> <w xml:id="w112">ܠܥܰܡܳܐ</w> <w xml:id="w113">ܡܶܢ</w> <w xml:id="w114">ܡܶܨܪܶܝܢ</w> <w xml:id="w115">ܦ݁ܪܰܩ</w> <w xml:id="w116">܆</w> <w xml:id="w117">ܗܳܝ</w>
                    <w xml:id="w118">ܕ݁ܬ݂ܰܪܬ݁ܶܝܢ̈</w> <w xml:id="w119">ܠܰܐܝܠܶܝܢ</w> <w xml:id="w120">ܕ݁ܠܳܐ</w> <w xml:id="w121">ܗܰܝܡܶܢܘ</w> <w xml:id="w122">ܐܰܘܒ݁ܶܕ݂</w> <w xml:id="w123">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w124">ܘܰܠܡܰܠܰܐܟ݂ܶܐ̈</w> <w xml:id="w125">ܐܰܝܠܶܝܢ</w> <w xml:id="w126">ܕ݁ܠܳܐ</w> <w xml:id="w127">ܢܛܰܪܘ</w> <w xml:id="w128">ܪܺܝܫܳܢܽܘܬ݂ܗܽܘܢ</w> <w xml:id="w129">܇</w> <w xml:id="w130">ܐܶܠܳܐ</w>
                    <w xml:id="w131">ܫܒ݂ܰܩܘ</w> <w xml:id="w132">ܥܽܘܡܪܳܐ</w> <w xml:id="w133">ܕ݁ܺܝܠܗܽܘܢ</w> <w xml:id="w134">܆</w> <w xml:id="w135">ܠܕ݂ܺܝܢܳܐ</w> <w xml:id="w136">ܕ݁ܝܰܘܡܳܐ</w> <w xml:id="w137">ܪܰܒ݁ܳܐ</w> <w xml:id="w138">܁</w> <w xml:id="w139">ܒ݁ܰܐܣܽܘܪܶܐ̈</w> <w xml:id="w140">ܠܳܐ</w> <w xml:id="w141">ܝܺܕ݂ܺܝܥܶܐ̈</w>
                    <w xml:id="w142">܁</w> <w xml:id="w143">ܬ݁ܚܶܝܬ݂</w> <w xml:id="w144">ܥܰܡܛܳܢܳܐ</w> <w xml:id="w145">܂</w> <w xml:id="w146">ܢܳܛܰܪ</w> <w xml:id="w147">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w148">ܐܰܝܟ݁ܰܢܳܐ</w> <w xml:id="w149">ܕ݁ܰܣܕ݂ܽܘܡ</w> <w xml:id="w150">ܘܥܳܡܽܘܪܳܐ</w> <w xml:id="w151">ܘܰܡܕ݂ܺܝܢܳܬ݂ܳܐ̈</w> <w xml:id="w152">ܕ݁ܰܚܕ݂ܳܪܰܝܗܶܝܢ̈</w>
                    <w xml:id="w153">܇</w> <w xml:id="w154">ܕ݁ܒ݂ܳܗ</w> <w xml:id="w155">ܒ݁ܰܕ݂ܡܽܘܬ݂ܳܐ</w> <w xml:id="w156">ܕ݁ܗܳܠܶܝܢ</w> <w xml:id="w157">ܙܰܢܺܝ̈</w> <w xml:id="w158">ܘܶܐܙܰܠ</w> <w xml:id="w159">ܒ݁ܳܬ݂ܰܪ</w> <w xml:id="w160">ܒ݁ܶܣܪܳܐ</w> <w xml:id="w161">ܐ̱ܚܪܺܢܳܐ</w> <w xml:id="w162">܆</w> <w xml:id="w163">ܣܺܝܡܳܢ̈</w>
                    <w xml:id="w164">ܬ݁ܚܶܝܬ݂</w> <w xml:id="w165">ܬ݁ܰܚܘܺܝܬ݂ܳܐ</w> <w xml:id="w166">ܕ݁ܢܽܘܪܳܐ</w> <w xml:id="w167">ܕ݁ܰܠܥܳܠܰܡ</w> <w xml:id="w168">܁</w> <w xml:id="w169">ܟ݁ܰܕ݂</w> <w xml:id="w170">ܡܚܰܝܒ݂ܳܢ̈</w> <w xml:id="w171">ܠܕ݂ܺܝܢܳܐ</w> <w xml:id="w172">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w173">ܒ݁ܳܗ</w> <w xml:id="w174">ܒ݁ܰܕ݂ܡܽܘܬ݂ܳܐ</w> <w xml:id="w175">ܐܳܦ݂</w> <w xml:id="w176">ܗܳܠܶܝܢ</w> <w xml:id="w177">ܕ݁ܰܒ݂ܚܶܠܡܶܐ̈</w> <w xml:id="w178">ܡܶܫܬ݁ܪܰܓ݂ܪܓ݂ܺܝܢ</w> <w xml:id="w179">܆</w>
                    <w xml:id="w180">ܠܒ݂ܶܣܪܳܐ</w> <w xml:id="w181">ܡܰܢ</w> <w xml:id="w182">ܡܛܰܢܦ݂ܺܝܢ</w> <w xml:id="w183">.</w> <w xml:id="w184">ܠܡܳܪܽܘܬ݂ܳܐ</w> <w xml:id="w185">ܕ݁ܶܝܢ</w> <w xml:id="w186">ܛܳܠܡܺܝܢ</w> <w xml:id="w187">.</w> <w xml:id="w188">ܘܰܠܬ݂ܶܫܒ݁ܽܘܚܬ݁ܳܐ</w> <w xml:id="w189">ܡܓ݂ܰܕ݁ܦ݂ܺܝܢ</w>
                    <w xml:id="w190">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w191">ܡܺܝܟ݂ܳܐܝܶܠ</w> <w xml:id="w192">ܕ݁ܶܝܢ</w> <w xml:id="w193">ܪܺܝܫ</w> <w xml:id="w194">ܡܰܠܰܐܟ݂ܶܐ̈</w> <w xml:id="w195">܇</w> <w xml:id="w196">ܗܰܘ</w> <w xml:id="w197">ܕ݁ܥܰܡ</w> <w xml:id="w198">ܐܳܟ݂ܶܠܩܰܪܨܳܐ</w>
                    <w xml:id="w199">ܟ݁ܰܕ݂</w> <w xml:id="w200">ܕ݁ܳܐܶܢ</w> <w xml:id="w201">܁</w> <w xml:id="w202">ܡܡܰܠܶܠ</w> <w xml:id="w203">ܗ̱ܘܳܐ</w> <w xml:id="w204">ܡܶܛܽܠ</w> <w xml:id="w205">ܦ݁ܰܓ݂ܪܶܗ</w> <w xml:id="w206">ܕ݁ܡܽܘܫܶܐ</w> <w xml:id="w207">܆</w> <w xml:id="w208">ܠܳܐ</w> <w xml:id="w209">ܐܰܡܪܰܚ</w> <w xml:id="w210">ܕ݁ܢܰܝܬ݁ܶܐ</w>
                    <w xml:id="w211">ܥܠܰܘܗ̱ܝ</w> <w xml:id="w212">ܕ݁ܺܝܢܳܐ</w> <w xml:id="w213">ܕ݁ܓ݂ܽܘܕ݁ܳܦ݂ܳܐ</w> <w xml:id="w214">.</w> <w xml:id="w215">ܐܶܠܳܐ</w> <w xml:id="w216">ܐܶܡܰܪ</w> <w xml:id="w217">܆</w> <w xml:id="w218">ܕ݁ܢܶܓ݂ܥܽܘܪ</w> <w xml:id="w219">ܒ݁ܳܟ݂</w> <w xml:id="w220">ܡܳܪܝܳܐ</w> <w xml:id="w221">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w222">ܗܳܠܶܝܢ</w> <w xml:id="w223">ܕ݁ܶܝܢ</w> <w xml:id="w224">܁</w> <w xml:id="w225">ܒ݁ܰܐܝܠܶܝܢ</w> <w xml:id="w226">ܕ݁ܠܳܐ</w> <w xml:id="w227">ܝܳܕ݂ܥܺܝܢ</w> <w xml:id="w228">܂</w> <w xml:id="w229">ܡܓ݂ܰܕ݁ܦ݂ܺܝܢ</w> <w xml:id="w230">.</w>
                    <w xml:id="w231">ܒ݁ܰܐܝܠܶܝܢ</w> <w xml:id="w232">ܕ݁ܶܝܢ</w> <w xml:id="w233">ܕ݁ܰܟ݂ܝܳܢܳܐܝܺܬ݂</w> <w xml:id="w234">ܐܰܝܟ݂</w> <w xml:id="w235">ܚܰܝܘܳܬ݂ܳܐ̈</w> <w xml:id="w236">ܚܰܪܫܳܬ݂ܳܐ̈</w> <w xml:id="w237">ܡܦ݁ܳܣܺܝܢ</w> <w xml:id="w238">܆</w> <w xml:id="w239">ܒ݁ܗܶܝܢ</w>
                    <w xml:id="w240">ܡܶܬ݂ܚܰܒ݁ܠܺܝܢ</w> <w xml:id="w241">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w242">ܘܳܝ</w> <w xml:id="w243">ܠܗܽܘܢ</w> <w xml:id="w244">ܕ݁ܒ݂ܽܐܘܪܚܶܗ</w> <w xml:id="w245">ܕ݁ܩܳܐܝܶܢ</w> <w xml:id="w246">ܐܶܙܰܠܘ</w> <w xml:id="w247">.</w> <w xml:id="w248">ܘܒ݂ܳܬ݂ܰܪ</w> <w xml:id="w249">ܛܳܥܝܽܘܬ݂ܶܗ</w>
                    <w xml:id="w250">ܕ݁ܒ݂ܶܠܥܰܡ</w> <w xml:id="w251">ܒ݁ܰܐܓ݂ܪܳܐ</w> <w xml:id="w252">ܐܶܫܬ݁ܰܪܰܚܘ</w> <w xml:id="w253">.</w> <w xml:id="w254">ܘܰܒ݂ܥܶܨܝܳܝܽܘܬ݂ܶܗ</w> <w xml:id="w255">ܕ݁ܩܽܘܪܳܚ</w> <w xml:id="w256">ܐܶܒ݂ܰܕ݂ܘ</w> <w xml:id="w257">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w258">ܗܳܠܶܝܢ</w> <w xml:id="w259">ܐܺܝܬ݂ܰܝܗܽܘܢ</w> <w xml:id="w260">ܐܰܝܠܶܝܢ</w> <w xml:id="w261">ܕ݁ܒ݂ܰܢܝܳܚܳܬ݂ܗܽܘܢ̈</w> <w xml:id="w262">ܟ݁ܰܕ݂</w>
                    <w xml:id="w263">ܡܟ݂ܰܬ݁ܡܺܝܢ</w> <w xml:id="w264">܁</w> <w xml:id="w265">ܡܶܬ݂ܦ݁ܰܪܦ݁ܥܺܝܢ</w> <w xml:id="w266">.</w> <w xml:id="w267">ܟ݁ܰܕ݂</w> <w xml:id="w268">ܕ݁ܠܳܐ</w> <w xml:id="w269">ܕ݁ܶܚܠܬ݂ܳܐ</w> <w xml:id="w270">ܢܰܦ݂ܫܗܽܘܢ</w> <w xml:id="w271">ܪܳܥܶܝܢ</w> <w xml:id="w272">.</w> <w xml:id="w273">ܥܢܳܢܶܐ̈</w>
                    <w xml:id="w274">ܕ݁ܠܳܐ</w> <w xml:id="w275">ܡܶܛܪܳܐ</w> <w xml:id="w276">ܕ݁ܡܶܢ</w> <w xml:id="w277">ܪܽܘܚܶܐ̈</w> <w xml:id="w278">ܦ݁ܳܗܝܳܢ̈</w> <w xml:id="w279">.</w> <w xml:id="w280">ܐܺܝܠܳܢܶܐ̈</w> <w xml:id="w281">ܕ݁ܰܐܘܦ݁ܺܝ</w> <w xml:id="w282">ܐܶܒ݁ܗܽܘܢ</w> <w xml:id="w283">.</w>
                    <w xml:id="w284">ܕ݁ܺܐܝܬ݂ܰܝܗܽܘܢ</w> <w xml:id="w285">ܕ݁ܠܳܐ</w> <w xml:id="w286">ܦ݁ܺܐܪܶܐ̈</w> <w xml:id="w287">.</w> <w xml:id="w288">ܕ݁ܡܺܝܬ݂ܘ</w> <w xml:id="w289">ܬ݁ܶܢܝܳܢܽܘܬ݂</w> <w xml:id="w290">.</w> <w xml:id="w291">ܘܰܣܠܶܩܘ</w> <w xml:id="w292">ܡܶܢ</w> <w xml:id="w293">ܥܶܩܳܪܰܝܗܽܘܢ̈</w>
                    <w xml:id="w294">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w295">ܓ݁ܰܠ̱ܠܶܐ̈</w> <w xml:id="w296">ܥܰܙܺܝܙܶܐ̈</w> <w xml:id="w297">ܕ݁ܝܰܡܳܐ</w> <w xml:id="w298">܇</w> <w xml:id="w299">ܕ݁ܰܒ݂ܝܰܕ݂</w> <w xml:id="w300">ܪܽܘܥܬ݁ܗܽܘܢ</w> <w xml:id="w301">ܡܚܰܘܶܝܢ</w>
                    <w xml:id="w302">ܒ݁ܶܗܬ݁ܰܬ݂ܗܽܘܢ</w> <w xml:id="w303">.</w> <w xml:id="w304">ܟ݁ܰܘܟ݁ܒ݂ܶܐ̈</w> <w xml:id="w305">ܡܰܛܥܝܳܢܶܐ̈</w> <w xml:id="w306">.</w> <w xml:id="w307">ܠܗܳܠܶܝܢ</w> <w xml:id="w308">ܕ݁ܥܰܡܛܳܢܳܐ</w> <w xml:id="w309">ܕ݁ܚܶܫܽܘܟ݂ܳܐ</w> <w xml:id="w310">ܠܥܳܠܰܡ</w>
                    <w xml:id="w311">ܠܗܽܘܢ</w> <w xml:id="w312">ܢܛܺܝܪ</w> <w xml:id="w313">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w314">ܐܶܬ݂ܢܰܒ݁ܺܝ</w> <w xml:id="w315">ܕ݁ܶܝܢ</w> <w xml:id="w316">ܐܳܦ݂</w> <w xml:id="w317">ܠܗܳܠܶܝܢ</w> <w xml:id="w318">܆</w> <w xml:id="w319">ܗܰܘ</w> <w xml:id="w320">ܕ݁ܺܐܝܬ݂ܰܘܗ̱ܝ</w> <w xml:id="w321">ܕ݁ܫܰܒ݂ܥܳܐ</w>
                    <w xml:id="w322">ܡܶܢ</w> <w xml:id="w323">ܐܳܕ݂ܳܡ</w> <w xml:id="w324">܁</w> <w xml:id="w325">ܚܢܽܘܟ݂</w> <w xml:id="w326">ܟ݁ܰܕ݂</w> <w xml:id="w327">ܐܳܡܰܪ</w> <w xml:id="w328">܆</w> <w xml:id="w329">ܕ݁ܗܳܐ</w> <w xml:id="w330">ܡܳܪܝܳܐ</w> <w xml:id="w331">ܐܳܬ݂ܶܐ</w> <w xml:id="w332">ܒ݁ܪܶܒ݁ܘܳܬ݂ܳܐ̈</w> <w xml:id="w333">ܕ݁ܩܰܕ݁ܺܝܫܶܐ̈</w>
                    <w xml:id="w334">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w335">ܕ݁ܢܶܥܒ݁ܶܕ݂</w> <w xml:id="w336">ܕ݁ܺܝܢܳܐ</w> <w xml:id="w337">ܥܰܠ</w> <w xml:id="w338">ܟ݁ܽܠ</w> <w xml:id="w339">܆</w> <w xml:id="w340">ܘܰܠܡܰܟ݁ܳܣܽܘ</w> <w xml:id="w341">ܠܟ݂ܽܠ</w> <w xml:id="w342">ܢܰܦ݂ܫܳܬ݂ܳܐ̈</w>
                    <w xml:id="w343">܇</w> <w xml:id="w344">ܡܶܛܽܠ</w> <w xml:id="w345">ܟ݁ܽܠܗܽܘܢ</w> <w xml:id="w346">ܥܒ݂ܳܕ݂ܶܐ̈</w> <w xml:id="w347">ܐܰܝܠܶܝܢ</w> <w xml:id="w348">ܕ݁ܰܐܪܫܥܘ</w> <w xml:id="w349">܇</w> <w xml:id="w350">ܘܡܶܛܽܠ</w> <w xml:id="w351">ܟ݁ܽܠܗܶܝܢ</w> <w xml:id="w352">ܡܶܠܶܐ̈</w> <w xml:id="w353">ܩܰܫܝܳܬ݂ܳܐ̈</w>
                    <w xml:id="w354">܁</w> <w xml:id="w355">ܐܰܝܠܶܝܢ</w> <w xml:id="w356">ܕ݁ܡܰܠܶܠܘ</w> <w xml:id="w357">܂</w> <w xml:id="w358">ܚܰܛܳܝܶܐ̈</w> <w xml:id="w359">ܪܰܫܺܝܥܶܐ̈</w> <w xml:id="w360">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w361">ܗܳܠܶܝܢ</w> <w xml:id="w362">ܐܶܢܽܘܢ</w> <w xml:id="w363">ܕ݁ܡܰܪܛܢܺܝܢ</w> <w xml:id="w364">ܘܥܳܕ݂ܠܺܝܢ</w> <w xml:id="w365">ܒ݁ܟ݂ܽܠ</w> <w xml:id="w366">ܨܶܒ݂ܘܳܢ̈</w> <w xml:id="w367">܇</w> <w xml:id="w368">ܟ݁ܰܕ݂</w>
                    <w xml:id="w369">ܐܰܝܟ݂</w> <w xml:id="w370">ܪܓ݂ܺܝܓ݂ܳܬ݂ܳܐ̈</w> <w xml:id="w371">ܕ݁ܺܝܠܗܽܘܢ</w> <w xml:id="w372">ܡܗܰܠܟ݂ܺܝܢ</w> <w xml:id="w373">.</w> <w xml:id="w374">ܘܦ݂ܽܘܡܗܽܘܢ</w> <w xml:id="w375">ܡܡܰܠܶܠ</w> <w xml:id="w376">ܓ݁ܢܺܝܚܳܬ݂ܳܐ̈</w> <w xml:id="w377">܆</w>
                    <w xml:id="w378">ܘܰܡܫܰܒ݁ܚܺܝܢ</w> <w xml:id="w379">ܠܦ݂ܰܪܨܽܘܦ݁ܶܐ̈</w> <w xml:id="w380">ܡܶܛܽܠ</w> <w xml:id="w381">ܝܽܘܬ݂ܪܳܢܶܐ̈</w> <w xml:id="w382">܀</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w383">ܐܰܢ̱ܬ݁ܽܘܢ</w> <w xml:id="w384">ܕ݁ܶܝܢ</w> <w xml:id="w385">ܚܰܒ݁ܺܝܒ݂ܰܝ̈</w> <w xml:id="w386">܆</w> <w xml:id="w387">ܐܶܬ݁ܕ݁ܰܟ݂̱ܪܘ</w> <w xml:id="w388">ܠܡܶܠܶܐ̈</w> <w xml:id="w389">ܐܰܝܠܶܝܢ</w>
                    <w xml:id="w390">ܕ݁ܩܰܕ݁ܶܡ</w> <w xml:id="w391">ܐܶܬ݂ܶܐܡܰܪ</w> <w xml:id="w392">ܡܶܢ</w> <w xml:id="w393">ܫܠܺܝܚܰܘܗ̱ܝ̈</w> <w xml:id="w394">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w395">ܝܶܫܽܘܥ</w> <w xml:id="w396">ܡܫܺܝܚܳܐ</w> <w xml:id="w397">܇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="18">
                  <p><w xml:id="w398">ܕ݁ܳܐܡܪܺܝܢ</w> <w xml:id="w399">ܗ̱ܘܰܘ</w> <w xml:id="w400">ܠܟ݂ܽܘܢ</w> <w xml:id="w401">܆</w> <w xml:id="w402">ܕ݁ܰܒ݂ܚܰܪܬ݂ܳܐ</w> <w xml:id="w403">ܕ݁ܙܰܒ݂ܢܶܐ̈</w> <w xml:id="w404">ܢܶܗܘܽܘܢ</w>
                    <w xml:id="w405">ܐܰܝܠܶܝܢ</w> <w xml:id="w406">ܕ݁ܰܡܒ݂ܰܙܚܺܝܢ</w> <w xml:id="w407">܇</w> <w xml:id="w408">ܕ݁ܰܐܝܟ݂</w> <w xml:id="w409">ܪܓ݂ܺܝܓ݂ܳܬ݂ܳܐ̈</w> <w xml:id="w410">ܕ݁ܺܝܠܗܽܘܢ</w> <w xml:id="w411">ܐܳܙܺܠ̱ܝܢ</w> <w xml:id="w412">ܒ݁ܳܬ݂ܰܪ</w> <w xml:id="w413">ܪܽܘܫܥܳܐ</w>
                    <w xml:id="w414">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w415">ܗܳܠܶܝܢ</w> <w xml:id="w416">ܐܺܝܬ݂ܰܝܗܽܘܢ</w> <w xml:id="w417">ܐܰܝܠܶܝܢ</w> <w xml:id="w418">ܕ݁ܰܡܦ݂ܰܪܫܺܝܢ</w> <w xml:id="w419">.</w> <w xml:id="w420">ܢܰܦ݂ܫܳܢܳܝܶܐ̈</w> <w xml:id="w421">.</w>
                    <w xml:id="w422">ܕ݁ܪܽܘܚܳܐ</w> <w xml:id="w423">ܠܰܝܬ݁</w> <w xml:id="w424">ܠܗܽܘܢ</w> <w xml:id="w425">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="20">
                  <p><w xml:id="w426">ܐܰܢ̱ܬ݁ܽܘܢ</w> <w xml:id="w427">ܕ݁ܶܝܢ</w> <w xml:id="w428">ܚܰܒ݁ܺܝܒ݂ܰܝ̈</w> <w xml:id="w429">܆</w> <w xml:id="w430">ܒ݁ܗܰܝܡܳܢܽܘܬ݂ܳܐ</w> <w xml:id="w431">ܕ݁ܺܝܠܟ݂ܽܘܢ</w>
                    <w xml:id="w432">ܩܰܕ݁ܺܝܫܬ݁ܳܐ</w> <w xml:id="w433">܁</w> <w xml:id="w434">ܐܶܬ݂ܒ݁ܰܢܰܘ</w> <w xml:id="w435">ܡܶܢ</w> <w xml:id="w436">ܕ݁ܪܺܝܫ</w> <w xml:id="w437">ܒ݁ܪܽܘܚܳܐ</w> <w xml:id="w438">ܩܰܕ݁ܺܝܫܳܐ</w> <w xml:id="w439">܂</w> <w xml:id="w440">ܟ݁ܰܕ݂</w> <w xml:id="w441">ܡܨܰܠܶܝܢ</w> <w xml:id="w442">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="21">
                  <p><w xml:id="w443">ܢܰܦ݂ܫܰܢ</w> <w xml:id="w444">ܕ݁ܶܝܢ</w> <w xml:id="w445">ܒ݁ܚܽܘܒ݁ܳܐ</w> <w xml:id="w446">ܕ݁ܰܐܠܳܗܳܐ</w> <w xml:id="w447">ܢܶܛܰܪ</w> <w xml:id="w448">܁</w> <w xml:id="w449">ܟ݁ܰܕ݂</w> <w xml:id="w450">ܡܣܰܟ݁ܶܝܢܰܢ</w>
                    <w xml:id="w451">ܠܰܚܢܳܢܶܗ</w> <w xml:id="w452">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w453">ܝܶܫܽܘܥ</w> <w xml:id="w454">ܡܫܺܝܚܳܐ</w> <w xml:id="w455">܇</w> <w xml:id="w456">ܠܚܰܝܶܐ̈</w> <w xml:id="w457">ܕ݁ܺܝܠܰܢ</w> <w xml:id="w458">ܕ݁ܰܠܥܳܠܰܡ</w> <w xml:id="w459">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="22">
                  <p><w xml:id="w460">ܘܰܠܡܶܢܗܽܘܢ</w> <w xml:id="w461">ܡܰܢ</w> <w xml:id="w462">ܡܶܢ</w> <w xml:id="w463">ܢܽܘܪܳܐ</w> <w xml:id="w464">ܚܛܽܘܦ݂ܘ</w> <w xml:id="w465">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="23">
                  <p><w xml:id="w466">ܟ݁ܰܕ݂</w> <w xml:id="w467">ܕ݁ܶܝܢ</w> <w xml:id="w468">ܡܶܬ݁ܬ݁ܘܶܝܢ</w> <w xml:id="w469">܁</w> <w xml:id="w470">ܐܶܬ݂ܪܰܚܰܡܘ</w> <w xml:id="w471">ܥܠܰܝܗܽܘܢ</w> <w xml:id="w472">ܒ݁ܕ݂ܶܚܠܬ݂ܳܐ</w> <w xml:id="w473">܇</w>
                    <w xml:id="w474">ܟ݁ܰܕ݂</w> <w xml:id="w475">ܣܳܢܶܝܢ</w> <w xml:id="w476">ܐܢ̱ܬ݁ܽܘܢ</w> <w xml:id="w477">ܐܳܦ݂</w> <w xml:id="w478">ܠܟ݂ܽܘܬ݁ܺܝܢܳܐ</w> <w xml:id="w479">ܕ݁ܡܶܢ</w> <w xml:id="w480">ܒ݁ܶܣܪܳܐ</w> <w xml:id="w481">ܕ݁ܰܡܟ݂ܰܬ݁ܡܳܐ</w> <w xml:id="w482">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="24">
                  <p><w xml:id="w483">ܠܗܰܘ</w> <w xml:id="w484">ܕ݁ܶܝܢ</w> <w xml:id="w485">ܕ݁ܡܶܫܟ݁ܰܚ</w> <w xml:id="w486">ܕ݁ܰܢܢܰܛܰܪ</w> <w xml:id="w487">ܠܰܢ</w> <w xml:id="w488">ܕ݁ܠܳܐ</w> <w xml:id="w489">ܫܽܘܪܰܥܬ݂ܳܐ</w> <w xml:id="w490">ܘܰܕ݂ܠܳܐ</w>
                    <w xml:id="w491">ܟ݁ܽܘܬ݂ܡܳܐ</w> <w xml:id="w492">܇</w> <w xml:id="w493">ܘܰܢܩܺܝܡ</w> <w xml:id="w494">ܕ݁ܠܳܐ</w> <w xml:id="w495">ܡܽܘܡܳܐ</w> <w xml:id="w496">:</w></p>
               </div>
               <div type="textpart" subtype="verse" n="25">
                  <p><w xml:id="w497">ܒ݁ܰܠܚܽܘܕ݂ܰܘܗ̱ܝ</w> <w xml:id="w498">ܐܰܠܳܗܳܐ</w> <w xml:id="w499">ܦ݁ܳܪܽܘܩܰܢ</w> <w xml:id="w500">܁</w> <w xml:id="w501">ܒ݁ܝܰܕ݂</w> <w xml:id="w502">ܝܶܫܽܘܥ</w> <w xml:id="w503">ܡܫܺܝܚܳܐ</w>
                    <w xml:id="w504">ܡܳܪܰܢ</w> <w xml:id="w505">܇</w> <w xml:id="w506">ܩܕ݂ܳܡ</w> <w xml:id="w507">ܬ݁ܶܫܒ݁ܽܘܚܬ݁ܶܗ</w> <w xml:id="w508">ܒ݁ܚܰܕ݂ܽܘܬ݂ܳܐ</w> <w xml:id="w509">܆</w> <w xml:id="w510">ܠܶܗ</w> <w xml:id="w511">ܫܽܘܒ݂ܚܳܐ</w> <w xml:id="w512">ܘܽܐܘܚܕ݁ܳܢܳܐ</w> <w xml:id="w513">ܘܺܐܝܩܳܪܳܐ</w>
                    <w xml:id="w514">ܘܪܰܒ݁ܽܘܬ݂ܳܐ</w> <w xml:id="w515">܁</w> <w xml:id="w516">ܐܳܦ݂</w> <w xml:id="w517">ܗܳܫܳܐ</w> <w xml:id="w518">ܘܰܒ݂ܟ݂ܽܠܗܽܘܢ</w> <w xml:id="w519">ܥܳܠܡܶܐ̈</w> <w xml:id="w520">܂</w> <w xml:id="w521">ܐܰܡܺܝܢ</w> <w xml:id="w522">܀</w> </p>
               </div>
            </div>
         </div>
      </body>
   </text>
