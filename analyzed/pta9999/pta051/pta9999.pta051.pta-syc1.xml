               </div>
               <div type="textpart" subtype="verse" n="22">
                  <p><w xml:id="w851">ܐܬܕܟܪܘ</w> <w xml:id="w852">ܢܡܘܣܗ</w> <w xml:id="w853">ܕܡܘܫܐ</w> <w xml:id="w854">ܥܒܕܝ</w> <w xml:id="w855">ܕܦܩܕܬܗ</w> <w xml:id="w856">ܒܚܘܪܝܒ</w> <w xml:id="w857">ܥܠ</w> <w xml:id="w858">ܟܠܗ</w> <w xml:id="w859">ܐܝܣܪܝܠ</w> <w xml:id="w860">ܦܘܩ̈ܕܢܐ</w> <w xml:id="w861">ܘܕܝ̈ܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="23">
                  <p><w xml:id="w862">ܗܐ</w> <w xml:id="w863">ܡܫܕܪ</w> <w xml:id="w864">ܐܢܐ</w> <w xml:id="w865">ܠܟܘܢ</w> <w xml:id="w866">ܠܐܠܝܐ</w> <w xml:id="w867">ܢܒܝܐ</w> <w xml:id="w868">ܩܕܡ</w> <w xml:id="w869">ܕܢܐܬܐ</w> <w xml:id="w870">ܝܘܡܗ</w> <w xml:id="w871">ܕܡܪܝܐ</w> <w xml:id="w872">ܪܒܐ</w> <w xml:id="w873">ܘܕܚܝܠܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="24">
                  <p><w xml:id="w874">ܕܢܦܢܐ</w> <w xml:id="w875">ܠܒܐ</w> <w xml:id="w876">ܕܐ̈ܒܗܐ</w> <w xml:id="w877">ܥܠ</w> <w xml:id="w878">ܒ̈ܢܝܐ</w> <w xml:id="w879">ܘܠܒܐ</w> <w xml:id="w880">ܕܒ̈ܢܝܐ</w> <w xml:id="w881">ܥܠ</w> <w xml:id="w882">ܐ̈ܒܗܝܗܘܢ</w> <w xml:id="w883">ܥܕܠܐ</w> <w xml:id="w884">ܐܬܐ</w> <w xml:id="w885">ܘܐܡܚܝܗ̇ܠܐܪܥܐ</w> <w xml:id="w886">ܠܐܒܕܢ</w></p>
               </div>
            </div>
         </div>
      </body>
