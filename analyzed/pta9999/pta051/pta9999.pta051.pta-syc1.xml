               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w652">ܕܠܡܐ</w> <w xml:id="w653">ܛܠܡ</w> <w xml:id="w654">ܒܪܢܫܐ</w> <w xml:id="w655">ܠܐܠܗܐ</w> <w xml:id="w656">ܐܝܟ</w> <w xml:id="w657">ܕܐܢܬܘܢ</w> <w xml:id="w658">ܛܠܡܝܢ</w> <w xml:id="w659">ܐܢܬܘܢ</w> <w xml:id="w660">ܠܝ</w> <w xml:id="w661">ܘܐܢ</w> <w xml:id="w662">ܐܡܪܝܢ</w> <w xml:id="w663">ܐܢܬܘܢ</w> <w xml:id="w664">ܒܡܢܐܛܠܡܢܟ</w> <w xml:id="w665">ܒܡܥܣܪ̈ܐ</w> <w xml:id="w666">ܘܒܪ̈ܫܝܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w667">ܒ̈ܠܘܛܬܐ</w> <w xml:id="w668">ܡܬܠܝܛܝܢ</w> <w xml:id="w669">ܐܢܬܘܢ</w> <w xml:id="w670">ܘܠܝ</w> <w xml:id="w671">ܛܠܡܝܢ</w> <w xml:id="w672">ܐܢܬܘܢ</w> <w xml:id="w673">ܟܠܗ</w> <w xml:id="w674">ܥܡܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
