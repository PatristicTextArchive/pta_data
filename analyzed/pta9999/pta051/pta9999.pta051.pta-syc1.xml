               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w721">ܥܫܢ</w> <w xml:id="w722">ܥܠܝ</w> <w xml:id="w723">ܡ̈ܠܝܟܘܢ</w> <w xml:id="w724">ܐܡܪ</w> <w xml:id="w725">ܡܪܝܐ</w> <w xml:id="w726">ܘܐܢ</w> <w xml:id="w727">ܐܡܪܝܢ</w> <w xml:id="w728">ܐܢܬܘܢ</w> <w xml:id="w729">ܡܢܐ</w> <w xml:id="w730">ܐܡܪܢ</w> <w xml:id="w731">ܥܠܝܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w732">ܐܡܪܬܘܢ</w> <w xml:id="w733">ܕܣܪܝܩܐܝܬ</w> <w xml:id="w734">ܦܠܚܢܝܗܝ</w> <w xml:id="w735">ܠܡܪܝܐ</w> <w xml:id="w736">ܘܡܢܐ</w> <w xml:id="w737">ܐܘܬܪܢ</w> <w xml:id="w738">ܕܢܛܪܢ</w> <w xml:id="w739">ܢܛܘܪ̈ܬܗ</w> <w xml:id="w740">ܘܕܗܠܟܢ</w> <w xml:id="w741">ܡܟܝܟܐܝܬܩܕܡ</w> <w xml:id="w742">ܡܪܝܐ</w> <w xml:id="w743">ܚܝܠܬܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
