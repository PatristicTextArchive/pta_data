                  <p><w xml:id="w519">ܗܐ</w> <w xml:id="w520">ܐܢܐ</w> <w xml:id="w521">ܡܫܕܪ</w> <w xml:id="w522">ܐܢܐ</w> <w xml:id="w523">ܡܠܐܟܝ</w> <w xml:id="w524">ܘܢܫܦܐ</w> <w xml:id="w525">ܐܘܪܚܐ</w> <w xml:id="w526">ܩܕܡܝ</w> <w xml:id="w527">ܘܡܢ</w> <w xml:id="w528">ܫܠܝܐ</w> <w xml:id="w529">ܢܐܬܐ</w> <w xml:id="w530">ܠܗܝܟܠܗ</w> <w xml:id="w531">ܕܡܪܝܐܕܡܣܟܝܢ</w> <w xml:id="w532">ܐܢܬܘܢ</w> <w xml:id="w533">ܠܗ</w> <w xml:id="w534">ܘܡܠܐܟܐ</w> <w xml:id="w535">ܕܩܝܡܐ</w> <w xml:id="w536">ܕܨܒܝܢ</w> <w xml:id="w537">ܐܢܬܘܢ</w> <w xml:id="w538">ܒܗ</w> <w xml:id="w539">ܗܐ</w> <w xml:id="w540">ܐܬܐ</w> <w xml:id="w541">ܐܡܪ</w> <w xml:id="w542">ܡܪܝܐ</w> <w xml:id="w543">ܚܝܠܬܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="2">
                  <p><w xml:id="w544">ܡܢܘ</w> <w xml:id="w545">ܡܣܝܒܪ</w> <w xml:id="w546">ܝܘܡܐ</w> <w xml:id="w547">ܕܐܬܐ</w> <w xml:id="w548">ܒܗ</w> <w xml:id="w549">ܐܘ</w> <w xml:id="w550">ܡܢܘ</w> <w xml:id="w551">ܡܫܟܚ</w> <w xml:id="w552">ܠܡܩܡ</w> <w xml:id="w553">ܐܡܬܝ</w> <w xml:id="w554">ܕܡܬܓܠܐ</w> <w xml:id="w555">ܡܛܠ</w> <w xml:id="w556">ܕܐܝܟ</w> <w xml:id="w557">ܢܘܪܐ</w> <w xml:id="w558">ܗܘܕܨܪܦܐ</w> <w xml:id="w559">ܘܐܝܟ</w> <w xml:id="w560">ܟܒܪܝܬܐ</w> <w xml:id="w561">ܕܡܚܘܪܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="3">
                  <p><w xml:id="w562">ܕܢܗܦܘܟ</w> <w xml:id="w563">ܠܡܨܪܦ</w> <w xml:id="w564">ܘܠܡܕܟܝܘ</w> <w xml:id="w565">ܐܝܟ</w> <w xml:id="w566">ܣܐܡܐ</w> <w xml:id="w567">ܘܢܕܟܐ</w> <w xml:id="w568">ܠܒܢ̈ܘܗܝ</w> <w xml:id="w569">ܕܠܘܝ</w> <w xml:id="w570">ܘܢܓܒܐ</w> <w xml:id="w571">ܐܢܘܢ</w> <w xml:id="w572">ܐܝܟ</w> <w xml:id="w573">ܕܗܒܐܘܐܝܟ</w> <w xml:id="w574">ܣܐܡܐ</w> <w xml:id="w575">ܘܢܗܘܘܢ</w> <w xml:id="w576">ܡܩܪܒܝܢ</w> <w xml:id="w577">ܩܘܪܒܢܐ</w> <w xml:id="w578">ܠܡܪܝܐ</w> <w xml:id="w579">ܒܙܕܝܩܘܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w580">ܘܢܒܣܡ</w> <w xml:id="w581">ܠܡܪܝܐ</w> <w xml:id="w582">ܩܘܪܒܢܐ</w> <w xml:id="w583">ܕܝܗܘܕܐ</w> <w xml:id="w584">ܘܕܐܘܪܫܠܡ</w> <w xml:id="w585">ܐܝܟ</w> <w xml:id="w586">ܝܘܡ̈ܬܐ</w> <w xml:id="w587">ܕܡܢ</w> <w xml:id="w588">ܥܠܡ</w> <w xml:id="w589">ܘܐܝܟ</w> <w xml:id="w590">ܫ̈ܢܝܐ</w> <w xml:id="w591">ܕܡܢܩܕܝܡ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
                  <p><w xml:id="w592">ܘܐܩܪܘܒ</w> <w xml:id="w593">ܥܠܝܟܘܢ</w> <w xml:id="w594">ܒܕܝܢܐ</w> <w xml:id="w595">ܘܐܗܘܐ</w> <w xml:id="w596">ܣܗܕܐ</w> <w xml:id="w597">ܡܣܪܗܒܐ</w> <w xml:id="w598">ܒܚܪ̈ܫܐ</w> <w xml:id="w599">ܘܒܓܝܪ̈ܐ</w> <w xml:id="w600">ܘܒܐܝܠܝܢ</w> <w xml:id="w601">ܕܝܡܝܢܒܕܓܠܘܬܐ</w> <w xml:id="w602">ܘܒܐܝܠܝܢ</w> <w xml:id="w603">ܕܛܠܡܝܢ</w> <w xml:id="w604">ܐܓܪܐ</w> <w xml:id="w605">ܕܐܓܝܪܐ</w> <w xml:id="w606">ܘܕܥܡܘܪܐ</w> <w xml:id="w607">ܘܕܝܬܡܐ</w> <w xml:id="w608">ܘܕܐܪܡܠܬܐ</w> <w xml:id="w609">ܘܨܠܝܢ</w> <w xml:id="w610">ܥܠ</w> <w xml:id="w611">ܐܝܢܐܕܡܬܦܢܐ</w> <w xml:id="w612">ܠܘܬܝ</w> <w xml:id="w613">ܘܠܐ</w> <w xml:id="w614">ܕܚܠܘ</w> <w xml:id="w615">ܡܢܝ</w> <w xml:id="w616">ܐܡܪ</w> <w xml:id="w617">ܡܪܝܐ</w> <w xml:id="w618">ܚܝܠܬܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w619">ܡܛܠ</w> <w xml:id="w620">ܕܐܢܐ</w> <w xml:id="w621">ܐܢܐ</w> <w xml:id="w622">ܡܪܝܐ</w> <w xml:id="w623">ܘܠܐ</w> <w xml:id="w624">ܐܬܚܠܦܬ</w> <w xml:id="w625">ܘܐܢܬܘܢ</w> <w xml:id="w626">ܒܢ̈ܝ</w> <w xml:id="w627">ܝܥܩܘܒ</w> <w xml:id="w628">ܠܐ</w> <w xml:id="w629">ܥܒܪܬܘܢ</w> <w xml:id="w630">ܡܢ</w> <w xml:id="w631">ܥܘܠܟܘܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
