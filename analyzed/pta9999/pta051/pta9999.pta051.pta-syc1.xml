               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w800">ܡܛܠ</w> <w xml:id="w801">ܕܗܐ</w> <w xml:id="w802">ܝܘܡ̈ܬܐ</w> <w xml:id="w803">ܐܬܝܢ</w> <w xml:id="w804">ܘܢܐܩܕ</w> <w xml:id="w805">ܐܝܟ</w> <w xml:id="w806">ܬܢܘܪܐ</w> <w xml:id="w807">ܪܘܓܙܝ</w> <w xml:id="w808">ܘܢܗܘܘܢ</w> <w xml:id="w809">ܟܠܗܘܢ</w> <w xml:id="w810">ܥܘ̈ܠܐ</w> <w xml:id="w811">ܘܟܠܗܘܢܥܒ̈ܕܝ</w> <w xml:id="w812">ܚܛܝܬܐ</w> <w xml:id="w813">ܚܒܬܐ</w> <w xml:id="w814">ܘܢܘܩܕ</w> <w xml:id="w815">ܐܢܘܢ</w> <w xml:id="w816">ܝܘܡܐ</w> <w xml:id="w817">ܕܐܬܐ</w> <w xml:id="w818">ܐܡܪ</w> <w xml:id="w819">ܡܪܝܐ</w> <w xml:id="w820">ܚܝܠܬܢܐ</w> <w xml:id="w821">ܘܠܐ</w> <w xml:id="w822">ܢܫܒܘܩ</w> <w xml:id="w823">ܠܗܘܢܥܩܪܐ</w> <w xml:id="w824">ܘܥܘܦܐ</w></p>
               </div>
