               <div type="textpart" subtype="verse" n="28">
                  <p><w xml:id="w512">ܘܗܘ̣ܐ</w> <w xml:id="w513">ܕܟܕ</w> <w xml:id="w514">ܫܡ̇ܥܘ</w> <w xml:id="w515">ܒܒ̈ܠܝܐ</w> <w xml:id="w516">ܐܬܒܐܫ</w> <w xml:id="w517">ܠܗܘܢ</w> <w xml:id="w518">ܛܒ</w> <w xml:id="w519">ܘܐܬܟܢܫܘ</w> <w xml:id="w520">ܥܠ</w> <w xml:id="w521">ܡ̇ܠܟܐ</w> <w xml:id="w522">ܘܐܬܗܦܟܘ</w> <w xml:id="w523">ܥܠܘܗܝܘܐܡ̇ܪܝܢ</w> <w xml:id="w524">ܚܕ</w> <w xml:id="w525">ܠܚܕ</w> <w xml:id="w526">ܝܗܘܕܝܐ</w> <w xml:id="w527">ܗ̣ܘܐ</w> <w xml:id="w528">ܠܗ</w> <w xml:id="w529">ܡ̇ܠܟܐ</w> <w xml:id="w530">ܠܒܝܠ</w> <w xml:id="w531">ܬܒ̇ܪ</w> <w xml:id="w532">ܘܠܬܢܝܢܐ</w> <w xml:id="w533">ܗܐ</w> <w xml:id="w534">ܩܛ̣ܠ</w> <w xml:id="w535">ܘܠܟܘܡܪ̈ܐܩ̇ܛܠ</w> <w xml:id="w536">ܐܢܘܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="29">
                  <p><w xml:id="w537">ܘܐܬܘ</w> <w xml:id="w538">ܠܘܬ</w> <w xml:id="w539">ܡ̇ܠܟܐ</w> <w xml:id="w540">ܘܐܡ̇ܪܝܢ</w> <w xml:id="w541">ܠܗ</w> <w xml:id="w542">ܐܘ</w> <w xml:id="w543">ܐܫܠܡ</w> <w xml:id="w544">ܠܢ</w> <w xml:id="w545">ܠܕܢܝܐܝܠ</w> <w xml:id="w546">ܘܐܠܐ</w> <w xml:id="w547">ܩ̇ܛܠܝܢܢ</w> <w xml:id="w548">ܠܟ</w> <w xml:id="w549">ܘܠܒܝܬܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="30">
                  <p><w xml:id="w550">ܘܚ̣ܙܐ</w> <w xml:id="w551">ܡ̇ܠܟܐ</w> <w xml:id="w552">ܕܩܡܘ</w> <w xml:id="w553">ܠܗܘܢ</w> <w xml:id="w554">ܥܠܘܗܝ</w> <w xml:id="w555">ܟܠܗܘܢ</w> <w xml:id="w556">ܐܟܚܕܐ</w> <w xml:id="w557">ܘܐܬܐܠܨ</w> <w xml:id="w558">ܠܗ</w> <w xml:id="w559">ܘܐܠܨܐܝܬ</w> <w xml:id="w560">ܐܫܠܡܗ</w> <w xml:id="w561">ܠܗܘܢܠܕܢܝܐܝܠ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="31">
                  <p><w xml:id="w562">ܗ̣ܢܘܢ</w> <w xml:id="w563">ܕܝܢ</w> <w xml:id="w564">ܕܒܪܘܗܝ</w> <w xml:id="w565">ܠܕܢܝܐܝܠ</w> <w xml:id="w566">ܘܐܙܠܘ</w> <w xml:id="w567">ܐܪܡܝܘܗܝ</w> <w xml:id="w568">ܒܓܘܒܐ</w> <w xml:id="w569">ܕܐܪ̈ܝܘܬܐ</w> <w xml:id="w570">ܘܗ̣ܘܐ</w> <w xml:id="w571">ܬܡܢ</w> <w xml:id="w572">ܫܬܐܝܘܡ̈ܝܢ</w> <w xml:id="w573">ܕܢܟܦܢܘܢ</w> <w xml:id="w574">ܐܪ̈ܝܘܬܐ</w> <w xml:id="w575">ܘܢܐܟܠܘܢܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="32">
                  <p><w xml:id="w576">ܐܝܬ</w> <w xml:id="w577">ܗܘܐ</w> <w xml:id="w578">ܕܝܢ</w> <w xml:id="w579">ܒܗ</w> <w xml:id="w580">ܒܓܘܒܐ</w> <w xml:id="w581">ܗ̇ܘ</w> <w xml:id="w582">ܐܪ̈ܝܘܬܐ</w> <w xml:id="w583">ܫܒܥܐ</w> <w xml:id="w584">ܘܝܗ̇ܒܝܢ</w> <w xml:id="w585">ܗܘܘ</w> <w xml:id="w586">ܠܗܘܢ</w> <w xml:id="w587">ܬܪܝܢ</w> <w xml:id="w588">ܦܓܪ̈ܝܢܒܝܘܡܐ</w> <w xml:id="w589">ܘܬܪܝܢ</w> <w xml:id="w590">ܕܟܪ̈ܝܢ</w> <w xml:id="w591">ܘܒܗ̇ܢܘܢ</w> <w xml:id="w592">ܝܘܡ̈ܬܐ</w> <w xml:id="w593">ܠܐ</w> <w xml:id="w594">ܝܗ̣ܒܘ</w> <w xml:id="w595">ܠܗܘܢ</w> <w xml:id="w596">ܡܕܡ</w> <w xml:id="w597">ܕܢܐܟܠܘܢ</w> <w xml:id="w598">ܕܢܟܦܢܘܢܘܢܐܟܠܘܢܗ</w> <w xml:id="w599">ܠܕܢܝܐܝܠ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="33">
                  <p><w xml:id="w600">ܐܝܬ</w> <w xml:id="w601">ܗܘܐ</w> <w xml:id="w602">ܕܝܢ</w> <w xml:id="w603">ܚܒܩܘܩ</w> <w xml:id="w604">ܢܒܝܐ</w> <w xml:id="w605">ܒܝܗܘܕ</w> <w xml:id="w606">ܘܒ̇ܫܠ</w> <w xml:id="w607">ܗܘܐ</w> <w xml:id="w608">ܒܘܫܠܐ</w> <w xml:id="w609">ܘܦܬ</w> <w xml:id="w610">ܦܬ̈ܐ</w> <w xml:id="w611">ܒܥܪܒܐ</w> <w xml:id="w612">ܘܐܪܡܝ</w> <w xml:id="w613">ܒܗ̇ܘܐܙ̣ܠ</w> <w xml:id="w614">ܕܢܘܒܠ</w> <w xml:id="w615">ܠܚܩܠܐ</w> <w xml:id="w616">ܠܚܨܘ̈ܕܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="34">
                  <p><w xml:id="w617">ܘܐܡ̣ܪ</w> <w xml:id="w618">ܠܗ</w> <w xml:id="w619">ܡܠܐܟܗ</w> <w xml:id="w620">ܕܡܪܝܐ</w> <w xml:id="w621">ܙܠ</w> <w xml:id="w622">ܐܘܒܠ</w> <w xml:id="w623">ܡܐܟܘܠܬܐ</w> <w xml:id="w624">ܗܕܐ</w> <w xml:id="w625">ܕܥܠܝܟ</w> <w xml:id="w626">ܠܕܢܝܐܝܠ</w> <w xml:id="w627">ܕܪܡ̣ܐ</w> <w xml:id="w628">ܒܓܘܒܐܕܐܪ̈ܝܘܬܐ</w> <w xml:id="w629">ܒܒܒܠ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="35">
                  <p><w xml:id="w630">ܘܐܡ̣ܪ</w> <w xml:id="w631">ܚܒܩܘܩ</w> <w xml:id="w632">ܡܪܝ</w> <w xml:id="w633">ܠܐ</w> <w xml:id="w634">ܚ̣ܙܝܐ</w> <w xml:id="w635">ܠܝ</w> <w xml:id="w636">ܒܒܠ</w> <w xml:id="w637">ܘܠܓܘܒܐ</w> <w xml:id="w638">ܠܐ</w> <w xml:id="w639">ܝܕ̇ܥ</w> <w xml:id="w640">ܐܢܐ</w> <w xml:id="w641">ܠܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="36">
                  <p><w xml:id="w642">ܘܐܪܡܝ</w> <w xml:id="w643">ܡܠܐܟܐ</w> <w xml:id="w644">ܐܝܕܗ</w> <w xml:id="w645">ܥܠ</w> <w xml:id="w646">ܪܝܫܗ</w> <w xml:id="w647">ܕܚܒܩܘܩ</w> <w xml:id="w648">ܘܫܩܠܗ</w> <w xml:id="w649">ܒܣܥܪܐ</w> <w xml:id="w650">ܕܪܫܗ</w> <w xml:id="w651">ܘܣܡܗ</w> <w xml:id="w652">ܒܒܒܠ</w> <w xml:id="w653">ܠܥܠ</w> <w xml:id="w654">ܡܢܓܘܒܐ</w> <w xml:id="w655">ܒܥܘܙܐ</w> <w xml:id="w656">ܕܪܘܚܐ</w> <w xml:id="w657">ܕܩܘܕܫܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="37">
                  <p><w xml:id="w658">ܘܩ̣ܪܐ</w> <w xml:id="w659">ܚܒܩܘܩ</w> <w xml:id="w660">ܘܐܡ̣ܪ</w> <w xml:id="w661">ܕܢܝܐܝܠ</w> <w xml:id="w662">ܕܢܝܐܝܠ</w> <w xml:id="w663">ܩܘܡ</w> <w xml:id="w664">ܫܩܘܠ</w> <w xml:id="w665">ܫܪܘܬܐ</w> <w xml:id="w666">ܗܕܐ</w> <w xml:id="w667">ܕܫܕܪ</w> <w xml:id="w668">ܠܟ</w> <w xml:id="w669">ܐܠܗܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="38">
                  <p><w xml:id="w670">ܘܐܡ̣ܪ</w> <w xml:id="w671">ܕܢܝܐܝܠ</w> <w xml:id="w672">ܐܬܕܟܪܢܝ</w> <w xml:id="w673">ܐܠܗܐ</w> <w xml:id="w674">ܘܠܐ</w> <w xml:id="w675">ܫܒ̣ܩ</w> <w xml:id="w676">ܪ̈ܚܡܘܗܝ</w> <w xml:id="w677">ܡܢܝ</w> <w xml:id="w678">ܝ̇ܕܥ</w> <w xml:id="w679">ܐܢܐ</w> <w xml:id="w680">ܓܝܪ</w> <w xml:id="w681">ܕܠܐ</w> <w xml:id="w682">ܫܒ̇ܩܐܢܬ</w> <w xml:id="w683">ܠܐܝܠܝܢ</w> <w xml:id="w684">ܕܪ̈ܚܡܝܢ</w> <w xml:id="w685">ܠܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="39">
                  <p><w xml:id="w686">ܘܩܡ</w> <w xml:id="w687">ܕܢܝܐܝܠ</w> <w xml:id="w688">ܘܐܟ̣ܠ</w> <w xml:id="w689">ܘܫܩܠܗ</w> <w xml:id="w690">ܡܠܐܟܐ</w> <w xml:id="w691">ܠܚܒܩܘܩ</w> <w xml:id="w692">ܒܗ̇</w> <w xml:id="w693">ܒܫܥܬܐ</w> <w xml:id="w694">ܘܐܩܝܡܗ</w> <w xml:id="w695">ܒܐܬܪܐ</w> <w xml:id="w696">ܕܫܩܠܗ</w> <w xml:id="w697">ܗܘܐܡܢ</w> <w xml:id="w698">ܩܕܝܡ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="40">
                  <p><w xml:id="w699">ܘܐ̣ܬܐ</w> <w xml:id="w700">ܡ̇ܠܟܐ</w> <w xml:id="w701">ܠܝܘܡܐ</w> <w xml:id="w702">ܫܒܝܥܝܐ</w> <w xml:id="w703">ܠܡܒܟܐ</w> <w xml:id="w704">ܥܠ</w> <w xml:id="w705">ܕܢܝܐܝܠ</w> <w xml:id="w706">ܡܛܠ</w> <w xml:id="w707">ܕܟܪܝܬ</w> <w xml:id="w708">ܗܘܬ</w> <w xml:id="w709">ܠܗ</w> <w xml:id="w710">ܥܠ</w> <w xml:id="w711">ܕܢܝܐܝܠܘܐ̣ܬܐ</w> <w xml:id="w712">ܠܘܬ</w> <w xml:id="w713">ܓܘܒܐ</w> <w xml:id="w714">ܘܐܕܝܩ</w> <w xml:id="w715">ܒܓܘܒܐ</w> <w xml:id="w716">ܘܚܙܝܗܝ</w> <w xml:id="w717">ܠܕܢܝܐܝܠ</w> <w xml:id="w718">ܟܕ</w> <w xml:id="w719">ܝܬ̇ܒ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="41">
                  <p><w xml:id="w720">ܘܝܗ̣ܒ</w> <w xml:id="w721">ܩܠܐ</w> <w xml:id="w722">ܪܡܐ</w> <w xml:id="w723">ܘܐܡ̣ܪ</w> <w xml:id="w724">ܪܒ</w> <w xml:id="w725">ܗܘ</w> <w xml:id="w726">ܐܠܗܗ</w> <w xml:id="w727">ܕܕܢܝܐܝܠ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="42">
                  <p><w xml:id="w728">ܘܐܣܩܗ</w> <w xml:id="w729">ܡܢ</w> <w xml:id="w730">ܓܘܒܐ</w> <w xml:id="w731">ܘܠܒܥܠܕܒ̈ܒܘܗܝ</w> <w xml:id="w732">ܕܕܢܝܐܝܠ</w> <w xml:id="w733">ܗ̇ܢܘܢ</w> <w xml:id="w734">ܕܐܟ̣ܠܘ</w> <w xml:id="w735">ܩܪ̈ܨܘܗܝ</w> <w xml:id="w736">ܘܒܥ̇ܝܢ</w> <w xml:id="w737">ܗܘܘܠܡܩܛܠܗ</w> <w xml:id="w738">ܐܪܡܝ</w> <w xml:id="w739">ܐܢܘܢ</w> <w xml:id="w740">ܒܓܘܒܐ</w> <w xml:id="w741">ܘܒܗ̇</w> <w xml:id="w742">ܒܫܥܬܐ</w> <w xml:id="w743">ܐܟ̣ܠܘ</w> <w xml:id="w744">ܐܢܘܢ</w> <w xml:id="w745">ܐܪ̈ܝܘܬܐ</w> <w xml:id="w746">ܩܕܡܘܗܝ</w> <w xml:id="w747">ܕܡ̇ܠܟܐ</w> <w xml:id="w748">ܘܩܕܡܕܢܝܐܝܠ</w></p>
               </div>
            </div>
