            <head>
               <title><w xml:id="w1">ܐܓܪܬܐ</w> <w xml:id="w2">ܕܬܪ̈ܬܝܢ</w> <w xml:id="w3">ܕܝܘܚܢܢ</w> <w xml:id="w4">ܫܠܝܚܐ</w></title>
            </head>
            <div type="textpart" subtype="chapter" n="1">
               <div type="textpart" subtype="verse" n="1">
                  <p><w xml:id="w5">ܩܰܫܺܝܫܳܐ</w> <w xml:id="w6">܁</w> <w xml:id="w7">ܠܰܓ݂ܒ݂ܺܝܬ݂ܳܐ</w> <w xml:id="w8">ܩܽܘܪܺܝܰܐ</w> <w xml:id="w9">ܘܠܰܒ݂ܢܶܝܗ̈</w> <w xml:id="w10">܇</w> <w xml:id="w11">ܐܰܝܠܶܝܢ</w> <w xml:id="w12">ܕ݁ܶܐܢܳܐ</w>
                    <w xml:id="w13">ܡܰܚܶܒ݂</w> <w xml:id="w14">ܐ̱ܢܳܐ</w> <w xml:id="w15">ܒ݁ܰܫܪܳܪܳܐ</w> <w xml:id="w16">.</w> <w xml:id="w17">ܠܳܐ</w> <w xml:id="w18">ܗ̱ܘܳܐ</w> <w xml:id="w19">ܕ݁ܶܝܢ</w> <w xml:id="w20">ܐܶܢܳܐ</w> <w xml:id="w21">ܒ݁ܰܠܚܽܘܕ݂ܰܝ</w> <w xml:id="w22">܆</w> <w xml:id="w23">ܐܶܠܳܐ</w> <w xml:id="w24">ܟ݁ܽܠܗܽܘܢ</w>
                    <w xml:id="w25">ܐܰܝܠܶܝܢ</w> <w xml:id="w26">ܕ݁ܝܰܕ݂ܥܽܘܗ̱ܝ</w> <w xml:id="w27">ܠܰܫܪܳܪܳܐ</w> <w xml:id="w28">܇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="2">
                  <p><w xml:id="w29">ܡܶܛܽܠ</w> <w xml:id="w30">ܫܪܳܪܳܐ</w> <w xml:id="w31">ܐܰܝܢܳܐ</w> <w xml:id="w32">ܕ݁ܰܡܩܰܘܶܐ</w> <w xml:id="w33">ܒ݁ܰܢ</w> <w xml:id="w34">܁</w> <w xml:id="w35">ܘܥܰܡܰܢ</w> <w xml:id="w36">ܐܺܝܬ݂ܰܘܗ̱ܝ</w> <w xml:id="w37">܂</w>
                    <w xml:id="w38">ܠܥܳܠܰܡ</w> <w xml:id="w39">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="3">
                  <p><w xml:id="w40">ܬ݁ܶܗܘܶܐ</w> <w xml:id="w41">ܥܰܡܰܢ</w> <w xml:id="w42">܁</w> <w xml:id="w43">ܛܰܝܒ݁ܽܘܬ݂ܳܐ</w> <w xml:id="w44">ܘܪܰܚܡܶܐ̈</w> <w xml:id="w45">ܘܰܫܠܳܡܳܐ</w> <w xml:id="w46">ܡܶܢ</w> <w xml:id="w47">ܐܰܠܳܗܳܐ</w>
                    <w xml:id="w48">ܐܰܒ݂ܳܐ</w> <w xml:id="w49">܆</w> <w xml:id="w50">ܘܡܶܢ</w> <w xml:id="w51">ܡܳܪܰܢ</w> <w xml:id="w52">ܝܶܫܽܘܥ</w> <w xml:id="w53">ܡܫܺܝܚܳܐ</w> <w xml:id="w54">ܒ݁ܪܶܗ</w> <w xml:id="w55">ܕ݁ܰܐܒ݂ܳܐ</w> <w xml:id="w56">܁</w> <w xml:id="w57">ܒ݁ܰܫܪܳܪܳܐ</w> <w xml:id="w58">܂</w> <w xml:id="w59">ܘܰܒ݂ܚܽܘܒ݁ܳܐ</w>
                    <w xml:id="w60">܀</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w61">ܚܕ݂ܺܝܬ݂</w> <w xml:id="w62">ܣܰܓ݁ܺܝ</w> <w xml:id="w63">܆</w> <w xml:id="w64">ܕ݁ܶܐܫܟ݁ܚܶܬ݂</w> <w xml:id="w65">ܡܶܢ</w> <w xml:id="w66">ܒ݁ܢܰܝܟ݁ܝ̈</w> <w xml:id="w67">ܕ݁ܰܡܗܰܠܟ݂ܺܝܢ</w>
                    <w xml:id="w68">ܒ݁ܰܫܪܳܪܳܐ</w> <w xml:id="w69">܇</w> <w xml:id="w70">ܐܰܝܟ݁ܰܢܳܐ</w> <w xml:id="w71">ܕ݁ܦ݂ܽܘܩܕ݁ܳܢܳܐ</w> <w xml:id="w72">ܢܣܰܒ݂ܢܰܢ</w> <w xml:id="w73">ܡܶܢ</w> <w xml:id="w74">ܐܰܒ݂ܳܐ</w> <w xml:id="w75">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
                  <p><w xml:id="w76">ܘܗܳܫܳܐ</w> <w xml:id="w77">ܡܦ݁ܺܝܣ</w> <w xml:id="w78">ܐ̱ܢܳܐ</w> <w xml:id="w79">ܠܶܟ݂ܝ</w> <w xml:id="w80">܁</w> <w xml:id="w81">ܩܽܘܪܺܝܰܐ</w> <w xml:id="w82">܆</w> <w xml:id="w83">ܠܳܐ</w> <w xml:id="w84">ܗ̱ܘܳܐ</w> <w xml:id="w85">ܐܰܝܟ݂</w>
                    <w xml:id="w86">ܦ݁ܽܘܩܕ݁ܳܢܳܐ</w> <w xml:id="w87">ܚܰܕ݂̱ܬ݂ܳܐ</w> <w xml:id="w88">ܟ݁ܳܬ݂ܶܒ݂</w> <w xml:id="w89">ܐ̱ܢܳܐ</w> <w xml:id="w90">ܠܶܟ݂ܝ</w> <w xml:id="w91">܆</w> <w xml:id="w92">ܐܶܠܳܐ</w> <w xml:id="w93">ܗܰܘ</w> <w xml:id="w94">ܕ݁ܺܐܝܬ݂</w> <w xml:id="w95">ܗ̱ܘܳܐ</w> <w xml:id="w96">ܠܰܢ</w> <w xml:id="w97">ܡܶܢ</w>
                    <w xml:id="w98">ܫܽܘܪܳܝܳܐ</w> <w xml:id="w99">܆</w> <w xml:id="w100">ܕ݁ܢܰܚܶܒ݂</w> <w xml:id="w101">ܚܰܕ݂</w> <w xml:id="w102">ܠܚܰܕ݂</w> <w xml:id="w103">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w104">ܘܗܳܢܳܐ</w> <w xml:id="w105">ܐܺܝܬ݂ܰܘܗ̱ܝ</w> <w xml:id="w106">ܚܽܘܒ݁ܳܐ</w> <w xml:id="w107">܆</w> <w xml:id="w108">ܕ݁ܰܢܗܰܠܶܟ݂</w> <w xml:id="w109">ܐܰܝܟ݂</w> <w xml:id="w110">ܦ݁ܽܘܩܕ݁ܳܢܰܘܗ̱ܝ̈</w>
                    <w xml:id="w111">.</w> <w xml:id="w112">ܗܳܢܳܐ</w> <w xml:id="w113">ܦ݁ܽܘܩܕ݁ܳܢܳܐ</w> <w xml:id="w114">ܐܺܝܬ݂ܰܘܗ̱ܝ</w> <w xml:id="w115">܁</w> <w xml:id="w116">ܐܰܝܟ݂</w> <w xml:id="w117">ܡܳܐ</w> <w xml:id="w118">ܕ݁ܰܫܡܰܥܬ݁ܽܘܢ</w> <w xml:id="w119">ܡܶܢ</w> <w xml:id="w120">ܫܽܘܪܳܝܳܐ</w> <w xml:id="w121">܆</w> <w xml:id="w122">ܕ݁ܒ݂ܶܗ</w>
                    <w xml:id="w123">ܗܘܰܝܬ݁ܽܘܢ</w> <w xml:id="w124">ܡܗܰܠܟ݂ܺܝܢ</w> <w xml:id="w125">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w126">ܡܶܛܽܠ</w> <w xml:id="w127">ܕ݁ܣܰܓ݁ܺܝܶܐܐ̈</w> <w xml:id="w128">ܡܰܛܥܝܳܢܶܐ̈</w> <w xml:id="w129">ܢܦ݂ܰܩܘ</w> <w xml:id="w130">ܒ݁ܶܗ</w> <w xml:id="w131">ܒ݁ܥܳܠܡܳܐ</w> <w xml:id="w132">.</w> <w xml:id="w133">ܐܰܝܠܶܝܢ</w>
                    <w xml:id="w134">ܕ݁ܠܳܐ</w> <w xml:id="w135">ܡܰܘܕ݁ܶܝܢ</w> <w xml:id="w136">ܕ݁ܝܶܫܽܘܥ</w> <w xml:id="w137">ܡܫܺܝܚܳܐ</w> <w xml:id="w138">ܐܶܬ݂ܳܐ</w> <w xml:id="w139">ܒ݁ܰܒ݂ܣܰܪ</w> <w xml:id="w140">.</w> <w xml:id="w141">ܗܳܢܳܐ</w> <w xml:id="w142">ܐܺܝܬ݂ܰܘܗ̱ܝ</w> <w xml:id="w143">ܡܰܛܥܝܳܢܳܐ</w>
                    <w xml:id="w144">ܘܰܐܢܛܺܝܟ݂ܪܺܝܣܛܳܘܣ</w> <w xml:id="w145">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w146">ܐܶܙܕ݁ܰܗ̱ܪܘ</w> <w xml:id="w147">ܒ݁ܢܰܦ݂ܫܟ݂ܽܘܢ</w> <w xml:id="w148">܆</w> <w xml:id="w149">ܕ݁ܠܳܐ</w> <w xml:id="w150">ܬ݁ܰܘܒ݁ܕ݂ܽܘܢ</w> <w xml:id="w151">ܡܶܕ݁ܶܡ</w>
                    <w xml:id="w152">ܕ݁ܰܦ݂ܠܰܚܬ݁ܽܘܢ</w> <w xml:id="w153">܇</w> <w xml:id="w154">ܐܶܠܳܐ</w> <w xml:id="w155">ܐܰܓ݂ܪܳܐ</w> <w xml:id="w156">ܡܫܰܠܡܳܢܳܐ</w> <w xml:id="w157">ܬ݁ܶܬ݂ܦ݁ܰܪܥܽܘܢ</w> <w xml:id="w158">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w159">ܟ݁ܽܠ</w> <w xml:id="w160">ܐܰܝܢܳܐ</w> <w xml:id="w161">ܕ݁ܥܳܒ݂ܰܪ</w> <w xml:id="w162">ܘܠܳܐ</w> <w xml:id="w163">ܡܩܰܘܶܐ</w> <w xml:id="w164">ܒ݁ܝܽܘܠܦ݁ܳܢܶܗ</w> <w xml:id="w165">ܕ݁ܰܡܫܺܝܚܳܐ</w> <w xml:id="w166">܆</w>
                    <w xml:id="w167">ܐܰܠܳܗܳܐ</w> <w xml:id="w168">ܠܰܝܬ݁</w> <w xml:id="w169">ܒ݁ܶܗ</w> <w xml:id="w170">.</w> <w xml:id="w171">ܗܰܘ</w> <w xml:id="w172">ܕ݁ܰܡܩܰܘܶܐ</w> <w xml:id="w173">ܒ݁ܝܽܘܠܦ݁ܳܢܶܗ</w> <w xml:id="w174">܆</w> <w xml:id="w175">ܗܳܢܳܐ</w> <w xml:id="w176">܁</w> <w xml:id="w177">ܘܠܰܐܒ݂ܳܐ</w> <w xml:id="w178">ܘܠܰܒ݂ܪܳܐ</w>
                    <w xml:id="w179">ܐܺܝܬ݂</w> <w xml:id="w180">ܠܶܗ</w> <w xml:id="w181">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w182">ܐܶܢ</w> <w xml:id="w183">ܐ̱ܢܳܫ</w> <w xml:id="w184">ܐܳܬ݂ܶܐ</w> <w xml:id="w185">ܠܘܳܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w186">܇</w> <w xml:id="w187">ܘܗܳܢܳܐ</w> <w xml:id="w188">ܝܽܘܠܦ݁ܳܢܳܐ</w> <w xml:id="w189">ܠܳܐ</w> <w xml:id="w190">ܡܰܝܬ݁ܶܐ</w>
                    <w xml:id="w191">܆</w> <w xml:id="w192">ܠܳܐ</w> <w xml:id="w193">ܬ݁ܩܰܒ݁ܠܽܘܢܳܝܗ̱ܝ</w> <w xml:id="w194">ܒ݁ܒ݂ܰܝܬ݁ܳܐ</w> <w xml:id="w195">.</w> <w xml:id="w196">ܘܰܚܕ݂ܺܝ</w> <w xml:id="w197">ܠܳܟ݂</w> <w xml:id="w198">܁</w> <w xml:id="w199">ܠܳܐ</w> <w xml:id="w200">ܬ݁ܺܐܡܪܽܘܢ</w> <w xml:id="w201">ܠܶܗ</w> <w xml:id="w202">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w203">ܗܰܘ</w> <w xml:id="w204">ܓ݁ܶܝܪ</w> <w xml:id="w205">ܕ݁ܳܐܡܰܪ</w> <w xml:id="w206">ܠܶܗ</w> <w xml:id="w207">ܚܕ݂ܺܝ</w> <w xml:id="w208">ܠܳܟ݂</w> <w xml:id="w209">܆</w> <w xml:id="w210">ܡܫܰܘܬ݁ܰܦ݂</w> <w xml:id="w211">ܗ̱ܽܘ</w>
                    <w xml:id="w212">ܠܰܥܒ݂ܳܕ݂ܰܘܗ̱ܝ̈</w> <w xml:id="w213">ܒ݁ܺܝܫܶܐ̈</w> <w xml:id="w214">܀</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w215">ܟ݁ܰܕ݂</w> <w xml:id="w216">ܣܰܓ݁ܺܝܳܐܬ݂ܳܐ̈</w> <w xml:id="w217">ܐܺܝܬ݂</w> <w xml:id="w218">ܗ̱ܘܳܐ</w> <w xml:id="w219">ܠܺܝ</w> <w xml:id="w220">ܠܡܶܟ݂ܬ݁ܰܒ݂</w> <w xml:id="w221">ܠܟ݂ܽܘܢ</w> <w xml:id="w222">܆</w> <w xml:id="w223">ܠܳܐ</w>
                    <w xml:id="w224">ܒ݁ܥܺܝܬ݂</w> <w xml:id="w225">ܕ݁ܰܒ݂ܝܰܕ݂</w> <w xml:id="w226">ܟ݁ܰܪܛܺܝܣܳܐ</w> <w xml:id="w227">ܘܰܕ݂ܝܽܘܬ݂ܳܐ</w> <w xml:id="w228">.</w> <w xml:id="w229">ܐܶܠܳܐ</w> <w xml:id="w230">ܡܣܰܒ݁ܰܪ</w> <w xml:id="w231">ܐ̱ܢܳܐ</w> <w xml:id="w232">܁</w> <w xml:id="w233">ܕ݁ܺܐܬ݂ܶܐ</w>
                    <w xml:id="w234">ܠܘܳܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w235">܆</w> <w xml:id="w236">ܘܦ݂ܽܘܡܳܐ</w> <w xml:id="w237">ܠܘܳܬ݂</w> <w xml:id="w238">ܦ݁ܽܘܡܳܐ</w> <w xml:id="w239">ܢܡܰܠܶܠ</w> <w xml:id="w240">܇</w> <w xml:id="w241">ܕ݁ܚܰܕ݂ܽܘܬ݂ܳܐ</w> <w xml:id="w242">ܕ݁ܺܝܠܰܢ</w> <w xml:id="w243">ܬ݁ܶܗܘܶܐ</w>
                    <w xml:id="w244">ܡܫܰܡܠܝܳܐ</w> <w xml:id="w245">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w246">ܫܳܐܠܺܝܢ</w> <w xml:id="w247">ܫܠܳܡܶܟ݂ܝ</w> <w xml:id="w248">܆</w> <w xml:id="w249">ܒ݁ܢܰܝܳܐ̈</w> <w xml:id="w250">ܕ݁ܚܳܬ݂ܶܟ݂ܝ</w> <w xml:id="w251">ܓ݁ܒ݂ܺܝܬ݂ܳܐ</w> <w xml:id="w252">܂</w> <w xml:id="w253">ܐܰܡܺܝܢ</w>
                    <w xml:id="w254">܀</w></p>
               </div>
            </div>
         </div>
      </body>
   </text>
