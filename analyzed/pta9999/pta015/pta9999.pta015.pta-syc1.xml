               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w155">ܘܟܦܝ̣ܦ</w> <w xml:id="w156">ܐܢܐ</w> <w xml:id="w157">ܒܣܘܓܐܐ</w> <w xml:id="w158">ܕܐܣܘܪ̈ܐ</w> <w xml:id="w159" norm="ܕܦܪܙܠ̣̇ܐ̇">ܕܦܪܙܠ̣̇ܐ̇</w><w xml:id="w160">·</w> <w xml:id="w161">ܐܝܟ</w> <w xml:id="w162">ܕܠܐ</w> <w xml:id="w163">ܐܪܝܡ</w> <w xml:id="w164">ܪܝܫܝ</w> <w xml:id="w165">ܠܥܠ</w><w xml:id="w166">.</w> <w xml:id="w167">ܐܦܠܐ</w> <w xml:id="w168">ܓܝܪܫ̇ܘܐ</w> <w xml:id="w169">ܐܢܐ</w> <w xml:id="w170">ܕܐܪܝܡ</w> <w xml:id="w171">ܥܝ̈ܢܝ</w> <w xml:id="w172">ܘܐܚܘܪ</w> <w xml:id="w173">ܘܐܚ̇ܙܐ</w> <w xml:id="w174">ܪܘܡܐ</w> <w xml:id="w175">ܗ̇ܘ</w> <w xml:id="w176">ܕܫܡܝܐ</w><w xml:id="w177">.</w> <w xml:id="w178">ܡܛܠ</w> <w xml:id="w179">ܣܘܓܐܐ</w> <w xml:id="w180">ܕܡܒܐܫܢܘܬܐܕܪ̈ܘܫܥܝ̇</w><w xml:id="w181">·</w> <w xml:id="w182">ܡܛܠ</w> <w xml:id="w183">ܕܥ̇ܒܕܬ</w> <w xml:id="w184">ܒܝ̈ܫܬܐ</w> <w xml:id="w185">ܩܕܡܝܟ</w><w xml:id="w186">.</w> <w xml:id="w187">ܘܐܪܓܙܬ</w> <w xml:id="w188">ܠܚܡܬܟ</w><w xml:id="w189">.</w> <w xml:id="w190">ܘܐ̇ܩܝܡܬ</w> <w xml:id="w191">ܦܬܟܪ̈ܐܘܐܣ̇ܓܝ̣ܬ</w> <w xml:id="w192">ܛ̇ܢܦܘܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w193">ܘܗܫܐ</w> <w xml:id="w194">ܗܐ</w> <w xml:id="w195">ܟ̇ܐܦ</w> <w xml:id="w196">ܐܢܐ</w> <w xml:id="w197">ܒܘܪ̈ܟܘܗܝ</w> <w xml:id="w198">ܕܠܒܝ</w> <w xml:id="w199">ܩܕܡܝܟ</w><w xml:id="w200">.</w> <w xml:id="w201">ܘܒ̇ܥܐ</w> <w xml:id="w202">ܐܢܐ</w> <w xml:id="w203">ܡܢ</w> <w xml:id="w204">ܒܣܝܡܘܬܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w205">ܚ̇ܛܝܬ</w> <w xml:id="w206">ܡܪܝܐ</w> <w xml:id="w207">ܚ̇ܛܝܬ</w><w xml:id="w208">.</w> <w xml:id="w209">ܘܡܛܠ</w> <w xml:id="w210">ܕܝܕܥ̇</w> <w xml:id="w211">ܐܢܐ</w> <w xml:id="w212">ܚ̈ܛܗܝ̣</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w213">ܡ̇ܬܟܫܦ</w> <w xml:id="w214">ܐܢܐ</w> <w xml:id="w215">ܩܕܡܝܟ</w><w xml:id="w216">.</w> <w xml:id="w217">ܫܒܘܩ</w> <w xml:id="w218">ܠܝ</w> <w xml:id="w219">ܡܪܝܐ</w> <w xml:id="w220">ܘܠܐ</w> <w xml:id="w221">ܬܘܒܕܝܢܝ</w> <w xml:id="w222">ܥܡ</w> <w xml:id="w223">ܣܟ̈ܠܘܬܝ</w><w xml:id="w224">.</w> <w xml:id="w225">ܘܠܐ</w> <w xml:id="w226">ܠܥܠܡܬܪܓܙ</w> <w xml:id="w227">ܥܠܝ</w><w xml:id="w228">.</w> <w xml:id="w229">ܘܠܐ</w> <w xml:id="w230">ܬܛܪ</w> <w xml:id="w231">ܠܝ</w> <w xml:id="w232">ܒ̈ܝ̣ܫܬܝ</w><w xml:id="w233">.</w> <w xml:id="w234">.</w> <w xml:id="w235">ܘܠܐ</w> <w xml:id="w236">ܬܚ̇ܝܒܢܝ</w> <w xml:id="w237">ܘܬܐܫܕܢܝ</w> <w xml:id="w238">ܒ̈ܬܐܚܬܝܬܗ̇ܕܐܪܥܐ</w><w xml:id="w239">.</w> <w xml:id="w240">ܐܢܬ</w> <w xml:id="w241">ܗܘ</w> <w xml:id="w242">ܓܝܪ</w> <w xml:id="w243">ܐܠܗܐ</w> <w xml:id="w244">ܕܬܝ̈ܒܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w245">ܐܦ</w> <w xml:id="w246">ܗܟܝܠ</w> <w xml:id="w247">ܚ̇ܘܐ</w> <w xml:id="w248">ܡܪܝ</w> <w xml:id="w249">ܛ̇ܝܒܘܬܟ</w><w xml:id="w250">.</w> <w xml:id="w251">ܘܟܕ</w> <w xml:id="w252">ܠܐ</w> <w xml:id="w253">ܫ̇ܘܐ</w> <w xml:id="w254">ܐܢܐ</w> <w xml:id="w255">ܦܪܩ̇</w> <w xml:id="w256">ܐܢܬ</w> <w xml:id="w257">ܠܝ</w> <w xml:id="w258">ܐܝܟ</w> <w xml:id="w259">ܣܘܓܐܐܕܪ̈ܚܡ̣ܝܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w260">ܡܛܠܗܕܐ</w> <w xml:id="w261">ܐ̇ܫܒܚܟ</w> <w xml:id="w262">ܒܟܠܙܒܢ</w><w xml:id="w263">.</w> <w xml:id="w264">ܘܒܟܠܗܘܢ</w> <w xml:id="w265">ܝܘ̈ܡܬܐ</w> <w xml:id="w266">ܕܚ̈ܝܝ</w><w xml:id="w267">.</w> <w xml:id="w268">ܡܛܠ</w> <w xml:id="w269">ܕܠܟ</w> <w xml:id="w270">ܡ̇ܫܒܚܝܢ</w> <w xml:id="w271">ܟܠܗܘܢܚ̈ܝܠܘܬܐ</w> <w xml:id="w272">ܕܫܡܝܐ</w><w xml:id="w273">.</w> <w xml:id="w274">ܘܠܟ</w> <w xml:id="w275">ܡܙܡܪܝܢ</w> <w xml:id="w276">ܠܥܠܡ</w> <w xml:id="w277">ܘܠܥܠܡ</w> <w xml:id="w278">ܥܠܡܝܢ</w><w xml:id="w279">܀</w></p>
               </div>
            </div>
         </div>
      </body>
