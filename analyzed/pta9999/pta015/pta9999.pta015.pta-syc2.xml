               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w174">ܟܦܝܦ</w> <w xml:id="w175">ܐܢܐ</w> <w xml:id="w176">ܕܝܢ</w> <w xml:id="w177">ܘܪܟܝ̣ܢ</w> <w xml:id="w178">ܠܬܚܬ</w> <w xml:id="w179">ܒܣܘܓܐܐ</w> <w xml:id="w180">ܕܐܣ̈ܘܪܐ</w> <w xml:id="w181">ܕܦܪܙܠܐ</w><w xml:id="w182">.</w> <w xml:id="w183">ܐܟܡܢ</w> <w xml:id="w184">ܕܠܐ</w> <w xml:id="w185">ܡ̇ܫܟܚ</w> <w xml:id="w186">ܐܢܐܕܐܬܗ̇ܦܟ</w> <w xml:id="w187">ܘܐܪܝܡ</w> <w xml:id="w188">ܢܦܫܝ</w><w xml:id="w189">.</w> <w xml:id="w190">ܡܛܠ</w> <w xml:id="w191">ܕܣܟ̈ܠܘܬܝ</w> <w xml:id="w192">ܘܚܛܗ̈ܝ</w> <w xml:id="w193">ܥܒ̇ܪ̈ܝ</w> <w xml:id="w194">ܠܪܝܫܝ</w><w xml:id="w195">.</w> <w xml:id="w196">ܘܠܝܬ</w> <w xml:id="w197">ܠܝ</w> <w xml:id="w198">ܡܟܝܠܐܣܝܘܬܐ</w><w xml:id="w199">.</w> <w xml:id="w200">ܡܛܠ</w> <w xml:id="w201">ܕܝܬܝܪ</w> <w xml:id="w202">ܐܪܓܙܬ</w> <w xml:id="w203">ܠܚܡܬܟ</w><w xml:id="w204">.</w> <w xml:id="w205">ܘܟܠ</w> <w xml:id="w206">ܕܒܝ̣ܫ</w> <w xml:id="w207">ܩܕܡܝܟ</w> <w xml:id="w208">ܥܒ̇ܕܬ</w><w xml:id="w209">.</w> <w xml:id="w210">ܠܐ</w> <w xml:id="w211">ܓܝܪ</w> <w xml:id="w212">ܥܒܕܬܨܒܝܢܟ</w> <w xml:id="w213">ܘܠܐ</w> <w xml:id="w214">ܢܛ̇ܪܬ</w> <w xml:id="w215">ܦܘܩܕܢܝ̈ܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w216">ܘܗܫܐ</w> <w xml:id="w217">ܡ̇ܪܟܢ</w> <w xml:id="w218">ܐܢܐ</w> <w xml:id="w219">ܒܘܪ̈ܟܘܗܝ</w> <w xml:id="w220">ܕܠܒܝ</w><w xml:id="w221">.</w> <w xml:id="w222">ܟܕ</w> <w xml:id="w223">ܒ̇ܥܐ</w> <w xml:id="w224">ܐܢܐ</w> <w xml:id="w225">ܡܢ</w> <w xml:id="w226">ܒܣܝܡܘܬܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w227">ܚܛܝܬ</w> <w xml:id="w228">ܠܟ</w> <w xml:id="w229">ܡܪܝܐ</w> <w xml:id="w230">ܚܛܝܬ̇</w><w xml:id="w231">·</w> <w xml:id="w232">ܘܠܥܘ̈ܠܝ</w> <w xml:id="w233">ܐܢܐ</w> <w xml:id="w234">ܝ̇ܕܥ</w> <w xml:id="w235">ܐܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w236">ܐܠܐ</w> <w xml:id="w237">ܫܐ̇ܠ</w> <w xml:id="w238">ܐܢܐ</w> <w xml:id="w239">ܟܕ</w> <w xml:id="w240">ܒܥܐ</w> <w xml:id="w241">ܐܢܐ</w> <w xml:id="w242">ܡܢܟ</w><w xml:id="w243">.</w> <w xml:id="w244">ܫܒܘܩ</w> <w xml:id="w245">ܠܝ</w> <w xml:id="w246">ܡܪܝܐ</w> <w xml:id="w247">ܫܒܘܩ</w> <w xml:id="w248">ܠܝ</w> <w xml:id="w249">ܘܠܐ</w> <w xml:id="w250">ܬܘܒܕܢܝܒܚ̈ܛܗܝ</w><w xml:id="w251">.</w> <w xml:id="w252">ܘܠܐ</w> <w xml:id="w253">ܠܥܠܡ</w> <w xml:id="w254">ܬܪܓܙ</w> <w xml:id="w255">ܥܠܝ</w> <w xml:id="w256">ܘܬܛܪ</w> <w xml:id="w257">ܒܝ̣ܫ̈ܬܝ</w><w xml:id="w258">.</w> <w xml:id="w259">ܘܠܐ</w> <w xml:id="w260">ܬܚܝܒܢܝ</w> <w xml:id="w261">ܒܬܚܬܝ̈ܬܗ̇</w> <w xml:id="w262">ܕܐܪܥܐ</w><w xml:id="w263">.</w><w xml:id="w264">ܡܛܠ</w> <w xml:id="w265">ܕܐܢܬ</w> <w xml:id="w266">ܗܘ</w> <w xml:id="w267">ܐܠܗܐ</w> <w xml:id="w268">ܕܐܝܠܝܢ</w> <w xml:id="w269">ܕܬܝܒ̈ܝܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w270">ܘܒܝ</w> <w xml:id="w271">ܡ̇ܚܘܐ</w> <w xml:id="w272">ܐܢܬ</w> <w xml:id="w273">ܟܠܗ̇</w> <w xml:id="w274">ܛ̇ܝܒܘܬܟ</w><w xml:id="w275">.</w> <w xml:id="w276">ܘܟܕ</w> <w xml:id="w277">ܠܐ</w> <w xml:id="w278">ܫ̇ܘܐ</w> <w xml:id="w279">ܐܢܐ</w> <w xml:id="w280">ܡܫ̇ܘܙܒ</w> <w xml:id="w281">ܐܢܬ</w> <w xml:id="w282">ܠܝ</w> <w xml:id="w283">ܒܣܘܓܐܐܕܡܪܚܡܢܘܬܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w284">ܘܐ̇ܫܒܚܟ</w> <w xml:id="w285">ܘܐܩܠܣܟ</w> <w xml:id="w286">ܒܟܠܙܒܢ</w><w xml:id="w287">.</w> <w xml:id="w288">ܒܟܠܗ̈ܘܢ</w> <w xml:id="w289">ܝܘ̈ܡܬܐ</w> <w xml:id="w290">ܕܚ̈ܝܝ</w><w xml:id="w291">.</w> <w xml:id="w292">ܡܛܠ</w> <w xml:id="w293">ܕܠܟ</w> <w xml:id="w294">ܗܘ</w> <w xml:id="w295">ܡܫ̈ܒܚܝܢܟܠܗܘܢ</w> <w xml:id="w296">ܚ̈ܝܠܘܬܐ</w> <w xml:id="w297">ܕܫܡܝܐ</w> <w xml:id="w298">ܘܕܝܠܟ</w> <w xml:id="w299">ܗܝ</w> <w xml:id="w300">ܬܫܒ̇</w><w xml:id="w301">—</w><w xml:id="w302">ܘ̇</w><w xml:id="w303">—</w> <w xml:id="w304">ܘܩܘܠܣܐ</w> <w xml:id="w305">ܘܪܘܡܪܡܐ</w> <w xml:id="w306">ܠܥܠܡ</w> <w xml:id="w307">ܘܠܥܠܡ</w> <w xml:id="w308">ܥܠܡܝܢܐܡܝܢ</w><w xml:id="w309">.</w></p>
               </div>
            </div>
         </div>
      </body>
