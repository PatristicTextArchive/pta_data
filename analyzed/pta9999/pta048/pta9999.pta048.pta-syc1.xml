                  <p><w xml:id="w512">ܪ̈ܘܪܒܢܝܗ̇</w> <w xml:id="w513">ܒܓܘܗ̇</w> <w xml:id="w514">ܐܝܟ</w> <w xml:id="w515">ܐܪ̈ܝܘܬܐ</w> <w xml:id="w516">ܢܗܡܝܢ</w> <w xml:id="w517">ܘܕܝܢ̈ܝܗ̇</w> <w xml:id="w518">ܐܝܟ</w> <w xml:id="w519">ܕܐ̈ܒܐ</w> <w xml:id="w520">ܕܪܡܫܐ</w> <w xml:id="w521">ܘܠܐ</w> <w xml:id="w522">ܡܟܬܪܝܢܠܨܦܪܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w523">ܢܒܝ̈ܝܗ̇</w> <w xml:id="w524">ܦܚܙܝܢ</w> <w xml:id="w525">ܘܓܒܪ̈ܐ</w> <w xml:id="w526">ܐܢܘܢ</w> <w xml:id="w527">ܥ̇ܘ̈ܠܐ</w> <w xml:id="w528">ܟܗ̈ܢܝܗ̇</w> <w xml:id="w529">ܛܘܫܘ</w> <w xml:id="w530">ܡܩܕܫܐ</w> <w xml:id="w531">ܘܚܛܦܘ</w> <w xml:id="w532">ܢܡܘܣܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
                  <p><w xml:id="w533">ܘܡܪܝܐ</w> <w xml:id="w534">ܙܕܝܩܐ</w> <w xml:id="w535">ܒܓܘܗ̇</w> <w xml:id="w536">ܘܠܐ</w> <w xml:id="w537">ܥܒܕ</w> <w xml:id="w538">ܥܘܠܐ</w> <w xml:id="w539">ܒܨܦܪܐ</w> <w xml:id="w540">ܘܒܨܦܪܐ</w> <w xml:id="w541">ܕܝ̈ܢܘܗܝ</w> <w xml:id="w542">ܝܗܒ</w> <w xml:id="w543">ܒܢܘܗܪܐ</w> <w xml:id="w544">ܘܠܐܡܫܘܚܪ</w> <w xml:id="w545">ܘܥ̇ܘܠܐ</w> <w xml:id="w546">ܠܐ</w> <w xml:id="w547">ܝܕܥ</w> <w xml:id="w548">ܒܗܬܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w549">ܐܘܒܕܬ</w> <w xml:id="w550">ܥܡ̈ܡܐ</w> <w xml:id="w551">ܘܐܬܚܒܠܬ</w> <w xml:id="w552">ܕܘܝܬܐ</w> <w xml:id="w553">ܐܚܪܒܬ</w> <w xml:id="w554">ܫ̈ܘܩܝܗܘܢ</w> <w xml:id="w555">ܡܢ</w> <w xml:id="w556">ܒܠܝ</w> <w xml:id="w557">ܕܥܒܪ</w> <w xml:id="w558">ܨ̈ܕܝ</w> <w xml:id="w559">ܡ̈ܕܝܢܬܗܘܢܡܢ</w> <w xml:id="w560">ܒܠܝ</w> <w xml:id="w561">ܐܢܫ</w> <w xml:id="w562">ܘܡܢ</w> <w xml:id="w563">ܒܠܝ</w> <w xml:id="w564">ܕܝܬܒ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w565">ܐܡܪܬ</w> <w xml:id="w566">ܕܠܝ</w> <w xml:id="w567">ܬܕܚܠܘܢ</w> <w xml:id="w568">ܘܡܢܝ</w> <w xml:id="w569">ܬܩܒܠܘܢ</w> <w xml:id="w570">ܡܪܕܘܬܐ</w> <w xml:id="w571">ܘܠܐ</w> <w xml:id="w572">ܢܐܒܕ</w> <w xml:id="w573">ܡܢ</w> <w xml:id="w574">ܥܝܢ̈ܝܗ̇</w> <w xml:id="w575">ܟܠܡܕܡ</w> <w xml:id="w576">ܕܦܩܕܬܥܠܝܗ̇</w> <w xml:id="w577">ܐܬܛܝܒܘ</w> <w xml:id="w578">ܘܩܪܘܒܘ</w> <w xml:id="w579">ܘܚܒܠܘ</w> <w xml:id="w580">ܟܠܗܝܢ</w> <w xml:id="w581">ܨܢ̈ܥܬܗܘܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w582">ܡܟܝܠ</w> <w xml:id="w583">ܣܟܘ</w> <w xml:id="w584">ܠܝ</w> <w xml:id="w585">ܐܡܪ</w> <w xml:id="w586">ܡܪܝܐ</w> <w xml:id="w587">ܠܝܘܡܐ</w> <w xml:id="w588">ܕܩܐܡ</w> <w xml:id="w589">ܐܢܐ</w> <w xml:id="w590">ܠܣܗܕܘܬܐ</w> <w xml:id="w591">ܡܛܠ</w> <w xml:id="w592">ܕܡܛܝ</w> <w xml:id="w593">ܕܝܢܝ</w> <w xml:id="w594">ܠܡܟܢܫܘܥܡ̈ܡܐ</w> <w xml:id="w595">ܘܠܡܩܪܒܘ</w> <w xml:id="w596">ܡ̈ܠܟܘܬܐ</w> <w xml:id="w597">ܠܡܐܫܕ</w> <w xml:id="w598">ܥܠܝܗܘܢ</w> <w xml:id="w599">ܪܘܓܙܝ</w> <w xml:id="w600">ܘܟܠܗ̇</w> <w xml:id="w601">ܚܡܬܐ</w> <w xml:id="w602">ܕܪܘܓܙܝ</w> <w xml:id="w603">ܡܛܠ</w> <w xml:id="w604">ܕܒܢܘܪܐܕܛܢܢܝ</w> <w xml:id="w605">ܬܬܐܟܠ</w> <w xml:id="w606">ܟܠܗ̇</w> <w xml:id="w607">ܐܪܥܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w608">ܘܗܝܕܝܢ</w> <w xml:id="w609">ܐܗܦܟ</w> <w xml:id="w610">ܥܠ</w> <w xml:id="w611">ܥܡ̈ܡܐ</w> <w xml:id="w612">ܣܦܬܐ</w> <w xml:id="w613">ܓܒܝܬܐ</w> <w xml:id="w614">ܕܢܩܪܘܢ</w> <w xml:id="w615">ܟܠܗܘܢ</w> <w xml:id="w616">ܒܫܡܗ</w> <w xml:id="w617">ܕܡܪܝܐ</w> <w xml:id="w618">ܘܢܦܠܚܘܢܗܒܢܝܪܐ</w> <w xml:id="w619">ܚܕ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w620">ܡܢ</w> <w xml:id="w621">ܥܒܪ</w> <w xml:id="w622">ܢܗܪ̈ܘܬܐ</w> <w xml:id="w623">ܕܟܘܫ</w> <w xml:id="w624">ܢܝܬܘܢ</w> <w xml:id="w625">ܠܝ</w> <w xml:id="w626">ܕܒܚ̈ܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w627">ܒܝܘܡܐ</w> <w xml:id="w628">ܗ̇ܘ</w> <w xml:id="w629">ܠܐ</w> <w xml:id="w630">ܬܒܗܬܝܢ</w> <w xml:id="w631">ܡܢ</w> <w xml:id="w632">ܟܘܠܗܝܢ</w> <w xml:id="w633">ܨܢ̈ܥܬܟܝ</w> <w xml:id="w634">ܕܐܥܠܝܬܝ</w> <w xml:id="w635">ܒܝ</w> <w xml:id="w636">ܘܗܝܕܝܢ</w> <w xml:id="w637">ܐܥܒܪ</w> <w xml:id="w638">ܡܢܟܝܥܘܫܢܐ</w> <w xml:id="w639">ܕܓܐܝܘܬܟܝ</w> <w xml:id="w640">ܘܠܐ</w> <w xml:id="w641">ܬܘܣܦܝܢ</w> <w xml:id="w642">ܬܘܒ</w> <w xml:id="w643">ܠܡܬܪܘܪܒܘ</w> <w xml:id="w644">ܥܠ</w> <w xml:id="w645">ܛܘܪܐ</w> <w xml:id="w646">ܕܩܘܕܫܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w647">ܘܐܘܬܪ</w> <w xml:id="w648">ܒܓܘܟܝ</w> <w xml:id="w649">ܥܡܐ</w> <w xml:id="w650">ܡܣܟܢܐ</w> <w xml:id="w651">ܘܡܟܝܟܐ</w> <w xml:id="w652">ܘܢܣܒܪܘܢ</w> <w xml:id="w653">ܒܫܡܗ</w> <w xml:id="w654">ܕܡܪܝܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w655">ܘܐܝܠܝܢ</w> <w xml:id="w656">ܕܐܫܬܚܪܘ</w> <w xml:id="w657">ܡܢ</w> <w xml:id="w658">ܕܒܝܬ</w> <w xml:id="w659">ܐܝܣܪܝܠ</w> <w xml:id="w660">ܠܐ</w> <w xml:id="w661">ܢܥܒܕܘܢ</w> <w xml:id="w662">ܥܘܠܐ</w> <w xml:id="w663">ܘܠܐ</w> <w xml:id="w664">ܢܡܠܠܘܢ</w> <w xml:id="w665">ܕܓܠܘܬܐ</w> <w xml:id="w666">ܘܠܐܢܫܬܟܚ</w> <w xml:id="w667">ܒܦܘܡܗܘܢ</w> <w xml:id="w668">ܠܫܢܐ</w> <w xml:id="w669">ܕܢܟܠܐ</w> <w xml:id="w670">ܡܛܠ</w> <w xml:id="w671">ܕܗܢܘܢ</w> <w xml:id="w672">ܢܪܥܘܢ</w> <w xml:id="w673">ܘܢܪܒܥܘܢ</w> <w xml:id="w674">ܘܠܐ</w> <w xml:id="w675">ܢܗܘܐ</w> <w xml:id="w676">ܠܗܘܢ</w> <w xml:id="w677">ܡܗܪܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w678">ܫܒܚܝ</w> <w xml:id="w679">ܒܪܬ</w> <w xml:id="w680">ܨܗܝܘܢ</w> <w xml:id="w681">ܘܝܒܒ</w> <w xml:id="w682">ܐܝܣܪܝܠ</w> <w xml:id="w683">ܚܕܝ</w> <w xml:id="w684">ܘܕܘܨܝ</w> <w xml:id="w685">ܒܟܠܗ</w> <w xml:id="w686">ܠܒܟܝ</w> <w xml:id="w687">ܒܪܬ</w> <w xml:id="w688">ܐܘܪܫܠܡ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w689">ܐܥܒܪ</w> <w xml:id="w690">ܡܪܝܐ</w> <w xml:id="w691">ܕܝܢ̈ܝܟܝ</w> <w xml:id="w692">ܘܐܦܪܩ</w> <w xml:id="w693">ܡܢܟܝ</w> <w xml:id="w694">ܒ̈ܥܠܕܒܒܝܟܝ</w> <w xml:id="w695">ܡܠܟܗ</w> <w xml:id="w696">ܕܐܝܣܪܝܠ</w> <w xml:id="w697">ܡܪܝܐ</w> <w xml:id="w698">ܒܓܘܟܝ</w> <w xml:id="w699">ܬܘܒܠܐ</w> <w xml:id="w700">ܬܚܙܝܢ</w> <w xml:id="w701">ܒܝܫܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w702">ܒܗ</w> <w xml:id="w703">ܒܝܘܡܐ</w> <w xml:id="w704">ܗ̇ܘ</w> <w xml:id="w705">ܢܬܐܡܪ</w> <w xml:id="w706">ܠܐܘܪܫܠܡ</w> <w xml:id="w707">ܠܐ</w> <w xml:id="w708">ܬܕܚܠܝܢ</w> <w xml:id="w709">ܘܠܨܗܝܘܢ</w> <w xml:id="w710">ܠܐ</w> <w xml:id="w711">ܢܬܪ̈ܦܝܢ</w> <w xml:id="w712">ܐ̈ܝܕܝܟܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w713">ܡܪܝܐ</w> <w xml:id="w714">ܐܠܗܟܝ</w> <w xml:id="w715">ܒܓܘܟܝ</w> <w xml:id="w716">ܓܢܒܪܐ</w> <w xml:id="w717">ܘܦܪܘܩܐ</w> <w xml:id="w718">ܢܒܣܡܟܝ</w> <w xml:id="w719">ܒܚܕܘܬܐ</w> <w xml:id="w720">ܘܢܚܕܬܟܝ</w> <w xml:id="w721">ܒܚܘܒܗ</w> <w xml:id="w722">ܘܢܕܝܨܟܝܒܬܫܒܘܚܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="18">
                  <p><w xml:id="w723">ܐܝܟ</w> <w xml:id="w724">ܕܒܝܘܡܐ</w> <w xml:id="w725">ܕܥܕܥܐܕܐ</w> <w xml:id="w726">ܘܐܥܒܪ</w> <w xml:id="w727">ܡܢܟܝ</w> <w xml:id="w728">ܐܝܠܝܢ</w> <w xml:id="w729">ܕܡܡܠܠܝܢ</w> <w xml:id="w730">ܗܘܘ</w> <w xml:id="w731">ܥܠܝܟܝ</w> <w xml:id="w732">ܚܣܕܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w733">ܗܐ</w> <w xml:id="w734">ܥܒܕ</w> <w xml:id="w735">ܐܢܐ</w> <w xml:id="w736">ܠܟܠܗܘܢ</w> <w xml:id="w737">ܟܕ</w> <w xml:id="w738">ܡܡܟܟܝܢ</w> <w xml:id="w739">ܒܓܘܟܝ</w> <w xml:id="w740">ܒܙܒܢܐ</w> <w xml:id="w741">ܗ̇ܘ</w> <w xml:id="w742">ܘܐܦܪܘܩ</w> <w xml:id="w743">ܠܟܒܝܫܬܐ</w> <w xml:id="w744">ܘܠܪܚܝܩܬܐܐܟܢܫ</w> <w xml:id="w745">ܘܐܥܒܕ</w> <w xml:id="w746">ܐܢܘܢ</w> <w xml:id="w747">ܠܫܡܐ</w> <w xml:id="w748">ܘܠܬܫܒܘܚܬܐ</w> <w xml:id="w749">ܒܟܠܗ̇</w> <w xml:id="w750">ܐܪܥܐ</w> <w xml:id="w751">ܕܒܗܬܬܗܘܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="20">
                  <p><w xml:id="w752">ܒܗ</w> <w xml:id="w753">ܒܙܒܢܐ</w> <w xml:id="w754">ܗ̇ܘ</w> <w xml:id="w755">ܐܝܬܝܟܘܢ</w> <w xml:id="w756">ܘܒܗ</w> <w xml:id="w757">ܒܙܒܢܐ</w> <w xml:id="w758">ܗ̇ܘ</w> <w xml:id="w759">ܐܟܢܫܟܘܢ</w> <w xml:id="w760">ܘܐܬܠܟܘܢ</w> <w xml:id="w761">ܠܫܡܐ</w> <w xml:id="w762">ܘܠܬܫܒܘܚܬܐܒܟܠܗܘܢ</w> <w xml:id="w763">ܥܡ̈ܡܐ</w> <w xml:id="w764">ܕܐܪܥܐ</w> <w xml:id="w765">ܡܐ</w> <w xml:id="w766">ܕܡܗܦܟ</w> <w xml:id="w767">ܐܢܐ</w> <w xml:id="w768">ܫܒܝܬܟܘܢ</w> <w xml:id="w769">ܠܥܢܝ̈ܗܘܢ</w> <w xml:id="w770">ܐܡܪ</w> <w xml:id="w771">ܡܪܝܐ</w></p>
               </div>
            </div>
         </div>
