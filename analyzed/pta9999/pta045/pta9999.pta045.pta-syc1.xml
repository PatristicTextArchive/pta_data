               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w570">ܘܦܩܕ</w> <w xml:id="w571">ܡܪܝܐ</w> <w xml:id="w572">ܐܠܗܐ</w> <w xml:id="w573">ܠܫܪܘܪܐ</w> <w xml:id="w574">ܕܩܪܐܐ</w> <w xml:id="w575">ܘܝܥܐ</w> <w xml:id="w576">ܘܣܠܩ</w> <w xml:id="w577">ܠܥܠ</w> <w xml:id="w578">ܡܢ</w> <w xml:id="w579">ܝܘܢܢ</w> <w xml:id="w580">ܘܗܘܐ</w> <w xml:id="w581">ܛܠܠܐ</w> <w xml:id="w582">ܥܠ</w> <w xml:id="w583">ܪܝܫܗܘܐܪܘܚ</w> <w xml:id="w584">ܠܗ</w> <w xml:id="w585">ܡܢ</w> <w xml:id="w586">ܒܝܫܬܗ</w> <w xml:id="w587">ܘܚܕܝ</w> <w xml:id="w588">ܝܘܢܢ</w> <w xml:id="w589">ܒܗ</w> <w xml:id="w590">ܒܫܪܘܪܐ</w> <w xml:id="w591">ܕܩܪܐܐ</w> <w xml:id="w592">ܚܕܘܬܐ</w> <w xml:id="w593">ܪܒܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w594">ܘܠܝܘܡܐ</w> <w xml:id="w595">ܐܚܪܢܐ</w> <w xml:id="w596">ܦܩܕ</w> <w xml:id="w597">ܡܪܝܐ</w> <w xml:id="w598">ܐܠܗܐ</w> <w xml:id="w599">ܠܬܘܠܥܐ</w> <w xml:id="w600">ܒܡܣܩ̈ܝ</w> <w xml:id="w601">ܫܦܪܐ</w> <w xml:id="w602">ܘܡܚܬܗ</w> <w xml:id="w603">ܠܫܪܘܪܐ</w> <w xml:id="w604">ܕܩܪܐܐܘܩܛܡܬܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w605">ܘܟܕ</w> <w xml:id="w606">ܕܢܚܬ</w> <w xml:id="w607">ܫܡܫܐ</w> <w xml:id="w608">ܦܩܕ</w> <w xml:id="w609">ܡܪܝܐ</w> <w xml:id="w610">ܐܠܗܐ</w> <w xml:id="w611">ܠܪܘܚܐ</w> <w xml:id="w612">ܕܫܘܒܐ</w> <w xml:id="w613">ܘܐܘܒܫܬܗ</w> <w xml:id="w614">ܠܩܪܐܐ</w> <w xml:id="w615">ܘܨܚܬ</w> <w xml:id="w616">ܫܡܫܐ</w> <w xml:id="w617">ܒܪܝܫܗܕܝܘܢܢ</w> <w xml:id="w618">ܘܐܬܛܪܦ</w> <w xml:id="w619">ܘܫܐܠ</w> <w xml:id="w620">ܡܘܬܐ</w> <w xml:id="w621">ܠܢܦܫܗ</w> <w xml:id="w622">ܘܐܡܪ</w> <w xml:id="w623">ܡܛܐ</w> <w xml:id="w624">ܒܐ̈ܝܕܝܟ</w> <w xml:id="w625">ܡܪܝܐ</w> <w xml:id="w626">ܠܡܣܒ</w> <w xml:id="w627">ܢܦܫܝ</w> <w xml:id="w628">ܡܢܝ</w><w xml:id="w629">.</w> <w xml:id="w630">ܡܛܠܕܠܐ</w> <w xml:id="w631">ܗܘܝܬ</w> <w xml:id="w632">ܛܒ</w> <w xml:id="w633">ܐܢܐ</w> <w xml:id="w634">ܡܢ</w> <w xml:id="w635">ܐܒ̈ܗܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w636">ܘܐܡܪ</w> <w xml:id="w637">ܡܪܝܐ</w> <w xml:id="w638">ܐܠܗܐ</w> <w xml:id="w639">ܠܝܘܢܢ</w> <w xml:id="w640">ܛܒ</w> <w xml:id="w641">ܟܪܝܬ</w> <w xml:id="w642">ܠܟ</w> <w xml:id="w643">ܥܠ</w> <w xml:id="w644">ܫܪܘܪܐ</w> <w xml:id="w645">ܕܩܪܐܐ</w> <w xml:id="w646">ܘܐܡܪ</w> <w xml:id="w647">ܝܘܢܢ</w> <w xml:id="w648">ܛܒ</w> <w xml:id="w649">ܟܪܝܬ</w> <w xml:id="w650">ܠܝܥܕܡܐ</w> <w xml:id="w651">ܠܡܘܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w652">ܐܡܪ</w> <w xml:id="w653">ܠܗ</w> <w xml:id="w654">ܡܪܝܐ</w> <w xml:id="w655">ܐܢܬ</w> <w xml:id="w656">ܚܣܬ</w> <w xml:id="w657">ܥܠ</w> <w xml:id="w658">ܫܪܘܪܐ</w> <w xml:id="w659">ܕܩܪܐܐ</w> <w xml:id="w660">ܕܠܐ</w> <w xml:id="w661">ܠܐܝܬ</w> <w xml:id="w662">ܒܗ</w> <w xml:id="w663">ܘܠܐ</w> <w xml:id="w664">ܪܒܝܬܝܗܝ</w> <w xml:id="w665">ܕܒܪ</w> <w xml:id="w666">ܠܠܝܗܝܥܐ</w> <w xml:id="w667">ܘܒܪ</w> <w xml:id="w668">ܠܠܝܗ</w> <w xml:id="w669">ܝܒܫ</w></p>
