                  <p><w xml:id="w500">ܘܨܠܝ</w> <w xml:id="w501">ܩܕܡ</w> <w xml:id="w502">ܡܪܝܐ</w> <w xml:id="w503">ܘܐܡܪ</w> <w xml:id="w504">ܐܘܢ</w> <w xml:id="w505">ܡܪܝܐ</w> <w xml:id="w506">ܠܐ</w> <w xml:id="w507">ܗܘܬ</w> <w xml:id="w508">ܗܕܐ</w> <w xml:id="w509">ܡܠܬܝ</w> <w xml:id="w510">ܟܕ</w> <w xml:id="w511">ܐܢܐ</w> <w xml:id="w512">ܒܐܪܥܝ</w> <w xml:id="w513">ܘܡܛܠ</w> <w xml:id="w514">ܗܢܐܩܕܡܬ</w> <w xml:id="w515">ܗܘܝܬ</w> <w xml:id="w516">ܥܪܩܬ</w> <w xml:id="w517">ܠܝ</w> <w xml:id="w518">ܠܬܪܫܝܫ</w> <w xml:id="w519">ܝܕܥ</w> <w xml:id="w520">ܗܘܝܬ</w> <w xml:id="w521">ܓܝܪ</w> <w xml:id="w522">ܕܐܠܗܐ</w> <w xml:id="w523">ܐܢܬ</w> <w xml:id="w524">ܡܪܚܡܢܐ</w> <w xml:id="w525">ܘܡܪܚܦܢܐ</w> <w xml:id="w526">ܘܢܓܝܪܐܪܘܚܟ</w> <w xml:id="w527">ܘܣܓܝܐܐ</w> <w xml:id="w528">ܛܝܒܘܬܟ</w> <w xml:id="w529">ܘܡܗܦܟ</w> <w xml:id="w530">ܐܢܬ</w> <w xml:id="w531">ܒܝܫܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="3">
                  <p><w xml:id="w532">ܡܟܝܠ</w> <w xml:id="w533">ܡܪܝ</w> <w xml:id="w534">ܣܒ</w> <w xml:id="w535">ܢܦܫܝ</w> <w xml:id="w536">ܡܢܝ</w> <w xml:id="w537">ܡܛܠ</w> <w xml:id="w538">ܕܦܩܚ</w> <w xml:id="w539">ܠܝ</w> <w xml:id="w540">ܠܡܡܬ</w> <w xml:id="w541">ܛܒ</w> <w xml:id="w542">ܡܢ</w> <w xml:id="w543">ܕܠܡܚܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w544">ܘܐܡܪ</w> <w xml:id="w545">ܠܗ</w> <w xml:id="w546">ܡܪܝܐ</w> <w xml:id="w547">ܛܒ</w> <w xml:id="w548">ܟܪܝܬ</w> <w xml:id="w549">ܠܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
