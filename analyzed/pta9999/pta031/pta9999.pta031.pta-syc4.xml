                  <p><w xml:id="w176">ܕܡܐܐ</w> <w xml:id="w177">ܘܚܡܫܝܢ</w> <w xml:id="w178">ܘܐܪܒܥ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="1">
                  <p><w xml:id="w179">ܒܩܠܐ̇</w> <w xml:id="w180">ܪܡܐ̣</w> <w xml:id="w181">ܫܒ̇ܚܘ</w> <w xml:id="w182">ܠܐܠܗܐ</w><w xml:id="w183">.</w> <w xml:id="w184">ܒܥܕܬܐ̇</w> <w xml:id="w185">ܕܣܓ̈ܝܐܐ̣</w> <w xml:id="w186" norm="ܐ̣̇ܫܡܥܘ">ܐ̣̇ܫܡܥܘ</w> <w xml:id="w187">ܫܘܒܚܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="2">
                  <p><w xml:id="w188">ܘܒܣܘܓܐܐ̇</w> <w xml:id="w189">ܕܬܪ̈ܝܨܐ</w> <w xml:id="w190">ܫܒܚܘ</w> <w xml:id="w191">ܩܘܠܣܗ</w><w xml:id="w192">.</w> <w xml:id="w193">ܘܥܡ</w> <w xml:id="w194">ܫܪܝܪ̈ܐ</w> <w xml:id="w195">ܐܫܬܥܘ</w> <w xml:id="w196">ܬܫܒܘܚܬܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="3">
                  <p><w xml:id="w197">ܫ̇ܘܬܦܘ̇</w> <w xml:id="w198">ܠܛܒ̈ܐ</w> <w xml:id="w199">ܢܦܫܟܘܢ̣</w><w xml:id="w200">.</w> <w xml:id="w201">ܘܠܬܡܝ̈ܡܐ</w> <w xml:id="w202">ܠܡܫܒܚܘ</w> <w xml:id="w203">ܠܥܠܝܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w204">ܐܬܟܢܫܘ</w> <w xml:id="w205">ܐܟܚܕܐ̇</w> <w xml:id="w206">ܠܡܘܕܥܘ</w> <w xml:id="w207">ܥܘܫܢܗ̣</w><w xml:id="w208">.</w> <w xml:id="w209">ܘܠܐ</w> <w xml:id="w210">ܬܡܐܢܘܢ</w> <w xml:id="w211">ܠܡܚܘܝܘ</w> <w xml:id="w212">ܦܘܪܩܢܗ̇</w><w xml:id="w213">.</w> <w xml:id="w214">ܘܫܘܒܚܗܠܟܠܗܘܢ</w> <w xml:id="w215">ܫܒܪ̈ܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
                  <p><w xml:id="w216">ܡܛܠ</w> <w xml:id="w217">ܕܢ̣ܬܝܕܥ</w> <w xml:id="w218">ܐܝܩܪܗ</w> <w xml:id="w219">ܕܡܪܝܐ</w> <w xml:id="w220">ܐܬܝܗܒ̣ܬ</w> <w xml:id="w221">ܚܟܡܬܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w222">ܘܠܡܫܬܥܝܘ</w> <w xml:id="w223">ܥܒ̇ܕ̈ܘܗܝ</w> <w xml:id="w224">ܐܬܝܕܥ̣ܬ</w> <w xml:id="w225">ܠܐܢܫܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w226">ܠܡܘܕܥܘ̇</w> <w xml:id="w227">ܠܫܒܪ̈ܐ</w> <w xml:id="w228">ܥܘܫܢܗ̣</w><w xml:id="w229">.</w> <w xml:id="w230" norm="ܘܠ̣̇ܡܣ̣̇ܟܠܘ">ܘܠ̣̇ܡܣ̣̇ܟܠܘ</w> <w xml:id="w231">ܠܚܣܝܪ̈ܝ</w> <w xml:id="w232">ܠܒܐ</w> <w xml:id="w233">ܬܫܒܘܚܬܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w234">ܕܪܚܝܩܝܢ̇</w> <w xml:id="w235">ܡ̣ܢ</w> <w xml:id="w236" norm="ܡ̣̇ܥܠܢܗ̣̈">ܡ̣̇ܥܠܢܗ̣̈</w> <w xml:id="w237" norm="ܘܡ̣̇ܒܕܪܝܢ">ܘܡ̣̇ܒܕܪܝܢ</w> <w xml:id="w238">ܡ̣ܢ</w> <w xml:id="w239">ܬܪܥܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w240">ܡܛܠ</w> <w xml:id="w241">ܕܥܠܝܐ</w> <w xml:id="w242">ܗ̣ܘ</w> <w xml:id="w243">ܡܪܗ</w> <w xml:id="w244">ܕܝܥܩܘܒ</w><w xml:id="w245">.</w> <w xml:id="w246">ܘܫܘܒܗܪܗ̣</w> <w xml:id="w247">ܥܠ</w> <w xml:id="w248">ܟܠ</w> <w xml:id="w249">ܥܒ̇ܕ̈ܘܗܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w250">ܘܐܢܫ</w> <w xml:id="w251">ܕܡܫܒܚ</w> <w xml:id="w252">ܠܥܠܝܐ̣</w><w xml:id="w253">.</w> <w xml:id="w254" norm="ܢܨܛܒܐ̣̇">ܢܨܛܒܐ̣̇</w> <w xml:id="w255">ܒܗ̣</w> <w xml:id="w256">ܐܝܟ</w> <w xml:id="w257">ܗ̇ܘ</w> <w xml:id="w258" norm="ܕܡܩ̣̇ܪܒ">ܕܡܩ̣̇ܪܒ</w> <w xml:id="w259">ܣܡܝܕܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w260">ܘܐܝܟ</w> <w xml:id="w261" norm="ܕܡܩ̣̇ܪ̣ܒ">ܕܡܩ̣̇ܪ̣ܒ</w> <w xml:id="w262">ܬܝ̈ܫܐ</w> <w xml:id="w263">ܘܒܢ̈ܝ</w> <w xml:id="w264">ܬܘܪ̈ܐ</w><w xml:id="w265">.</w> <w xml:id="w266">ܘܐܝܟ</w> <w xml:id="w267" norm="ܕܡܕ̣̇ܗ̣ܢ">ܕܡܕ̣̇ܗ̣ܢ</w> <w xml:id="w268">ܡܕܒܚܐ</w> <w xml:id="w269" norm="ܒܣܘܓܐܐܕܝ̣̇ܩ̈ܕܐ">ܒܣܘܓܐܐܕܝ̣̇ܩ̈ܕܐ</w><w xml:id="w270">.</w> <w xml:id="w271">ܘܐܝܟ</w> <w xml:id="w272">ܪܝܚܐ</w> <w xml:id="w273">ܕܒܣܡ̈ܐ</w> <w xml:id="w274">ܡ̣ܢ</w> <w xml:id="w275">ܐܝ̣ܕܐ</w> <w xml:id="w276">ܕܙܕ̈ܝܩܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w277">ܡ̣ܢ</w> <w xml:id="w278">ܬܪ̈ܥܝ</w> <w xml:id="w279">ܟܐ̈ܢܐ</w> <w xml:id="w280" norm="ܡܫܬܡ̣̇ܥ">ܡܫܬܡ̣̇ܥ</w> <w xml:id="w281">ܩܠܗ</w><w xml:id="w282">.</w> <w xml:id="w283">ܘܡ̣ܢ</w> <w xml:id="w284">ܩܠܐ</w> <w xml:id="w285">ܕܟܐܢ̈ܐ</w> <w xml:id="w286">ܡܪܬܝܢܘܬܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w287">ܘܥܠ</w> <w xml:id="w288">ܡܐܟܘܠܬܗܘܢ̇</w> <w xml:id="w289">ܣܒܥܐ̇</w> <w xml:id="w290">ܒܫܪܪܐ̣</w><w xml:id="w291">.</w> <w xml:id="w292">ܘܥܠ</w> <w xml:id="w293">ܡܫܬܘܬܗܘܢ</w> <w xml:id="w294">ܡܫܬܝܗ̈ܘܢ</w> <w xml:id="w295">ܐܟܚܕܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w296">ܫܘܥ̈ܝܬܗܘܢ̇</w> <w xml:id="w297">ܒܢܡܘܣܗ</w> <w xml:id="w298">ܕܥܠܝܐ</w><w xml:id="w299">.</w> <w xml:id="w300">ܘܡܐܡܪܗܘܢ̣</w> <w xml:id="w301">ܠܡܘܕܥ̇ܘ</w> <w xml:id="w302">ܥܘܫܢܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w303">ܟܡ̇ܐ</w> <w xml:id="w304">ܪܚܝ̣ܩ</w> <w xml:id="w305">ܡ̣ܢ</w> <w xml:id="w306">ܪ̈ܫܝܥܐ</w> <w xml:id="w307">ܡܐܡܪܗ</w><w xml:id="w308">.</w> <w xml:id="w309">ܘܡ̣ܢ</w> <w xml:id="w310">ܟܠ</w> <w xml:id="w311">ܥܘ̈ܠܐ</w> <w xml:id="w312">ܠܡ̣ܕܥܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w313">ܗܐ̇</w> <w xml:id="w314">ܥܝܢܗ̇</w> <w xml:id="w315">ܕܡܪܝܐ̣</w> <w xml:id="w316">ܥܠ</w> <w xml:id="w317">ܛ̇ܒ̈ܐ</w> <w xml:id="w318">ܬܚܘܣ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w319">ܘܥܠ</w> <w xml:id="w320">ܡܫܒ̈ܚܢܘܗ̣ܝ</w> <w xml:id="w321" norm="ܢ̣̇ܣܓ̣̣ܐ">ܢ̣̇ܣܓ̣̣ܐ</w> <w xml:id="w322">ܪ̈ܚܡ̣ܐ</w><w xml:id="w323">.</w> <w xml:id="w324">ܘܡ̣ܢ</w> <w xml:id="w325">ܥܕܢ</w> <w xml:id="w326">ܒܝܫܬܐ̣</w> <w xml:id="w327">ܡܫܘܙ̣ܒ</w> <w xml:id="w328">ܢܦܫܗܘܢ̇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="18">
                  <p><w xml:id="w329">ܒܪܝܟ</w> <w xml:id="w330">ܡܪܝܐ</w> <w xml:id="w331">ܕܦܪ̣ܩ</w> <w xml:id="w332">ܒܝ̇ܫ̈ܐ</w> <w xml:id="w333">ܡ̣ܢ</w> <w xml:id="w334">ܐܝܕܐ</w> <w xml:id="w335">ܕܢܘܟܪ̈ܝܐ̇</w><w xml:id="w336">.</w> <w xml:id="w337">ܘܡܫ݃ܘܙܒ</w> <w xml:id="w338">ܠܬܡ̈ܝܡܐ</w> <w xml:id="w339">ܡ̣ܢ</w> <w xml:id="w340">ܐܝܕܐܕܪ̈ܫܝܥܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w341">ܕܡܩ̣ܝܡ̇</w> <w xml:id="w342">ܩܪܢܐ</w> <w xml:id="w343">ܡܢ</w> <w xml:id="w344">ܝܥܩܘܒ̣</w><w xml:id="w345">.</w> <w xml:id="w346">ܘܕܝ̇ܢ̣ܐ</w> <w xml:id="w347">ܕܥܡ̈ܡܐ</w> <w xml:id="w348">ܡ̣ܢ</w> <w xml:id="w349">ܝܣܪܝܠ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="20">
                  <p><w xml:id="w350">ܕܢܓ̣ܪ̣</w><w xml:id="w351">.</w> <w xml:id="w352">ܡܫܟܢܗ</w> <w xml:id="w353">ܒܨܗܝܘܢ̣</w><w xml:id="w354">.</w> <w xml:id="w355" norm="ܘܢ̣̇ܨܒ̣̇ܬ">ܘܢ̣̇ܨܒ̣̇ܬ</w> <w xml:id="w356">ܠܥܠܡ</w> <w xml:id="w357">ܥܠܡܝܢ̣</w> <w xml:id="w358">ܒܐܘܪܫܠܡ</w></p>
               </div>
            </div>
            <div type="textpart" subtype="chapter" n="155">
               <div type="textpart" subtype="verse" n="0">
                  <p><w xml:id="w359">ܕܡܐܐ</w> <w xml:id="w360">ܘܚܡܫܝܢ</w> <w xml:id="w361">ܘܚܡܫ</w><w xml:id="w362">.</w><w xml:id="w363">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="1">
                  <p><w xml:id="w364">ܡܪܝܐ</w> <w xml:id="w365">ܩ̇ܪܝܬ</w> <w xml:id="w366">ܠܘܬܟ̇</w> <w xml:id="w367" norm="ܐ̣̇ܨ̣ܬ">ܐ̣̇ܨ̣ܬ</w> <w xml:id="w368">ܠܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="2">
                  <p><w xml:id="w369">ܦܫܛܬ</w> <w xml:id="w370">ܐܝ̈ܕܝ</w> <w xml:id="w371">ܠܡܕܝܪ̈ܐ</w> <w xml:id="w372">ܕܩܘܕܫܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="3">
                  <p><w xml:id="w373">ܐܪܟ̣̣ܢ̇</w> <w xml:id="w374">ܐܕܢܟ̣</w> <w xml:id="w375">ܘܗܒ</w> <w xml:id="w376">ܠܝ</w> <w xml:id="w377" norm="ܫ̣ܐܠ̣̇ܬܝ">ܫ̣ܐܠ̣̇ܬܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w378">ܒܥܘܬܝ̣</w> <w xml:id="w379">ܠܐ</w> <w xml:id="w380">ܬܟܠ̣ܐ</w> <w xml:id="w381">ܡܢܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
                  <p><w xml:id="w382">ܒܥܝܗ̈</w> <w xml:id="w383">ܠܢܦܫܝ̣</w> <w xml:id="w384">ܘܠܐ</w> <w xml:id="w385" norm="ܬ̣̇ܚܪ̣̣ܒ̣̣ܝܗ̇">ܬ̣̇ܚܪ̣̣ܒ̣̣ܝܗ̇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w386">ܘܠܐ</w> <w xml:id="w387">ܬܓܠܝܗ̇</w> <w xml:id="w388">ܩܕܡ</w> <w xml:id="w389">ܪ̈ܫܝܥܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w390">ܦ݃ܪ̈ܥܝ</w> <w xml:id="w391">ܒܝܫܬܐ̣</w> <w xml:id="w392" norm="ܐ̣̇ܗܦ̣ܟ">ܐ̣̇ܗܦ̣ܟ</w> <w xml:id="w393">ܡܢܝ</w><w xml:id="w394">.</w> <w xml:id="w395">ܕܝ̇ܢܐ</w> <w xml:id="w396">ܕܩܘܫܬܐ̇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w397">ܡܪܝܐ̣</w> <w xml:id="w398">ܠܐ</w> <w xml:id="w399" norm="ܬܕܘܢ̣̇ܝܢܝ">ܬܕܘܢ̣̇ܝܢܝ</w> <w xml:id="w400">ܐܝܟ</w> <w xml:id="w401">ܚܛܗ̈ܝ</w><w xml:id="w402">.</w> <w xml:id="w403">ܡܛܠ</w> <w xml:id="w404">ܕܠܐ</w> <w xml:id="w405">ܙ̇ܟܐ</w> <w xml:id="w406">ܩܕܡܝܟ</w> <w xml:id="w407">ܟܠ</w> <w xml:id="w408">ܕܚܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w409">ܣܟܠܝܢܝ</w> <w xml:id="w410">ܡܪܝܐ̈</w> <w xml:id="w411">ܢܡܘܣܟ̇</w> <w xml:id="w412">ܘܕ̈ܝܢܝܟ̣</w> <w xml:id="w413">ܐܠ̇ܦܝܢܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w414">ܕܢܫܡܥܘܢ</w> <w xml:id="w415">ܣ̈ܓܝܐܐ</w> <w xml:id="w416">ܥܒ̇ܕ̈ܝܟ̣</w><w xml:id="w417">.</w> <w xml:id="w418">ܘܥܡ̈ܡܐ̣</w> <w xml:id="w419">ܢܘܕܘܢ</w> <w xml:id="w420">ܠܐܝܩܪܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w421">ܐܬܕܟܪܝܢܝ̇</w> <w xml:id="w422">ܘܠܐ</w> <w xml:id="w423">ܬ̣ܛܥܝܢܝ</w><w xml:id="w424">.</w> <w xml:id="w425">ܘܠܐ</w> <w xml:id="w426" norm="ܬ̣̇ܥܠ̣̇ܢܝ">ܬ̣̇ܥܠ̣̇ܢܝ</w> <w xml:id="w427">ܒ̇ܕܩ̈ܫ̣ܝܢ</w> <w xml:id="w428">ܡܢܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w429">ܚ̈ܛܗܐ̇</w> <w xml:id="w430">ܕܛܠܝܘܬܝ̣</w> <w xml:id="w431">ܐ̇ܥܒܪ</w> <w xml:id="w432">ܡܢܝ</w><w xml:id="w433">.</w> <w xml:id="w434">ܘܡܪܘܕܘܬܝ̣</w> <w xml:id="w435">ܠܐ</w> <w xml:id="w436">ܬܕܟܪ</w> <w xml:id="w437">ܠܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w438">ܕܟ݃ܢܝ</w> <w xml:id="w439">ܡܪܝܐ̇</w> <w xml:id="w440">ܡ̣ܢ</w> <w xml:id="w441">ܓܪܒ̣ܐ</w> <w xml:id="w442">ܒܝ̣ܫܐ̣</w><w xml:id="w443">.</w> <w xml:id="w444">ܘܠܐ</w> <w xml:id="w445">ܢ݃ܘܣܦ</w> <w xml:id="w446" norm="ܠܡ̣̇ܗܦ݃ܟܘ">ܠܡ̣̇ܗܦ݃ܟܘ</w> <w xml:id="w447">ܠܘܬܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w448" norm="ܝ̣̇ܒ̣ܫ">ܝ̣̇ܒ̣ܫ</w> <w xml:id="w449">̇</w><w xml:id="w450">·</w><w xml:id="w451">ܥܩܪ̈ܘܗܝ</w> <w xml:id="w452">ܡܢܝ̣</w><w xml:id="w453">.</w> <w xml:id="w454">ܘܠܐ</w> <w xml:id="w455">ܢ̇ܦܪ̈ܥܘܢ</w> <w xml:id="w456">ܛܪ̈ܦܘܗܝ</w> <w xml:id="w457">ܒܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w458">ܥܫܝܢܐ̣</w> <w xml:id="w459">ܘܪܒܐ</w> <w xml:id="w460">ܐܢܬ̇</w> <w xml:id="w461">ܡܪܝܐ̇̈</w><w xml:id="w462">.</w> <w xml:id="w463">ܡܛܠ</w> <w xml:id="w464">ܗܟܢ̇</w> <w xml:id="w465" norm="ܫܐܠ̣̇ܬܝ">ܫܐܠ̣̇ܬܝ</w> <w xml:id="w466">ܡ̣ܢ</w> <w xml:id="w467">ܩܕܡܝܟ</w> <w xml:id="w468">ܡܫܬܡܠܝܐ̇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w469">ܠܡ̇ܢ</w> <w xml:id="w470">ܐ̣ܩܒ̇ܘܠ</w> <w xml:id="w471">ܘܢܬܠ</w> <w xml:id="w472">̇</w><w xml:id="w473">·</w><w xml:id="w474">ܠܝ</w><w xml:id="w475">.</w> <w xml:id="w476">ܘܒܢܝ̈ܢܫܐ</w> <w xml:id="w477">ܡ̇ܢܐ</w> <w xml:id="w478">ܡܘܣܦ</w> <w xml:id="w479">ܚܝܠ̇ܗܘܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w480">ܡ̣ܢ</w> <w xml:id="w481">ܩܕܡܝܟ</w> <w xml:id="w482">ܡܪܝܐ</w> <w xml:id="w483">ܬܘܟܠܢܝ</w><w xml:id="w484">.</w> <w xml:id="w485">ܩ̇ܪܝܬ̇</w> <w xml:id="w486">ܠܡܪܝܐ̣</w> <w xml:id="w487">ܘܥܢܢܝ̣</w><w xml:id="w488">.</w> <w xml:id="w489">ܘܐܣܝ</w> <w xml:id="w490">ܠܬܒ݃ܪܐ</w> <w xml:id="w491">ܕܠܒܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="18">
                  <p><w xml:id="w492">ܢ̇ܡ̇ܬ̣</w> <w xml:id="w493">ܘܕܡ̇ܟ̇ܬ</w><w xml:id="w494">.</w> <w xml:id="w495">ܚ̇ܠܡ̇ܬ</w> <w xml:id="w496">ܐܦ</w> <w xml:id="w497">ܐܬܬܥ̇ܝܪܬ̇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w498">ܘܣܡ̣ܟܬܢܝ̇</w> <w xml:id="w499">ܡܪܝܐ̈</w><w xml:id="w500">.</w> <w xml:id="w501">.</w> <w xml:id="w502">ܘܐܩܒܠ</w> <w xml:id="w503">̇</w><w xml:id="w504">·</w> <w xml:id="w505">ܡܛܠ</w> <w xml:id="w506">ܕܦܨܝ̇ܢܝ</w> <w xml:id="w507">ܡܪܝܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="20">
                  <p><w xml:id="w508">ܐ̇ܚܙܐ</w> <w xml:id="w509">ܗܫܐ</w> <w xml:id="w510" norm="ܒܗܬ̣̇ܬܗܘܢ">ܒܗܬ̣̇ܬܗܘܢ</w><w xml:id="w511">.</w> <w xml:id="w512">ܣ̇ܒ̇ܪܬ</w> <w xml:id="w513">̇</w><w xml:id="w514">·</w><w xml:id="w515">ܒܟ̣</w> <w xml:id="w516">ܘܠܐ</w> <w xml:id="w517">ܐܒܗ̣ܬ</w><w xml:id="w518">.</w> <w xml:id="w519">ܗܒ</w> <w xml:id="w520">ܐܝܩܪܐ̇</w> <w xml:id="w521">ܠܥ̇ܠܡ̣ܘܠܥ̇ܠܡ</w> <w xml:id="w522">ܥܠܡܝܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="21">
                  <p><w xml:id="w523">ܦܪܘܩ̇</w><w xml:id="w524">·</w> <w xml:id="w525">ܠܝܣܪܝܠ̇</w><w xml:id="w526">·</w> <w xml:id="w527">ܓܒܝܟ̣</w><w xml:id="w528">.</w> <w xml:id="w529">ܘܠܕܒܝܬ</w> <w xml:id="w530">ܝܥܩܘܒ</w> <w xml:id="w531">ܒܚܝܪܟ</w><w xml:id="w532">.</w> <w xml:id="w533">ܫܠܡ</w> <w xml:id="w534">ܒܥܘܕܪܢܗ</w> <w xml:id="w535">ܕܡܪܢ</w> <w xml:id="w536">ܟܬܒܐܕܡܙܡܘܪ̈ܐ</w> <w xml:id="w537">ܕܛܘܒܢܐ</w> <w xml:id="w538">ܕܘܝܕ</w> <w xml:id="w539">ܢܒܝܐ</w> <w xml:id="w540">ܘܡܠܟܐ</w><w xml:id="w541">.</w> <w xml:id="w542">ܥܡ</w> <w xml:id="w543">ܚܡܫܐ</w> <w xml:id="w544">ܡܙܡܘܪ̈ܐ</w> <w xml:id="w545">ܕܠܝܬܝܗܘܢ</w> <w xml:id="w546">ܡ̣ܢ</w> <w xml:id="w547">ܡܢܝܢܐܝܘܢܝܐ</w> <w xml:id="w548">ܘܠܐ</w> <w xml:id="w549">ܥܒܪܝܐ</w> <w xml:id="w550">܀</w> <w xml:id="w551">ܒܪܡ</w> <w xml:id="w552">ܐܝܟ</w> <w xml:id="w553">ܕܐܡܪܝܢ</w> <w xml:id="w554">ܐܫܬܟܚܘ</w> <w xml:id="w555">ܒܣܘܪܝܝܐ</w> <w xml:id="w556">ܘܟܬܒܢ</w> <w xml:id="w557">ܐܢܘܢ</w> <w xml:id="w558">ܠܗ̇ܘ</w> <w xml:id="w559">ܕܒܥ̣ܐ</w><w xml:id="w560">.</w></p>
               </div>
            </div>
         </div>
      </body>
   </text>
