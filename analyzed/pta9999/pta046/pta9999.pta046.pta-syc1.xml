               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w470">ܘܥܡܟܝ</w> <w xml:id="w471">ܐܝܟ</w> <w xml:id="w472">ܢܫ̈ܐ</w> <w xml:id="w473">ܐܢܘܢ</w> <w xml:id="w474">ܒܓܘܟܝ</w> <w xml:id="w475">ܢܬܦܬܚܘܢ</w> <w xml:id="w476">ܬܪ̈ܥܐ</w> <w xml:id="w477">ܕܐܪܥܟܝ</w> <w xml:id="w478">ܠܒ̈ܥܠܕܒܒܝܟܝ</w> <w xml:id="w479">ܘܬܐܟܘܠܢܘܪܐ</w> <w xml:id="w480">ܠܡܘܟ̈ܠܝܟܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w481">ܡ̈ܝܐ</w> <w xml:id="w482">ܒܐܘܠܨܢܐ</w> <w xml:id="w483">ܡܠܝ</w> <w xml:id="w484">ܠܟܝ</w> <w xml:id="w485">ܘܐܥܫܢܝ</w> <w xml:id="w486">ܟܪ̈ܟܝܟܝ</w> <w xml:id="w487">ܥܘܠܝ</w> <w xml:id="w488">ܒܣܝܢܐ</w> <w xml:id="w489">ܘܕܘܫܝ</w> <w xml:id="w490">ܒܛܝܢܐ</w> <w xml:id="w491">ܘܐܥܫܢܝܡܘܠܟܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w492">ܬܡܢ</w> <w xml:id="w493">ܬܐܟܠܟܝ</w> <w xml:id="w494">ܢܘܪܐ</w> <w xml:id="w495">ܘܬܘܒܕܟܝ</w> <w xml:id="w496">ܚܪܒܐ</w> <w xml:id="w497">ܘܬܐܟܠܟܝ</w> <w xml:id="w498">ܐܝܟ</w> <w xml:id="w499">ܙܚܠܐ</w> <w xml:id="w500">ܥܠ</w> <w xml:id="w501">ܕܥܫܢܬܝ</w> <w xml:id="w502">ܐܝܟ</w> <w xml:id="w503">ܙܚܠܐܘܣܓܝܬܝ</w> <w xml:id="w504">ܐܝܟ</w> <w xml:id="w505">ܩܡܨܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w506">ܘܐܣܓܝܬܝ</w> <w xml:id="w507">ܬܓܪ̈ܝܟܝ</w> <w xml:id="w508">ܛܒ</w> <w xml:id="w509">ܡܢ</w> <w xml:id="w510">ܟܘ̈ܟܒܝ</w> <w xml:id="w511">ܫܡܝܐ</w> <w xml:id="w512">ܙܚܠܐ</w> <w xml:id="w513">ܫܠܚ</w> <w xml:id="w514">ܘܦܪܚ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w515">ܢܙܝܪ̈ܝܟܝ</w> <w xml:id="w516">ܐܝܟ</w> <w xml:id="w517">ܩܡܨܐ</w> <w xml:id="w518">ܘܟܬܝܫ̈ܝܟܝ</w> <w xml:id="w519">ܐܝܟ</w> <w xml:id="w520">ܩܡܨܐ</w> <w xml:id="w521">ܕܣܒܝܟ</w> <w xml:id="w522">ܒܣܝܓܐ</w> <w xml:id="w523">ܒܝܘܡܐ</w> <w xml:id="w524">ܩܪܝܪܐ</w> <w xml:id="w525">ܕܡܐܕܕܢܚܬ</w> <w xml:id="w526">ܫܡܫܐ</w> <w xml:id="w527">ܡܫܩܠ</w> <w xml:id="w528">ܘܠܐ</w> <w xml:id="w529">ܡܬܝܕܥܐ</w> <w xml:id="w530">ܕܘܟܬܗ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="18">
                  <p><w xml:id="w531">ܢܡܘ</w> <w xml:id="w532">ܚܒܪ̈ܝܟܝ</w> <w xml:id="w533">ܡ̈ܠܟܐ</w> <w xml:id="w534">ܕܐܬܘܪ</w> <w xml:id="w535">ܘܫܪܘ</w> <w xml:id="w536">ܩܪ̈ܝܒܝܟܝ</w> <w xml:id="w537">ܐܬܒܕܪܘ</w> <w xml:id="w538">ܥܡܟܝ</w> <w xml:id="w539">ܥܠ</w> <w xml:id="w540">ܛܘܪ̈ܐ</w> <w xml:id="w541">ܘܠܝܬ</w> <w xml:id="w542">ܠܗܘܢܡܟܢܫܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w543">ܠܝܬ</w> <w xml:id="w544">ܕܟܐܒ</w> <w xml:id="w545">ܠܗ</w> <w xml:id="w546">ܥܠ</w> <w xml:id="w547">ܬܒܪܟܝ</w> <w xml:id="w548">ܟܝܒܐ</w> <w xml:id="w549">ܗܝ</w> <w xml:id="w550">ܡܚܘܬܟܝ</w> <w xml:id="w551">ܟܠ</w> <w xml:id="w552">ܕܫܡܥܘ</w> <w xml:id="w553">ܫܡܥܟܝ</w> <w xml:id="w554">ܢܩܫܘ</w> <w xml:id="w555">ܟܦܐ</w> <w xml:id="w556">ܥܠܝܟܝ</w> <w xml:id="w557">ܡܛܠܕܥܠ</w> <w xml:id="w558">ܟܘܠ</w> <w xml:id="w559">ܐܢܫ</w> <w xml:id="w560">ܐܡܝܢܐܝܬ</w> <w xml:id="w561">ܥܒܪܬ</w> <w xml:id="w562">ܒܝܫܬܟܝ</w></p>
               </div>
            </div>
         </div>
