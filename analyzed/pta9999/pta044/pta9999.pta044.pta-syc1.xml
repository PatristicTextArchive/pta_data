               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w176">ܘܠܐ</w> <w xml:id="w177">ܬܩܘܡ</w> <w xml:id="w178">ܥܠ</w> <w xml:id="w179">ܡܩܒܬܐ</w> <w xml:id="w180">ܠܡܘܒܕܘ</w> <w xml:id="w181">ܠܡܫ̈ܘܙܒܘܗܝ</w> <w xml:id="w182">ܘܠܐ</w> <w xml:id="w183">ܬܫܠܡ</w> <w xml:id="w184">ܣܪ̈ܝܕܘܗܝ</w> <w xml:id="w185">ܒܝܘܡܐ</w> <w xml:id="w186">ܕܐܘܠܨܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w187">ܡܛܠ</w> <w xml:id="w188">ܕܩܪܝܒ</w> <w xml:id="w189">ܗܘ</w> <w xml:id="w190">ܝܘܡܗ</w> <w xml:id="w191">ܕܡܪܝܐ</w> <w xml:id="w192">ܥܠ</w> <w xml:id="w193">ܟܠܗܘܢ</w> <w xml:id="w194">ܥܡ̈ܡܐ</w> <w xml:id="w195">ܐܝܟ</w> <w xml:id="w196">ܕܥܒܕܬ</w> <w xml:id="w197">ܗܟܢܐ</w> <w xml:id="w198">ܢܬܥܒܕ</w> <w xml:id="w199">ܠܟܘܦܘܪܥܢܟ</w> <w xml:id="w200">ܢܗܦܘܟ</w> <w xml:id="w201">ܥܠ</w> <w xml:id="w202">ܪܝܫܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w203">ܡܛܠ</w> <w xml:id="w204">ܕܐܝܟܢܐ</w> <w xml:id="w205">ܕܐܫܬܝܬܘܢ</w> <w xml:id="w206">ܥܠ</w> <w xml:id="w207">ܛܘܪܐ</w> <w xml:id="w208">ܕܩܘܕܫܝ</w> <w xml:id="w209">ܢܫܬܘܢ</w> <w xml:id="w210">ܟܠܗܘܢ</w> <w xml:id="w211">ܥܡ̈ܡܐ</w> <w xml:id="w212">ܐܡܝܢܐܝܬ</w> <w xml:id="w213">ܢܫܬܘܢܘܢܬܘܪܘܢ</w> <w xml:id="w214">ܘܢܬܛܪܦܘܢ</w> <w xml:id="w215">ܘܢܗܘܘܢ</w> <w xml:id="w216">ܐܝܟ</w> <w xml:id="w217">ܕܠܐ</w> <w xml:id="w218">ܗܘܘ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w219">ܘܒܛܘܪܐ</w> <w xml:id="w220">ܕܨܗܝܘܢ</w> <w xml:id="w221">ܬܗܘܐ</w> <w xml:id="w222">ܡܫܘܙܒܘܬܐ</w> <w xml:id="w223">ܘܢܗܘܐ</w> <w xml:id="w224">ܩܕܝܫ</w> <w xml:id="w225">ܘܢܐܪܬܘܢ</w> <w xml:id="w226">ܕܒܝܬ</w> <w xml:id="w227">ܝܥܩܘܒ</w> <w xml:id="w228">ܠܐܝܠܝܢܕܝܪܬܘ</w> <w xml:id="w229">ܐܢܘܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="18">
                  <p><w xml:id="w230">ܘܢܗܘܐ</w> <w xml:id="w231">ܒܝܬ</w> <w xml:id="w232">ܝܥܩܘܒ</w> <w xml:id="w233">ܢܘܪܐ</w> <w xml:id="w234">ܘܒܝܬ</w> <w xml:id="w235">ܝܘܣܦ</w> <w xml:id="w236">ܫܠܗܒܝܬܐ</w> <w xml:id="w237">ܘܒܝܬ</w> <w xml:id="w238">ܥܣܘ</w> <w xml:id="w239">ܚܒܬܐ</w> <w xml:id="w240">ܘܢܐܩܕܘܢ</w> <w xml:id="w241">ܒܗܘܢܘܢܐܟܠܘܢ</w> <w xml:id="w242">ܐܢܘܢ</w> <w xml:id="w243">ܘܠܐ</w> <w xml:id="w244">ܢܗܘܐ</w> <w xml:id="w245">ܣܪܝܕܐ</w> <w xml:id="w246">ܠܒܝܬܐ</w> <w xml:id="w247">ܕܥܣܘ</w> <w xml:id="w248">ܡܛܠ</w> <w xml:id="w249">ܕܡܪܝܐ</w> <w xml:id="w250">ܡܠܠ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w251">ܘܢܐܪܬܘܢ</w> <w xml:id="w252">ܕܬܝܡܢܐ</w> <w xml:id="w253">ܠܛܘܪܐ</w> <w xml:id="w254">ܕܥܣܘ</w> <w xml:id="w255">ܘܕܦܩܥܬܐ</w> <w xml:id="w256">ܠܦ̈ܠܫܬܝܐ</w> <w xml:id="w257">ܘܢܐܪܬܘܢ</w> <w xml:id="w258">ܚܩܠܐ</w> <w xml:id="w259">ܕܐܦܪܝܡ</w> <w xml:id="w260">ܘܚܩܠܐܕܫܡܪܝܢ</w> <w xml:id="w261">ܘܒܢܝܡܝܢ</w> <w xml:id="w262">ܠܓܠܥܕ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="20">
                  <p><w xml:id="w263">ܘܫܒܝܬܐ</w> <w xml:id="w264">ܩܕܡܝܬܐ</w> <w xml:id="w265">ܗܕܐ</w> <w xml:id="w266">ܠܒܢ̈ܝ</w> <w xml:id="w267">ܐܝܣܪܝܠ</w> <w xml:id="w268">ܕܡܢ</w> <w xml:id="w269">ܟܢܥܢ</w> <w xml:id="w270">ܘܥܕܡܐ</w> <w xml:id="w271">ܠܨܪܦܬ</w> <w xml:id="w272">ܘܫܒܝܬܐ</w> <w xml:id="w273">ܕܐܘܪܫܠܡܕܒܐܣܦܢܝܐ</w> <w xml:id="w274">ܢܐܪܬܘܢ</w> <w xml:id="w275">ܠܡܕܝ̈ܢܬܐ</w> <w xml:id="w276">ܕܬܝܡܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="21">
                  <p><w xml:id="w277">ܘܢܣܩܘܢ</w> <w xml:id="w278">ܦܪ̈ܝܩܐ</w> <w xml:id="w279">ܠܛܘܪܐ</w> <w xml:id="w280">ܕܨܗܝܘܢ</w> <w xml:id="w281">ܠܡܕܢ</w> <w xml:id="w282">ܠܛܘܪܐ</w> <w xml:id="w283">ܕܥܣܘ</w> <w xml:id="w284">ܘܬܗܘܐ</w> <w xml:id="w285">ܡܠܟܘܬܐ</w> <w xml:id="w286">ܕܡܪܝܐ</w></p>
               </div>
            </div>
         </div>
      </body>
