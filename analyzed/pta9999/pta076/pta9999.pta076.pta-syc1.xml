      <body>
         <div type="edition"
              xml:lang="syc"
              n="urn:cts:pta:pta9999.pta076.pta-syc1">
            <head>
               <title><w xml:id="w1">ܐܓܪܬܐ</w> <w xml:id="w2">ܕܦܘܠܘܣ</w> <w xml:id="w3">ܕܠܘܬ</w> <w xml:id="w4">ܬܣܠ̈ܘܢܝܩܝܐ</w> <w xml:id="w5">ܕܬܪܬܝܢ</w></title>
            </head>
            <div type="textpart" subtype="chapter" n="1">
               <milestone unit="SyrChapter" n="1"/>
               <div type="textpart" subtype="verse" n="1">
                  <p><w xml:id="w6">ܦ݁ܰܘܠܳܘܣ</w> <w xml:id="w7">ܘܣܺܠܘܰܢܳܘܣ</w> <w xml:id="w8">ܘܛܺܝܡܳܬ݂ܶܐܳܘܣ</w> <w xml:id="w9">܆</w> <w xml:id="w10">ܠܥܺܕ̱݁ܬ݁ܳܐ</w>
                    <w xml:id="w11">ܕ݁ܬ݂ܶܣܰܠܳܘܢܺܝܩܳܝܶܐ̈</w> <w xml:id="w12">ܕ݁ܒ݂ܰܐܠܳܗܳܐ</w> <w xml:id="w13">ܐܰܒ݂ܽܘܢ</w> <w xml:id="w14">܁</w> <w xml:id="w15">ܘܡܳܪܰܢ</w> <w xml:id="w16">ܝܶܫܽܘܥ</w> <w xml:id="w17">ܡܫܺܝܚܳܐ</w> <w xml:id="w18">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="2">
                  <p><w xml:id="w19">ܛܰܝܒ݁ܽܘܬ݂ܳܐ</w> <w xml:id="w20">ܥܰܡܟ݂ܽܘܢ</w> <w xml:id="w21">ܘܰܫܠܳܡܳܐ</w> <w xml:id="w22">܆</w> <w xml:id="w23">ܡܶܢ</w> <w xml:id="w24">ܐܰܠܳܗܳܐ</w> <w xml:id="w25">ܐܰܒ݂ܽܘܢ</w> <w xml:id="w26">܁</w> <w xml:id="w27">ܘܡܶܢ</w>
                    <w xml:id="w28">ܡܳܪܰܢ</w> <w xml:id="w29">ܝܶܫܽܘܥ</w> <w xml:id="w30">ܡܫܺܝܚܳܐ</w> <w xml:id="w31">܀</w></p>
               </div>
               <div type="textpart" subtype="verse" n="3">
                  <p><w xml:id="w32">ܠܡܰܘܕ݁ܳܝܽܘ</w> <w xml:id="w33">ܠܰܐܠܳܗܳܐ</w> <w xml:id="w34">ܒ݁ܟ݂ܽܠܙܒ݂ܰܢ</w> <w xml:id="w35">ܚܰܝܳܒ݂ܺܝܢܰܢ</w> <w xml:id="w36">ܥܠܰܝܟ݁ܽܘܢ</w> <w xml:id="w37">ܐܰܚܰܝ̈</w>
                    <w xml:id="w38">܆</w> <w xml:id="w39">ܐܰܝܟ݂</w> <w xml:id="w40">ܡܳܐ</w> <w xml:id="w41">ܕ݁ܘܳܠܶܐ</w> <w xml:id="w42">܂</w> <w xml:id="w43">ܕ݁ܝܰܬ݁ܺܝܪܳܐܝܺܬ݂</w> <w xml:id="w44">ܪܳܒ݂ܝܳܐ</w> <w xml:id="w45">ܗܰܝܡܳܢܽܘܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w46">.</w> <w xml:id="w47">ܘܣܳܓ݂ܶܐ</w> <w xml:id="w48">ܚܽܘܒ݁ܳܐ</w>
                    <w xml:id="w49">ܕ݁ܟ݂ܽܠܟ݂ܽܘܢ</w> <w xml:id="w50">܇</w> <w xml:id="w51">ܕ݁ܟ݂ܽܠܢܳܫ</w> <w xml:id="w52">ܠܘܳܬ݂</w> <w xml:id="w53">ܚܰܒ݂ܪܶܗ</w> <w xml:id="w54">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w55">ܐܰܝܟ݂</w> <w xml:id="w56">ܕ݁ܳܐܦ݂</w> <w xml:id="w57">ܚܢܰܢ</w> <w xml:id="w58">ܒ݁ܟ݂ܽܘܢ</w> <w xml:id="w59">ܢܶܗܘܶܐ</w> <w xml:id="w60">ܡܶܫܬ݁ܰܒ݂ܗܪܺܝܢ</w> <w xml:id="w61">ܚ̱ܢܰܢ</w>
                    <w xml:id="w62">ܒ݁ܥܺܕ݂ܳܬ݂ܳܐ̈</w> <w xml:id="w63">ܕ݁ܰܐܠܳܗܳܐ</w> <w xml:id="w64">܇</w> <w xml:id="w65">ܥܰܠ</w> <w xml:id="w66">ܗܰܝܡܳܢܽܘܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w67">ܘܥܰܠ</w> <w xml:id="w68">ܡܣܰܝܒ݁ܪܳܢܽܘܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w69">܇</w>
                    <w xml:id="w70">ܕ݁ܰܒ݂ܟ݂ܽܠܳܗ</w> <w xml:id="w71">ܪܕ݂ܺܝܦ݂ܽܘܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w72">ܘܽܐܘܠܨܳܢܰܝܟ݁ܽܘܢ̈</w> <w xml:id="w73">ܕ݁ܰܡܣܰܝܒ݁ܪܺܝܢ</w> <w xml:id="w74">ܐܢ̱ܬ݁ܽܘܢ</w> <w xml:id="w75">܇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
                  <p><w xml:id="w76">ܠܬ݂ܰܚܘܺܝܬ݂ܳܐ</w> <w xml:id="w77">ܕ݁ܕ݂ܺܝܢܳܐ</w> <w xml:id="w78">ܟ݁ܺܐܢܳܐ</w> <w xml:id="w79">ܕ݁ܰܐܠܳܗܳܐ</w> <w xml:id="w80">܆</w> <w xml:id="w81">ܕ݁ܬ݂ܶܫܘܽܘܢ</w>
                    <w xml:id="w82">ܠܡܰܠܟ݁ܽܘܬ݂ܶܗ</w> <w xml:id="w83">ܗܳܝ</w> <w xml:id="w84">ܕ݁ܥܰܠ</w> <w xml:id="w85">ܐܰܦ݁ܶܝܗ̈</w> <w xml:id="w86">ܚܳܫܺܝܬ݁ܽܘܢ</w> <w xml:id="w87">܇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w88">ܘܶܐܢ</w> <w xml:id="w89">ܟ݁ܺܐܢܳܐ</w> <w xml:id="w90">ܩܕ݂ܳܡ</w> <w xml:id="w91">ܐܰܠܳܗܳܐ</w> <w xml:id="w92">܆</w> <w xml:id="w93">ܕ݁ܢܶܦ݂ܪܽܘܥ</w> <w xml:id="w94">ܐܽܘܠܨܳܢܳܐ</w>
                    <w xml:id="w95">ܠܳܐܠܽܘܨܰܝܟ݁ܽܘܢ̈</w> <w xml:id="w96">܇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w97">ܘܰܠܟ݂ܽܘܢ</w> <w xml:id="w98">ܕ݁ܡܶܬ݂ܰܐܠܨܺܝܬ݁ܽܘܢ</w> <w xml:id="w99">ܢܰܚܶܐ</w> <w xml:id="w100">ܥܰܡܰܢ</w> <w xml:id="w101">܇</w> <w xml:id="w102">ܒ݁ܓ݂ܶܠܝܳܢܶܗ</w> <w xml:id="w103">ܕ݁ܡܳܪܰܢ</w>
                    <w xml:id="w104">ܝܶܫܽܘܥ</w> <w xml:id="w105">ܡܫܺܝܚܳܐ</w> <w xml:id="w106">ܕ݁ܡܶܢ</w> <w xml:id="w107">ܫܡܰܝܳܐ</w> <w xml:id="w108">܁</w> <w xml:id="w109">ܥܰܡ</w> <w xml:id="w110">ܚܰܝܠܳܐ</w> <w xml:id="w111">ܕ݁ܡܰܠܰܐܟ݂ܰܘܗ̱ܝ̈</w> <w xml:id="w112">܇</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w113">ܡܳܐ</w> <w xml:id="w114">ܕ݁ܥܳܒ݂ܶܕ݂</w> <w xml:id="w115">ܬ݁ܒ݂ܰܥܬ݂ܳܐ</w> <w xml:id="w116">ܒ݁ܓ݂ܽܘܙܳܠܳܐ</w> <w xml:id="w117">ܕ݁ܢܽܘܪܳܐ</w> <w xml:id="w118">܁</w> <w xml:id="w119">ܡܶܢ</w> <w xml:id="w120">ܗܳܢܽܘܢ</w>
                    <w xml:id="w121">ܕ݁ܠܳܐ</w> <w xml:id="w122">ܝܺܕ݂ܰܥܘ</w> <w xml:id="w123">ܠܰܐܠܳܗܳܐ</w> <w xml:id="w124">܇</w> <w xml:id="w125">ܘܡܶܢ</w> <w xml:id="w126">ܗܳܢܽܘܢ</w> <w xml:id="w127">ܕ݁ܠܳܐ</w> <w xml:id="w128">ܐܶܫܬ݁ܰܘܕ݁ܰܥܘ</w> <w xml:id="w129">ܠܰܣܒ݂ܰܪܬ݂ܶܗ</w> <w xml:id="w130">ܕ݁ܡܳܪܰܢ</w>
                    <w xml:id="w131">ܝܶܫܽܘܥ</w> <w xml:id="w132">ܡܫܺܝܚܳܐ</w> <w xml:id="w133">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w134">ܕ݁ܗܶܢܽܘܢ</w> <w xml:id="w135">ܒ݁ܕ݂ܺܝܢܳܐ</w> <w xml:id="w136">ܢܶܬ݂ܦ݁ܰܪܥܽܘܢ</w> <w xml:id="w137">ܐܰܒ݂ܕ݁ܳܢܳܐ</w> <w xml:id="w138">ܕ݁ܰܠܥܳܠܰܡ</w> <w xml:id="w139">܁</w> <w xml:id="w140">ܡܶܢ</w>
                    <w xml:id="w141">ܦ݁ܰܪܨܽܘܦ݁ܶܗ</w> <w xml:id="w142">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w143">.</w> <w xml:id="w144">ܘܡܶܢ</w> <w xml:id="w145">ܫܽܘܒ݂ܚܳܐ</w> <w xml:id="w146">ܕ݁ܚܰܝܠܶܗ</w> <w xml:id="w147">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w148">ܡܳܐ</w> <w xml:id="w149">ܕ݁ܳܐܬ݂ܶܐ</w> <w xml:id="w150">ܕ݁ܢܶܫܬ݁ܰܒ݁ܰܚ</w> <w xml:id="w151">ܒ݁ܩܰܕ݁ܺܝܫܰܘܗ̱ܝ̈</w> <w xml:id="w152">܇</w> <w xml:id="w153">ܘܰܢܚܰܘܶܐ</w>
                    <w xml:id="w154">ܬ݁ܶܕ݂ܡܪܳܬ݂ܶܗ̈</w> <w xml:id="w155">ܒ݁ܰܡܗܰܝܡܢܰܘܗ̱ܝ̈</w> <w xml:id="w156">܇</w> <w xml:id="w157">ܕ݁ܬ݂ܶܬ݂ܗܰܝܡܰܢ</w> <w xml:id="w158">ܣܳܗܕ݁ܽܘܬ݂ܰܢ</w> <w xml:id="w159">ܕ݁ܰܥܠܰܝܟ݁ܽܘܢ</w> <w xml:id="w160">ܒ݁ܗܰܘ</w>
                    <w xml:id="w161">ܝܰܘܡܳܐ</w> <w xml:id="w162">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w163">ܡܶܛܽܠܗܳܢܳܐ</w> <w xml:id="w164">ܒ݁ܟ݂ܽܠܙܒ݂ܰܢ</w> <w xml:id="w165">ܡܨܰܠܶܝܢܰܢ</w> <w xml:id="w166">ܥܠܰܝܟ݁ܽܘܢ</w> <w xml:id="w167">܆</w> <w xml:id="w168">ܕ݁ܢܰܫܘܶܝܟ݂ܽܘܢ</w>
                    <w xml:id="w169">ܐܰܠܳܗܳܐ</w> <w xml:id="w170">ܠܩܶܪܝܳܢܟ݂ܽܘܢ</w> <w xml:id="w171">.</w> <w xml:id="w172">ܘܢܶܡܠܶܝܟ݂ܽܘܢ</w> <w xml:id="w173">ܟ݁ܽܠܶܗ</w> <w xml:id="w174">ܨܶܒ݂ܝܳܢܳܐ</w> <w xml:id="w175">ܕ݁ܛܳܒ݂ܳܬ݂ܳܐ̈</w> <w xml:id="w176">.</w> <w xml:id="w177">ܘܰܥܒ݂ܳܕ݂ܶܐ̈</w>
                    <w xml:id="w178">ܕ݁ܗܰܝܡܳܢܽܘܬ݂ܳܐ</w> <w xml:id="w179">ܒ݁ܚܰܝܠܳܐ</w> <w xml:id="w180">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w181">ܕ݁ܢܶܫܬ݁ܰܒ݁ܰܚ</w> <w xml:id="w182">ܒ݁ܟ݂ܽܘܢ</w> <w xml:id="w183">ܫܡܶܗ</w> <w xml:id="w184">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w185">ܝܶܫܽܘܥ</w> <w xml:id="w186">ܡܫܺܝܚܳܐ</w> <w xml:id="w187">.</w> <w xml:id="w188">ܐܳܦ݂</w>
                    <w xml:id="w189">ܐܰܢ̱ܬ݁ܽܘܢ</w> <w xml:id="w190">ܒ݁ܶܗ</w> <w xml:id="w191">܇</w> <w xml:id="w192">ܐܰܝܟ݂</w> <w xml:id="w193">ܛܰܝܒ݁ܽܘܬ݂ܶܗ</w> <w xml:id="w194">ܕ݁ܰܐܠܳܗܰܢ</w> <w xml:id="w195">ܘܡܳܪܰܢ</w> <w xml:id="w196">ܝܶܫܽܘܥ</w> <w xml:id="w197">ܡܫܺܝܚܳܐ</w> <w xml:id="w198">܀</w></p>
               </div>
            </div>
            <div type="textpart" subtype="chapter" n="2">
               <div type="textpart" subtype="verse" n="1">
                  <p><w xml:id="w199">ܒ݁ܳܥܶܝܢܰܢ</w> <w xml:id="w200">ܕ݁ܶܝܢ</w> <w xml:id="w201">ܡܶܢܟ݂ܽܘܢ</w> <w xml:id="w202">ܐܰܚܰܝ̈</w> <w xml:id="w203">܆</w> <w xml:id="w204">ܥܰܠ</w> <w xml:id="w205">ܡܶܐܬ݂ܺܝܬ݂ܶܗ</w> <w xml:id="w206">ܕ݁ܡܳܪܰܢ</w>
                    <w xml:id="w207">ܝܶܫܽܘܥ</w> <w xml:id="w208">ܡܫܺܝܚܳܐ</w> <w xml:id="w209">܇</w> <w xml:id="w210">ܘܥܰܠ</w> <w xml:id="w211">ܟ݁ܢܽܘܫܝܳܐ</w> <w xml:id="w212">ܕ݁ܺܝܠܰܢ</w> <w xml:id="w213">ܕ݁ܰܠܘܳܬ݂ܶܗ</w> <w xml:id="w214">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="2">
                  <p><w xml:id="w215">ܕ݁ܠܳܐ</w> <w xml:id="w216">ܥܓ݂ܰܠ</w> <w xml:id="w217">ܬ݁ܶܬ݁ܙܺܝܥܽܘܢ</w> <w xml:id="w218">ܒ݁ܪܶܥܝܳܢܰܝܟ݁ܽܘܢ̈</w> <w xml:id="w219">.</w> <w xml:id="w220">ܘܠܳܐ</w> <w xml:id="w221">ܬ݁ܶܬ݂ܘܗܽܘܢ</w>
                    <w xml:id="w222">ܠܳܐ</w> <w xml:id="w223">ܡܶܢ</w> <w xml:id="w224">ܡܶܠܬ݂ܳܐ</w> <w xml:id="w225">.</w> <w xml:id="w226">ܘܠܳܐ</w> <w xml:id="w227">ܡܶܢ</w> <w xml:id="w228">ܪܽܘܚܳܐ</w> <w xml:id="w229">.</w> <w xml:id="w230">ܘܠܳܐ</w> <w xml:id="w231">ܡܶܢ</w> <w xml:id="w232">ܐܶܓ݁ܰܪܬ݁ܳܐ</w> <w xml:id="w233">܁</w> <w xml:id="w234">ܕ݁ܰܐܝܟ݂</w> <w xml:id="w235">ܕ݁ܡܶܢ</w> <w xml:id="w236">ܠܘܳܬ݂ܰܢ</w>
                    <w xml:id="w237">ܗ̱ܺܝ</w> <w xml:id="w238">܇</w> <w xml:id="w239">ܕ݁ܗܳܐ</w> <w xml:id="w240">ܠܰܡ</w> <w xml:id="w241">ܡܰܛܺܝ</w> <w xml:id="w242">ܝܰܘܡܶܗ</w> <w xml:id="w243">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w244">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="3">
                  <p><w xml:id="w245">ܠܡܳܐ</w> <w xml:id="w246">ܐ̱ܢܳܫ</w> <w xml:id="w247">ܢܰܛܥܶܝܟ݂ܽܘܢ</w> <w xml:id="w248">ܒ݁ܚܰܕ݂</w> <w xml:id="w249">ܡܶܢ</w> <w xml:id="w250">ܐܶܣܟ݁ܺܡܺܝܢ̈</w> <w xml:id="w251">܆</w> <w xml:id="w252">ܡܶܛܽܠ</w> <w xml:id="w253">ܕ݁ܶܐܢ</w>
                    <w xml:id="w254">ܠܳܐ</w> <w xml:id="w255">ܬ݁ܺܐܬ݂ܶܐ</w> <w xml:id="w256">ܠܽܘܩܕ݂ܰܡ</w> <w xml:id="w257">ܡܳܪܽܘܕ݂ܽܘܬ݂ܳܐ</w> <w xml:id="w258">.</w> <w xml:id="w259">ܘܢܶܬ݂ܓ݁ܠܶܐ</w> <w xml:id="w260">ܒ݁ܰܪܢܳܫܳܐ</w> <w xml:id="w261">ܕ݁ܰܚܛܺܝܬ݂ܳܐ</w> <w xml:id="w262">܁</w> <w xml:id="w263">ܒ݁ܪܶܗ</w>
                    <w xml:id="w264">ܕ݁ܰܐܒ݂ܕ݁ܳܢܳܐ</w> <w xml:id="w265">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w266">ܗܰܘ</w> <w xml:id="w267">ܕ݁ܰܠܩܽܘܒ݂ܠܳܐ</w> <w xml:id="w268">ܗ̱ܘ</w> <w xml:id="w269">.</w> <w xml:id="w270">ܘܡܶܫܬ݁ܰܥܠܶܐ</w> <w xml:id="w271">ܥܰܠ</w> <w xml:id="w272">ܟ݁ܽܠ</w> <w xml:id="w273">ܡܰܢ</w> <w xml:id="w274">ܕ݁ܡܶܬ݂ܩܪܶܐ</w>
                    <w xml:id="w275">ܐܰܠܳܗ</w> <w xml:id="w276">ܘܕ݂ܶܚܠܳܐ</w> <w xml:id="w277">܆</w> <w xml:id="w278">ܐܰܝܟ݁ܰܢܳܐ</w> <w xml:id="w279">ܕ݁ܳܐܦ݂</w> <w xml:id="w280">ܒ݁ܗܰܝܟ݁ܠܳܐ</w> <w xml:id="w281">ܕ݁ܰܐܠܳܗܳܐ</w> <w xml:id="w282">ܐܰܝܟ݂</w> <w xml:id="w283">ܐܰܠܳܗܳܐ</w> <w xml:id="w284">ܢܶܬ݁ܶܒ݂</w> <w xml:id="w285">܇</w>
                    <w xml:id="w286">ܘܰܢܚܰܘܶܐ</w> <w xml:id="w287">ܥܰܠ</w> <w xml:id="w288">ܢܰܦ݂ܫܶܗ</w> <w xml:id="w289">ܐܰܝܟ݂</w> <w xml:id="w290">ܕ݁ܰܐܠܳܗܳܐ</w> <w xml:id="w291">ܗܽܘ</w> <w xml:id="w292">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
                  <p><w xml:id="w293">ܠܳܐ</w> <w xml:id="w294">ܥܳܗܕ݁ܺܝܬ݁ܽܘܢ</w> <w xml:id="w295">܆</w> <w xml:id="w296">ܕ݁ܟ݂ܰܕ݂</w> <w xml:id="w297">ܠܘܳܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w298">ܗ̱ܘܺܝܬ݂</w> <w xml:id="w299">܆</w> <w xml:id="w300">ܗܳܠܶܝܢ</w>
                    <w xml:id="w301">ܐܶܡܪܶܬ݂</w> <w xml:id="w302">ܗ̱ܘܺܝܬ݂</w> <w xml:id="w303">ܠܟ݂ܽܘܢ</w> <w xml:id="w304">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w305">ܘܗܳܫܳܐ</w> <w xml:id="w306">ܝܳܕ݂ܥܺܝܢ</w> <w xml:id="w307">ܐܢ̱ܬ݁ܽܘܢ</w> <w xml:id="w308">܆</w> <w xml:id="w309">ܡܳܐ</w> <w xml:id="w310">ܕ݁ܰܐܚܺܝܕ݂</w> <w xml:id="w311">ܕ݁ܢܶܬ݂ܓ݁ܠܶܐ</w> <w xml:id="w312">ܗܽܘ</w>
                    <w xml:id="w313">ܒ݁ܙܰܒ݂ܢܶܗ</w> <w xml:id="w314">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w315">ܐ̱ܪܳܙܳܐ</w> <w xml:id="w316">ܓ݁ܶܝܪ</w> <w xml:id="w317">ܕ݁ܥܰܘܠܳܐ</w> <w xml:id="w318">ܡܶܢ</w> <w xml:id="w319">ܟ݁ܰܕ݁ܽܘ</w> <w xml:id="w320">ܫܰܪܺܝ</w> <w xml:id="w321">ܠܡܶܬ݂ܚܰܦ݁ܳܛܽܘ</w> <w xml:id="w322">܆</w>
                    <w xml:id="w323">ܒ݁ܰܠܚܽܘܕ݂</w> <w xml:id="w324">ܐܶܢ</w> <w xml:id="w325">ܗܰܘ</w> <w xml:id="w326">ܡܳܐ</w> <w xml:id="w327">ܕ݁ܗܳܫܳܐ</w> <w xml:id="w328">ܐܰܚܺܝܕ݂</w> <w xml:id="w329">ܢܶܫܬ݁ܩܶܠ</w> <w xml:id="w330">ܡܶܢ</w> <w xml:id="w331">ܡܨܰܥܬ݂ܳܐ</w> <w xml:id="w332">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w333">ܘܗܳܝܕ݁ܶܝܢ</w> <w xml:id="w334">ܢܶܬ݂ܓ݁ܠܶܐ</w> <w xml:id="w335">ܥܰܘܳܠܳܐ</w> <w xml:id="w336">.</w> <w xml:id="w337">ܗܰܘ</w> <w xml:id="w338">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w339">ܝܶܫܽܘܥ</w> <w xml:id="w340">ܢܣܺܝܦ݂ܺܝܘܗ̱ܝ</w>
                    <w xml:id="w341">ܒ݁ܪܽܘܚ</w> <w xml:id="w342">ܦ݁ܽܘܡܶܗ</w> <w xml:id="w343">܇</w> <w xml:id="w344">ܘܰܢܒ݂ܰܛܠܺܝܘܗ̱ܝ</w> <w xml:id="w345">ܒ݁ܓ݂ܶܠܝܳܢܳܐ</w> <w xml:id="w346">ܕ݁ܡܶܐܬ݂ܺܝܬ݂ܶܗ</w> <w xml:id="w347">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w348">ܡܶܐܬ݂ܺܝܬ݂ܶܗ</w> <w xml:id="w349">ܓ݁ܶܝܪ</w> <w xml:id="w350">ܕ݁ܗܰܘ</w> <w xml:id="w351">ܒ݁ܡܰܥܒ݁ܕ݂ܳܢܽܘܬ݂ܳܐ</w> <w xml:id="w352">ܗ̱ܝ</w> <w xml:id="w353">ܕ݁ܣܳܛܳܢܳܐ</w> <w xml:id="w354">܆</w>
                    <w xml:id="w355">ܒ݁ܟ݂ܽܠ</w> <w xml:id="w356">ܚܺܝܠ</w> <w xml:id="w357">.</w> <w xml:id="w358">ܘܳܐܬ݂ܘܳܬ݂ܳܐ̈</w> <w xml:id="w359">.</w> <w xml:id="w360">ܘܬ݂ܶܕ݂ܡܪܳܬ݂ܳܐ̈</w> <w xml:id="w361">ܕ݁ܰܓ݁ܳܠܳܬ݂ܳܐ̈</w> <w xml:id="w362">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w363">ܘܰܒ݂ܟ݂ܽܠܳܗ</w> <w xml:id="w364">ܛܽܘܥܝܰܝ</w> <w xml:id="w365">ܕ݁ܥܰܘܠܳܐ</w> <w xml:id="w366">ܕ݁ܗܳܘܝܳܐ</w> <w xml:id="w367">ܒ݁ܰܐܒ݂ܺܝܕ݂ܶܐ̈</w> <w xml:id="w368">܇</w> <w xml:id="w369">ܥܰܠ</w>
                    <w xml:id="w370">ܕ݁ܠܳܐ</w> <w xml:id="w371">ܩܰܒ݁ܶܠܘ</w> <w xml:id="w372">ܚܽܘܒ݁ܳܐ</w> <w xml:id="w373">ܕ݁ܩܽܘܫܬ݁ܳܐ</w> <w xml:id="w374">܁</w> <w xml:id="w375">ܕ݁ܒ݂ܶܗ</w> <w xml:id="w376">ܢܺܚܽܘܢ</w> <w xml:id="w377">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w378">ܡܶܛܽܠܗܳܢܳܐ</w> <w xml:id="w379">ܢܫܰܕ݁ܰܪ</w> <w xml:id="w380">ܠܗܽܘܢ</w> <w xml:id="w381">ܐܰܠܳܗܳܐ</w> <w xml:id="w382">ܡܰܥܒ݁ܕ݂ܳܢܽܘܬ݂ܳܐ</w> <w xml:id="w383">ܕ݁ܛܽܘܥܝܰܝ</w> <w xml:id="w384">܆</w>
                    <w xml:id="w385">ܕ݁ܰܢܗܰܝܡܢܽܘܢ</w> <w xml:id="w386">ܠܫܽܘܩܪܳܐ</w> <w xml:id="w387">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w388">ܘܢܶܬ݁ܕ݂ܺܝܢܽܘܢ</w> <w xml:id="w389">ܟ݁ܽܠܗܽܘܢ</w> <w xml:id="w390">ܐܰܝܠܶܝܢ</w> <w xml:id="w391">ܕ݁ܠܳܐ</w> <w xml:id="w392">ܗܰܝܡܶܢܘ</w> <w xml:id="w393">ܒ݁ܩܽܘܫܬ݁ܳܐ</w> <w xml:id="w394">܇</w>
                    <w xml:id="w395">ܐܶܠܳܐ</w> <w xml:id="w396">ܐܶܨܛܒ݂ܺܝܘ</w> <w xml:id="w397">ܒ݁ܥܰܘܠܳܐ</w> <w xml:id="w398">܀</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w399">ܚܢܰܢ</w> <w xml:id="w400">ܕ݁ܶܝܢ</w> <w xml:id="w401">ܚܰܝܳܒ݂ܺܝܢܰܢ</w> <w xml:id="w402">ܠܡܰܘܕ݁ܳܝܽܘ</w> <w xml:id="w403">ܠܰܐܠܳܗܳܐ</w> <w xml:id="w404">ܒ݁ܟ݂ܽܠܙܒ݂ܰܢ</w> <w xml:id="w405">:</w> <w xml:id="w406">ܥܰܠ</w>
                    <w xml:id="w407">ܐܰܦ݁ܰܝܟ݁ܽܘܢ̈</w> <w xml:id="w408">ܐܰܚܰܝܢ̈</w> <w xml:id="w409">ܚܰܒ݁ܺܝܒ݂ܰܘܗ̱ܝ̈</w> <w xml:id="w410">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w411">܆</w> <w xml:id="w412">ܕ݁ܰܓ݂ܒ݂ܳܟ݂ܽܘܢ</w> <w xml:id="w413">ܐܰܠܳܗܳܐ</w> <w xml:id="w414">ܡܶܢ</w>
                    <w xml:id="w415">ܪܺܫܺܝܬ݂ܳܐ</w> <w xml:id="w416">ܠܚܰܝܶܐ̈</w> <w xml:id="w417">܇</w> <w xml:id="w418">ܒ݁ܩܰܕ݁ܺܝܫܽܘܬ݂ܳܐ</w> <w xml:id="w419">ܕ݁ܪܽܘܚܳܐ</w> <w xml:id="w420">ܘܰܒ݂ܗܰܝܡܳܢܽܘܬ݂ܳܐ</w> <w xml:id="w421">ܕ݁ܰܫܪܳܪܳܐ</w> <w xml:id="w422">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w423">ܠܗܳܠܶܝܢ</w> <w xml:id="w424">ܗ̱ܽܘ</w> <w xml:id="w425">ܓ݁ܶܝܪ</w> <w xml:id="w426">ܩܪܳܟ݂ܽܘܢ</w> <w xml:id="w427">ܒ݁ܰܡܣܰܒ݁ܪܳܢܽܘܬ݂ܳܐ</w> <w xml:id="w428">ܕ݁ܺܝܠܰܢ</w> <w xml:id="w429">܆</w>
                    <w xml:id="w430">ܕ݁ܬ݂ܶܗܘܽܘܢ</w> <w xml:id="w431">ܬ݁ܶܫܒ݁ܽܘܚܬ݁ܳܐ</w> <w xml:id="w432">ܠܡܳܪܰܢ</w> <w xml:id="w433">ܝܶܫܽܘܥ</w> <w xml:id="w434">ܡܫܺܝܚܳܐ</w> <w xml:id="w435">܀</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w436">ܡܶܟ݁ܺܝܠ</w> <w xml:id="w437">ܐܰܚܰܝ̈</w> <w xml:id="w438">܁</w> <w xml:id="w439">ܐܶܬ݂ܩܰܝ̱ܡܘ</w> <w xml:id="w440">ܘܚܰܡܣܶܢܘ</w> <w xml:id="w441">ܒ݁ܦ݂ܽܘܩܕ݁ܳܢܶܐ̈</w>
                    <w xml:id="w442">ܕ݁ܺܝܠܶܦ݂ܬ݁ܽܘܢ</w> <w xml:id="w443">܇</w> <w xml:id="w444">ܐܶܢ</w> <w xml:id="w445">ܒ݁ܡܶܠܬ݂ܳܐ</w> <w xml:id="w446">ܘܶܐܢ</w> <w xml:id="w447">ܒ݁ܶܐܓ݁ܰܪܬ݁ܳܐ</w> <w xml:id="w448">ܕ݁ܺܝܠܰܢ</w> <w xml:id="w449">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w450">ܗܽܘ</w> <w xml:id="w451">ܕ݁ܶܝܢ</w> <w xml:id="w452">ܡܳܪܰܢ</w> <w xml:id="w453">ܝܶܫܽܘܥ</w> <w xml:id="w454">ܡܫܺܝܚܳܐ</w> <w xml:id="w455">ܘܰܐܠܳܗܳܐ</w> <w xml:id="w456">ܐܰܒ݂ܽܘܢ</w> <w xml:id="w457">܇</w> <w xml:id="w458">ܗܰܘ</w>
                    <w xml:id="w459">ܕ݁ܰܐܚܒ݂ܰܢ</w> <w xml:id="w460">ܘܝܰܗ̱ܒ݂</w> <w xml:id="w461">ܠܰܢ</w> <w xml:id="w462">ܒ݁ܽܘܝܳܐܳܐ</w> <w xml:id="w463">ܕ݁ܰܠܥܳܠܰܡ</w> <w xml:id="w464">.</w> <w xml:id="w465">ܘܣܰܒ݂ܪܳܐ</w> <w xml:id="w466">ܛܳܒ݂ܳܐ</w> <w xml:id="w467">ܒ݁ܛܰܝܒ݁ܽܘܬ݂ܶܗ</w> <w xml:id="w468">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w469">ܢܒ݂ܰܝܰܐ</w> <w xml:id="w470">ܠܶܒ݁ܰܘܳܬ݂ܟ݂ܽܘܢ̈</w> <w xml:id="w471">܆</w> <w xml:id="w472">ܘܰܢܩܰܝܶܡ</w> <w xml:id="w473">ܒ݁ܟ݂ܽܠ</w> <w xml:id="w474">ܡܶܠܳܐ</w> <w xml:id="w475">.</w> <w xml:id="w476">ܘܰܒ݂ܟ݂ܽܠ</w>
                    <w xml:id="w477">ܥܒ݂ܳܕ݂</w> <w xml:id="w478">ܛܳܒ݂</w> <w xml:id="w479">܀</w></p>
               </div>
            </div>
            <div type="textpart" subtype="chapter" n="3">
               <div type="textpart" subtype="verse" n="1">
                  <p><w xml:id="w480">ܡܶܢ</w> <w xml:id="w481">ܗܳܫܳܐ</w> <w xml:id="w482">ܐܰܚܰܝܢ̈</w> <w xml:id="w483">܁</w> <w xml:id="w484">ܨܰܠܰܘ</w> <w xml:id="w485">ܥܠܰܝܢ</w> <w xml:id="w486">܆</w> <w xml:id="w487">ܕ݁ܡܶܠܬ݂ܶܗ</w> <w xml:id="w488">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w489">ܬ݁ܶܗܘܶܐ</w>
                    <w xml:id="w490">ܪܳܗܛܳܐ</w> <w xml:id="w491">ܘܡܶܫܬ݁ܰܒ݁ܚܳܐ</w> <w xml:id="w492">ܒ݁ܟ݂ܽܠ</w> <w xml:id="w493">ܕ݁ܽܘܟ݁ܳܐ</w> <w xml:id="w494">ܐܰܝܟ݂</w> <w xml:id="w495">ܕ݁ܰܠܘܳܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w496">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="2">
                  <p><w xml:id="w497">ܘܰܕ݂ܢܶܬ݂ܦ݁ܰܨܶܐ</w> <w xml:id="w498">ܡܶܢ</w> <w xml:id="w499">ܒ݁ܢܰܝܢܳܫܳܐ̈</w> <w xml:id="w500">ܒ݁ܺܝܫܶܐ̈</w> <w xml:id="w501">ܘܥܰܢܳܬ݂ܶܐ̈</w> <w xml:id="w502">.</w> <w xml:id="w503">ܠܰܘ</w>
                    <w xml:id="w504">ܓ݁ܶܝܪ</w> <w xml:id="w505">ܕ݁ܟ݂ܽܠܢܳܫ</w> <w xml:id="w506">ܗ̱ܺܝ</w> <w xml:id="w507">ܗܰܝܡܳܢܽܘܬ݂ܳܐ</w> <w xml:id="w508">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="3">
                  <p><w xml:id="w509">ܡܗܰܝܡܰܢ</w> <w xml:id="w510">ܗ̱ܽܘ</w> <w xml:id="w511">ܕ݁ܶܝܢ</w> <w xml:id="w512">ܡܳܪܝܳܐ</w> <w xml:id="w513">܆</w> <w xml:id="w514">ܕ݁ܗܽܘ</w> <w xml:id="w515">ܢܢܰܛܰܪܟ݂ܽܘܢ</w> <w xml:id="w516">܇</w>
                    <w xml:id="w517">ܘܰܢܫܰܘܙܶܒ݂ܟ݂ܽܘܢ</w> <w xml:id="w518">ܡܶܢ</w> <w xml:id="w519">ܒ݁ܺܝܫܳܐ</w> <w xml:id="w520">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="4">
                  <p><w xml:id="w521">ܬ݁ܟ݂ܺܝܠܺܝܢܰܢ</w> <w xml:id="w522">ܕ݁ܶܝܢ</w> <w xml:id="w523">ܥܠܰܝܟ݁ܽܘܢ</w> <w xml:id="w524">ܒ݁ܡܳܪܰܢ</w> <w xml:id="w525">܆</w> <w xml:id="w526">ܕ݁ܡܶܕ݁ܶܡ</w>
                    <w xml:id="w527">ܕ݁ܰܡܦ݂ܰܩܕ݂ܺܝܢܰܢ</w> <w xml:id="w528">ܠܟ݂ܽܘܢ</w> <w xml:id="w529">܇</w> <w xml:id="w530">ܥܒ݂ܰܕ݁ܬ݁ܽܘܢ</w> <w xml:id="w531">ܐܳܦ݂</w> <w xml:id="w532">ܥܳܒ݂ܕ݁ܺܝܬ݁ܽܘܢ</w> <w xml:id="w533">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="5">
                  <p><w xml:id="w534">ܘܡܳܪܰܢ</w> <w xml:id="w535">ܢܶܬ݂ܪܽܘܨ</w> <w xml:id="w536">ܠܶܒ݁ܰܘܳܬ݂ܟ݂ܽܘܢ̈</w> <w xml:id="w537">܆</w> <w xml:id="w538">ܠܚܽܘܒ݁ܶܗ</w> <w xml:id="w539">ܕ݁ܰܐܠܳܗܳܐ</w>
                    <w xml:id="w540">ܘܠܰܡܣܰܒ݁ܪܳܢܽܘܬ݂ܶܗ</w> <w xml:id="w541">ܕ݁ܰܡܫܺܝܚܳ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w542">ܡܦ݂ܰܩܕ݂ܺܝܢܰܢ</w> <w xml:id="w543">ܠܟ݂ܽܘܢ</w> <w xml:id="w544">ܕ݁ܶܝܢ</w> <w xml:id="w545">ܐܰܚܰܝ̈</w> <w xml:id="w546">܆</w> <w xml:id="w547">ܒ݁ܰܫܡܶܗ</w> <w xml:id="w548">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w549">ܝܶܫܽܘܥ</w>
                    <w xml:id="w550">ܡܫܺܝܚܳܐ</w> <w xml:id="w551">܆</w> <w xml:id="w552">ܕ݁ܰܗܘܰܝܬ݁ܽܘܢ</w> <w xml:id="w553">ܦ݁ܰܪܺܝܩܺܝܢ</w> <w xml:id="w554">ܡܶܢ</w> <w xml:id="w555">ܟ݁ܽܠ</w> <w xml:id="w556">ܐܰܚܳܐ</w> <w xml:id="w557">܁</w> <w xml:id="w558">ܐܰܝܢܳܐ</w> <w xml:id="w559">ܕ݁ܒ݂ܺܝܫ</w> <w xml:id="w560">ܒ݁ܺܝܫ</w> <w xml:id="w561">ܡܗܰܠܶܟ݂</w>
                    <w xml:id="w562">܇</w> <w xml:id="w563">ܘܠܳܐ</w> <w xml:id="w564">ܐܰܝܟ݂</w> <w xml:id="w565">ܦ݁ܽܘܩܕ݁ܳܢܶܐ̈</w> <w xml:id="w566">ܕ݁ܩܰܒ݁ܶܠܘ</w> <w xml:id="w567">ܡܶܢܰܢ</w> <w xml:id="w568">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w569">ܐܰܢ̱ܬ݁ܽܘܢ</w> <w xml:id="w570">ܓ݁ܶܝܪ</w> <w xml:id="w571">ܝܳܕ݂ܥܺܝܢ</w> <w xml:id="w572">ܐܢ̱ܬ݁ܽܘܢ</w> <w xml:id="w573">܆</w> <w xml:id="w574">ܐܰܝܟ݁ܰܢܳܐ</w> <w xml:id="w575">ܘܳܠܶܐ</w>
                    <w xml:id="w576">ܠܡܶܬ݁ܕ݁ܰܡܳܝܽܘ</w> <w xml:id="w577">ܒ݁ܰܢ</w> <w xml:id="w578">܇</w> <w xml:id="w579">ܕ݁ܠܳܐ</w> <w xml:id="w580">ܗܰܠܶܟ݂ܢ</w> <w xml:id="w581">ܒ݁ܺܝܫ</w> <w xml:id="w582">ܒ݁ܺܝܫ</w> <w xml:id="w583">ܒ݁ܰܝܢܳܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w584">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w585">ܐܳܦ݂ܠܳܐ</w> <w xml:id="w586">ܠܰܚܡܳܐ</w> <w xml:id="w587">ܕ݁ܡܰܓ݁ܳܢ</w> <w xml:id="w588">ܐܶܟ݂ܰܠܢ</w> <w xml:id="w589">ܡܶܢ</w> <w xml:id="w590">ܐ̱ܢܳܫ</w> <w xml:id="w591">ܡܶܢܟ݂ܽܘܢ</w> <w xml:id="w592">.</w> <w xml:id="w593">ܐܶܠܳܐ</w>
                    <w xml:id="w594">ܒ݁ܥܰܡܠܳܐ</w> <w xml:id="w595">ܘܰܒ݂ܠܶܐܘܽܬ݂ܳܐ</w> <w xml:id="w596">ܒ݁ܠܺܠܝܳܐ</w> <w xml:id="w597">ܘܒ݂ܺܐܝܡܳܡܳܐ</w> <w xml:id="w598">ܦ݁ܳܠܚܺܝܢ</w> <w xml:id="w599">ܗ̱ܘܰܝܢ</w> <w xml:id="w600">܇</w> <w xml:id="w601">ܕ݁ܥܰܠ</w> <w xml:id="w602">ܐ̱ܢܳܫ</w>
                    <w xml:id="w603">ܡܶܢܟ݂ܽܘܢ</w> <w xml:id="w604">ܠܳܐ</w> <w xml:id="w605">ܢܺܐܩܰܪ</w> <w xml:id="w606">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w607">ܠܳܐ</w> <w xml:id="w608">ܗ̱ܘܳܐ</w> <w xml:id="w609">ܡܶܛܽܠ</w> <w xml:id="w610">ܕ݁ܠܳܐ</w> <w xml:id="w611">ܫܰܠܺܝܛ</w> <w xml:id="w612">ܠܰܢ</w> <w xml:id="w613">܇</w> <w xml:id="w614">ܐܶܠܳܐ</w> <w xml:id="w615">ܕ݁ܰܒ݂ܢܰܦ݂ܫܰܢ</w> <w xml:id="w616">ܢܶܬ݁ܶܠ</w>
                    <w xml:id="w617">ܠܟ݂ܽܘܢ</w> <w xml:id="w618">ܛܽܘܦ݂ܣܳܐ</w> <w xml:id="w619">܁</w> <w xml:id="w620">ܕ݁ܒ݂ܰܢ</w> <w xml:id="w621">ܬ݁ܶܬ݁ܕ݁ܰܡܽܘܢ</w> <w xml:id="w622">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w623">ܐܳܦ݂</w> <w xml:id="w624">ܟ݁ܰܕ݂</w> <w xml:id="w625">ܠܘܳܬ݂ܟ݂ܽܘܢ</w> <w xml:id="w626">ܗ̱ܘܰܝܢ</w> <w xml:id="w627">ܓ݁ܶܝܪ</w> <w xml:id="w628">܆</w> <w xml:id="w629">ܗܳܕ݂ܶܐ</w> <w xml:id="w630">ܡܦ݂ܰܩܕ݂ܺܝܢ</w>
                    <w xml:id="w631">ܗ̱ܘܰܝܢ</w> <w xml:id="w632">ܠܟ݂ܽܘܢ</w> <w xml:id="w633">܆</w> <w xml:id="w634">ܕ݁ܟ݂ܽܠ</w> <w xml:id="w635">ܕ݁ܠܳܐ</w> <w xml:id="w636">ܨܳܒ݂ܶܐ</w> <w xml:id="w637">ܕ݁ܢܶܦ݂ܠܽܘܚ</w> <w xml:id="w638">܇</w> <w xml:id="w639">ܐܳܦ݂ܠܳܐ</w> <w xml:id="w640">ܢܶܠܥܰܣ</w> <w xml:id="w641">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w642">ܫܳܡܥܺܝܢܰܢ</w> <w xml:id="w643">ܓ݁ܶܝܪ</w> <w xml:id="w644">܆</w> <w xml:id="w645">ܕ݁ܺܐܝܬ݂</w> <w xml:id="w646">ܒ݁ܟ݂ܽܘܢ</w> <w xml:id="w647">ܐ̱ܢܳܫܳܐ</w> <w xml:id="w648">ܕ݁ܒ݂ܺܝܫ</w> <w xml:id="w649">ܒ݁ܺܝܫ</w>
                    <w xml:id="w650">ܡܗܰܠܟ݂ܺܝܢ</w> <w xml:id="w651">܇</w> <w xml:id="w652">ܘܡܶܕ݁ܶܡ</w> <w xml:id="w653">ܠܳܐ</w> <w xml:id="w654">ܦ݁ܳܠܚܺܝܢ</w> <w xml:id="w655">܁</w> <w xml:id="w656">ܐܶܠܳܐ</w> <w xml:id="w657">ܐܶܢ</w> <w xml:id="w658">ܣܪܺܝܩܳܬ݂ܳܐ̈</w> <w xml:id="w659">܆</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w660">ܠܗܽܘܢ</w> <w xml:id="w661">ܕ݁ܶܝܢ</w> <w xml:id="w662">ܠܗܳܠܶܝܢ</w> <w xml:id="w663">ܡܦ݂ܰܩܕ݂ܺܝܢܰܢ</w> <w xml:id="w664">:</w> <w xml:id="w665">ܘܒ݂ܳܥܶܝܢܰܢ</w> <w xml:id="w666">ܡܶܢܗܽܘܢ</w>
                    <w xml:id="w667">ܒ݁ܡܳܪܰܢ</w> <w xml:id="w668">ܝܶܫܽܘܥ</w> <w xml:id="w669">ܡܫܺܝܚܳܐ</w> <w xml:id="w670">܆</w> <w xml:id="w671">ܕ݁ܰܒ݂ܫܶܠܝܳܐ</w> <w xml:id="w672">ܢܶܗܘܽܘܢ</w> <w xml:id="w673">ܦ݁ܳܠܚܺܝܢ</w> <w xml:id="w674">ܘܳܐܟ݂ܠܺܝܢ</w> <w xml:id="w675">ܠܰܚܡܗܽܘܢ</w> <w xml:id="w676">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w677">ܐܢ̱ܬ݁ܽܘܢ</w> <w xml:id="w678">ܕ݁ܶܝܢ</w> <w xml:id="w679">ܐܰܚܰܝ̈</w> <w xml:id="w680">܆</w> <w xml:id="w681">ܠܳܐ</w> <w xml:id="w682">ܬ݁ܶܡܰܐܢ</w> <w xml:id="w683">ܠܟ݂ܽܘܢ</w> <w xml:id="w684">ܠܡܶܥܒ݁ܰܕ݂</w>
                    <w xml:id="w685">ܕ݁ܫܰܦ݁ܺܝܪ</w> <w xml:id="w686">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w687">ܘܶܐܢ</w> <w xml:id="w688">ܐ̱ܢܳܫ</w> <w xml:id="w689">ܠܳܐ</w> <w xml:id="w690">ܡܶܫܬ݁ܡܰܥ</w> <w xml:id="w691">ܠܡܶܠܰܝܢ̈</w> <w xml:id="w692">ܗܳܠܶܝܢ</w> <w xml:id="w693">ܕ݁ܒ݂ܶܐܓ݁ܰܪܬ݁ܳܐ</w> <w xml:id="w694">܆</w>
                    <w xml:id="w695">ܢܶܬ݂ܦ݁ܪܶܫ</w> <w xml:id="w696">ܠܟ݂ܽܘܢ</w> <w xml:id="w697">ܗܳܢܳܐ</w> <w xml:id="w698">.</w> <w xml:id="w699">ܘܠܳܐ</w> <w xml:id="w700">ܗܘܰܝܬ݁ܽܘܢ</w> <w xml:id="w701">ܡܶܬ݂ܚܰܠܛܺܝܢ</w> <w xml:id="w702">ܥܰܡܶܗ</w> <w xml:id="w703">܁</w> <w xml:id="w704">ܕ݁ܢܶܒ݂ܗܰܬ݂</w> <w xml:id="w705">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w706">ܘܠܳܐ</w> <w xml:id="w707">ܐܰܝܟ݂</w> <w xml:id="w708">ܒ݁ܥܶܠܕ݁ܒ݂ܳܒ݂ܳܐ</w> <w xml:id="w709">ܬ݁ܶܐܚܕ݁ܽܘܢܶܗ</w> <w xml:id="w710">܇</w> <w xml:id="w711">ܐܶܠܳܐ</w> <w xml:id="w712">ܗܘܰܝܬ݁ܽܘܢ</w>
                    <w xml:id="w713">ܡܰܪܬ݁ܶܝܢ</w> <w xml:id="w714">ܠܶܗ</w> <w xml:id="w715">ܐܰܝܟ݂</w> <w xml:id="w716">ܕ݁ܠܰܐܚܳܐ</w> <w xml:id="w717">܀</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w718">ܗܽܘ</w> <w xml:id="w719">ܕ݁ܶܝܢ</w> <w xml:id="w720">ܡܳܪܶܗ</w> <w xml:id="w721">ܕ݁ܰܫܠܳܡܳܐ</w> <w xml:id="w722">ܢܶܬ݁ܶܠ</w> <w xml:id="w723">ܠܟ݂ܽܘܢ</w> <w xml:id="w724">ܫܠܳܡܳܐ</w> <w xml:id="w725">ܒ݁ܟ݂ܽܠܙܒ݂ܰܢ</w>
                    <w xml:id="w726">ܒ݁ܟ݂ܽܠܡܶܕ݁ܶܡ</w> <w xml:id="w727">.</w> <w xml:id="w728">ܡܳܪܰܢ</w> <w xml:id="w729">ܥܰܡ</w> <w xml:id="w730">ܟ݁ܽܠܟ݂ܽܘܢ</w> <w xml:id="w731">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w732">ܫܠܳܡܳܐ</w> <w xml:id="w733">ܒ݁ܰܟ݂ܬ݂ܳܒ݂ܰܬ݂</w> <w xml:id="w734">ܐܺܝܕ݂ܰܝ̈</w> <w xml:id="w735">܆</w> <w xml:id="w736">ܐܶܢܳܐ</w> <w xml:id="w737">ܦ݁ܰܘܠܳܘܣ</w> <w xml:id="w738">ܟ݁ܶܬ݂ܒ݁ܶܬ݂</w> <w xml:id="w739">܇</w>
                    <w xml:id="w740">ܕ݁ܺܐܝܬ݂ܰܘܗ̱ܝ</w> <w xml:id="w741">ܐܳܬ݂ܳܐ</w> <w xml:id="w742">ܕ݁ܰܒ݂ܟ݂ܽܠܗܶܝܢ</w> <w xml:id="w743">ܐܶܓ݁ܪܳܬ݂ܝ̈</w> <w xml:id="w744">.</w> <w xml:id="w745">ܗܳܟ݂ܰܢܳܐ</w> <w xml:id="w746">ܟ݁ܳܬ݂ܶܒ݂</w> <w xml:id="w747">ܐ̱ܢܳܐ</w> <w xml:id="w748">.</w></p>
               </div>
               <div type="textpart" subtype="verse" n="18">
                  <p><w xml:id="w749">ܛܰܝܒ݁ܽܘܬ݂ܶܗ</w> <w xml:id="w750">ܕ݁ܡܳܪܰܢ</w> <w xml:id="w751">ܝܶܫܽܘܥ</w> <w xml:id="w752">ܡܫܺܝܚܳܐ</w> <w xml:id="w753">ܥܰܡ</w> <w xml:id="w754">ܟ݁ܽܠܟ݂ܽܘܢ</w> <w xml:id="w755">܂</w> <w xml:id="w756">ܐܰܡܺܝܢ</w>
                    <w xml:id="w757">܀</w><w xml:id="w758">.</w><w xml:id="w759">܀</w><w xml:id="w760">.</w><w xml:id="w761">܀</w><w xml:id="w762">܀</w></p>
               </div>
            </div>
         </div>
      </body>
