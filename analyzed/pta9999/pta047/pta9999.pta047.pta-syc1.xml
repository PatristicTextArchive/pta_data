               </div>
               <div type="textpart" subtype="verse" n="6">
                  <p><w xml:id="w511">ܩܡ</w> <w xml:id="w512">ܘܡܫܚܗ̇</w> <w xml:id="w513">ܠܐܪܥܐ</w> <w xml:id="w514">ܚܪ</w> <w xml:id="w515">ܘܕܓܠ</w> <w xml:id="w516">ܥܡ̈ܡܐ</w> <w xml:id="w517">ܐܬܒܕܪܘ</w> <w xml:id="w518">ܛܘܪ̈ܐ</w> <w xml:id="w519">ܕܡܢ</w> <w xml:id="w520">ܥܠܡ</w> <w xml:id="w521">ܘܐܬܡܟܟ</w> <w xml:id="w522">ܪ̈ܡܬܐ</w> <w xml:id="w523">ܕܡܢܥܠܡܝܢ</w> <w xml:id="w524">ܕܝܠܗ</w> <w xml:id="w525">ܐܢܝܢ</w> <w xml:id="w526">ܗ̈ܠܟܬܐ</w> <w xml:id="w527">ܕܡܢ</w> <w xml:id="w528">ܥܠܡ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="7">
                  <p><w xml:id="w529">ܬܚܝܬ</w> <w xml:id="w530">ܐܘܢ</w> <w xml:id="w531">ܚܙܝܬ</w> <w xml:id="w532">ܡܫܟܢܐ</w> <w xml:id="w533">ܕܟܘܫܢ</w> <w xml:id="w534">ܢܙ̈ܘܥܢ</w> <w xml:id="w535">ܝܪ̈ܝܥܬܐ</w> <w xml:id="w536">ܕܐܪܥܐ</w> <w xml:id="w537">ܕܡܕܝܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="8">
                  <p><w xml:id="w538">ܥܠ</w> <w xml:id="w539">ܢܗܪ̈ܘܬܐ</w> <w xml:id="w540">ܪܓܙ</w> <w xml:id="w541">ܡܪܝܐ</w> <w xml:id="w542">ܒܢܗܪ̈ܘܬܐ</w> <w xml:id="w543">ܪܘܓܙܟ</w> <w xml:id="w544">ܘܒܝܡܐ</w> <w xml:id="w545">ܚܐܦܟ</w> <w xml:id="w546">ܪܟܒܬ</w> <w xml:id="w547">ܥܠ</w> <w xml:id="w548">ܪ̈ܟܫܟ</w> <w xml:id="w549">ܘܥܠܡܪܟܒܬܐ</w> <w xml:id="w550">ܕܦܘܪܩܢܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="9">
                  <p><w xml:id="w551">ܡܬܬܥܪܘ</w> <w xml:id="w552">ܬܬܥܝܪ</w> <w xml:id="w553">ܩܫܬܟ</w> <w xml:id="w554">ܘܢܣܒܥܘܢ</w> <w xml:id="w555">ܓܐܪ̈ܐ</w> <w xml:id="w556">ܒܡܐܡܪܟ</w> <w xml:id="w557">ܡܫܒܚܐ</w> <w xml:id="w558">ܘܐܪܥܐ</w> <w xml:id="w559">ܒܢܗܪ̈ܘܬܐ</w> <w xml:id="w560">ܬܬܚܪܬ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="10">
                  <p><w xml:id="w561">ܚܙܐܘܟ</w> <w xml:id="w562">ܛܘܪ̈ܐ</w> <w xml:id="w563">ܘܙܥܘ</w> <w xml:id="w564">ܘܙܪܝܦܬܐ</w> <w xml:id="w565">ܕܡ̈ܝܐ</w> <w xml:id="w566">ܥܒܪܬ</w> <w xml:id="w567">ܘܐܪܝܡ</w> <w xml:id="w568">ܬܗܘܡܐ</w> <w xml:id="w569">ܩܠܗ</w> <w xml:id="w570">ܘܪܘܡܐ</w> <w xml:id="w571">ܕܐܝ̈ܕܘܗܝܫܩܠ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="11">
                  <p><w xml:id="w572">ܫܡܫܐ</w> <w xml:id="w573">ܘܣܗܪܐ</w> <w xml:id="w574">ܩܡܘ</w> <w xml:id="w575">ܒܡܕܝܪ̈ܝܗܘܢ</w> <w xml:id="w576">ܘܒܢܘܗܪܐ</w> <w xml:id="w577">ܕܓܐܪ̈ܝܟ</w> <w xml:id="w578">ܡܗܠܟܝܢ</w> <w xml:id="w579">ܘܒܙܗܪܐ</w> <w xml:id="w580">ܕܒܪ̈ܩܐܕܢܝ̈ܙܟܝܟ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="12">
                  <p><w xml:id="w581">ܒܚܡܬܐ</w> <w xml:id="w582">ܬܕܪܘܟ</w> <w xml:id="w583">ܥܠ</w> <w xml:id="w584">ܐܪܥܐ</w> <w xml:id="w585">ܘܒܪܘܓܙܐ</w> <w xml:id="w586">ܬܕܘܫ</w> <w xml:id="w587">ܥܡ̈ܡܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="13">
                  <p><w xml:id="w588">ܢܦܩܬ</w> <w xml:id="w589">ܠܡܦܪܩ</w> <w xml:id="w590">ܠܥܡܟ</w> <w xml:id="w591">ܘܠܡܦܪܩ</w> <w xml:id="w592">ܠܡܫܝܚܟ</w> <w xml:id="w593">ܦܣܩܬ</w> <w xml:id="w594">ܪܝܫܐ</w> <w xml:id="w595">ܡܢ</w> <w xml:id="w596">ܒܝܬܗ</w> <w xml:id="w597">ܕܥ̇ܘܠܐ</w> <w xml:id="w598">ܘܐܫܠܚܬܝܗܝ</w> <w xml:id="w599">ܡܢܫܬܐ̈ܣܘܗܝ</w> <w xml:id="w600">ܘܥܕܡܐ</w> <w xml:id="w601">ܠܨܘܪܗ</w> <w xml:id="w602">ܠܥܠܡܝܢ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="14">
                  <p><w xml:id="w603">ܦܚܬܬ</w> <w xml:id="w604">ܒܚܘܛܪ̈ܘܗܝ</w> <w xml:id="w605">ܪ̈ܝܫܐ</w> <w xml:id="w606">ܕܫ̈ܠܝܛܢܘܗܝ</w> <w xml:id="w607">ܕܐܬܬܟܠܘ</w> <w xml:id="w608">ܒܫܝܚܢܘܬܗܘܢ</w> <w xml:id="w609">ܕܢܐܟܠܘܢ</w> <w xml:id="w610">ܒܛܘܫܝܐܠܡܣ̈ܟܢܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="15">
                  <p><w xml:id="w611">ܕܪܟܬ</w> <w xml:id="w612">ܒܝܡܐ</w> <w xml:id="w613">ܥܠ</w> <w xml:id="w614">ܪ̈ܟܫܟ</w> <w xml:id="w615">ܘܟܢܫܐ</w> <w xml:id="w616">ܕܡ̈ܝܐ</w> <w xml:id="w617">ܣ̈ܓܝܐܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="16">
                  <p><w xml:id="w618">ܫܡܥܬ</w> <w xml:id="w619">ܘܙܥܬ</w> <w xml:id="w620">ܟܪܣܝ</w> <w xml:id="w621">ܠܘܩܒܠ</w> <w xml:id="w622">ܡܡܠܠܐ</w> <w xml:id="w623">ܕܣ̈ܦܘܬܝ</w> <w xml:id="w624">ܥܠ</w> <w xml:id="w625">ܪܬܝܬܐ</w> <w xml:id="w626">ܒܓܪ̈ܡܝ</w> <w xml:id="w627">ܘܒܘܪ̈ܟܝ</w> <w xml:id="w628">ܙܥ</w> <w xml:id="w629">ܕܒܕܩ</w> <w xml:id="w630">ܠܝܘܚܘܝܢܝ</w> <w xml:id="w631">ܝܘܡܐ</w> <w xml:id="w632">ܕܐܘܠܨܢܐ</w> <w xml:id="w633">ܕܐܬܐ</w> <w xml:id="w634">ܥܠ</w> <w xml:id="w635">ܥܡܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="17">
                  <p><w xml:id="w636">ܡܛܠ</w> <w xml:id="w637">ܕܬܬܐ</w> <w xml:id="w638">ܠܐ</w> <w xml:id="w639">ܦܪܥܬ</w> <w xml:id="w640">ܘܠܝܬ</w> <w xml:id="w641">ܛܪ̈ܦܐ</w> <w xml:id="w642">ܒܓܦܬܐ</w> <w xml:id="w643">ܟܕܒ</w> <w xml:id="w644">ܐܒܗ</w> <w xml:id="w645">ܕܙܝܬܐ</w> <w xml:id="w646">ܘܐܕܪ̈ܐ</w> <w xml:id="w647">ܠܐ</w> <w xml:id="w648">ܥܒܕܘ</w> <w xml:id="w649">ܥܒܘܪܐܓܡܪܬ</w> <w xml:id="w650">ܥܢܐ</w> <w xml:id="w651">ܡܢ</w> <w xml:id="w652">ܓܙܪ̈ܐ</w> <w xml:id="w653">ܘܠܝܬ</w> <w xml:id="w654">ܬܘܪ̈ܐ</w> <w xml:id="w655">ܒܒܩܪ̈ܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="18">
                  <p><w xml:id="w656">ܐܢܐ</w> <w xml:id="w657">ܕܝܢ</w> <w xml:id="w658">ܒܡܪܝܐ</w> <w xml:id="w659">ܐܕܘܨ</w> <w xml:id="w660">ܘܐܪܘܙ</w> <w xml:id="w661">ܒܐܠܗܐ</w> <w xml:id="w662">ܦܪܘܩܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w663">ܡܪܐ</w> <w xml:id="w664">ܡܪ̈ܘܬܐ</w> <w xml:id="w665">ܚܝܠܝ</w> <w xml:id="w666">ܕܥܒܕ</w> <w xml:id="w667">ܪ̈ܓܠܝ</w> <w xml:id="w668">ܐܝܟ</w> <w xml:id="w669">ܕܐܝܠܐ</w> <w xml:id="w670">ܘܥܠ</w> <w xml:id="w671">ܪܘܡܝ</w> <w xml:id="w672">ܐܩܝܡܢܝ</w> <w xml:id="w673">ܕܐܙܡܪ</w> <w xml:id="w674">ܒܬܫ̈ܒܚܬܗ</w></p>
               </div>
            </div>
         </div>
      </body>
   </text>
