               </div>
               <div type="textpart" subtype="verse" n="19">
                  <p><w xml:id="w514">ܕܠܝܬ</w> <w xml:id="w515">ܙܪܥܐ</w> <w xml:id="w516">ܒܐܕܪܐ</w> <w xml:id="w517">ܘܓܦܬܐ</w> <w xml:id="w518">ܘܬܬܐ</w> <w xml:id="w519">ܘܪ̈ܘܡܢܐ</w> <w xml:id="w520">ܘܐ̈ܝܠܢܐ</w> <w xml:id="w521">ܕܙܝܬܐ</w> <w xml:id="w522">ܠܐ</w> <w xml:id="w523">ܛܥܢܘ</w> <w xml:id="w524">ܘܡܢ</w> <w xml:id="w525">ܝܘܡܢܐܒܪܟ</w> <w xml:id="w526">ܐܢܐ</w> <w xml:id="w527">ܠܗܘܢ</w> <w xml:id="w528">ܐܡܪ</w> <w xml:id="w529">ܡܪܝܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="20">
                  <p><w xml:id="w530">ܘܗܘܐ</w> <w xml:id="w531">ܦܬܓܡܗ</w> <w xml:id="w532">ܕܡܪܝܐ</w> <w xml:id="w533">ܥܠ</w> <w xml:id="w534">ܚܓܝ</w> <w xml:id="w535">ܕܬܪ̈ܬܝܢ</w> <w xml:id="w536">ܙܒ̈ܢܝܢ</w> <w xml:id="w537">ܒܐܪ̈ܒܥܐ</w> <w xml:id="w538">ܘܥܣܪ̈ܝܢ</w> <w xml:id="w539">ܒܝܪܚܐ</w> <w xml:id="w540">ܠܡܐܡܪ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="21">
                  <p><w xml:id="w541">ܐܡܪ</w> <w xml:id="w542">ܠܙܘܪܒܒܠ</w> <w xml:id="w543">ܪܒܐ</w> <w xml:id="w544">ܕܝܗܘܕܐ</w> <w xml:id="w545">ܐܢܐ</w> <w xml:id="w546">ܐܙܝܥ</w> <w xml:id="w547">ܫܡܝܐ</w> <w xml:id="w548">ܘܐܪܥܐ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="22">
                  <p><w xml:id="w549">ܘܐܗܦܟ</w> <w xml:id="w550">ܟܘܪܣܝܐ</w> <w xml:id="w551">ܕܡ̈ܠܟܘܬܐ</w> <w xml:id="w552">ܘܐܘܒܕ</w> <w xml:id="w553">ܥܘܫܢܐ</w> <w xml:id="w554">ܕܡ̈ܠܟܘܬܐ</w> <w xml:id="w555">ܕܥܡ̈ܡܐ</w> <w xml:id="w556">ܘܐܗܦܟ</w> <w xml:id="w557">ܡܪ̈ܟܒܬܐ</w> <w xml:id="w558">ܥܠܪ̈ܟܒܝܗܝܢ</w> <w xml:id="w559">ܘܢܦܠܘܢ</w> <w xml:id="w560">ܪ̈ܟܫܐ</w> <w xml:id="w561">ܘܪ̈ܟܒܝܗܘܢ</w> <w xml:id="w562">ܓܒܪ</w> <w xml:id="w563">ܒܣܦܣܪܐ</w> <w xml:id="w564">ܕܐܚܘܗܝ</w></p>
               </div>
               <div type="textpart" subtype="verse" n="23">
                  <p><w xml:id="w565">ܒܗ</w> <w xml:id="w566">ܒܝܘܡܐ</w> <w xml:id="w567">ܗ̇ܘ</w> <w xml:id="w568">ܐܡܪ</w> <w xml:id="w569">ܡܪܝܐ</w> <w xml:id="w570">ܚܝܠܬܢܐ</w> <w xml:id="w571">ܐܣܒܟ</w> <w xml:id="w572">ܙܘܪܒܒܠ</w> <w xml:id="w573">ܒܪ</w> <w xml:id="w574">ܫܠܬܐܝܠ</w> <w xml:id="w575">ܥܒܕܝ</w> <w xml:id="w576">ܐܡܪ</w> <w xml:id="w577">ܡܪܝܐܘܐܣܝܡܟ</w> <w xml:id="w578">ܐܝܟ</w> <w xml:id="w579">ܚܬܡܐ</w> <w xml:id="w580">ܡܛܠ</w> <w xml:id="w581">ܕܠܟ</w> <w xml:id="w582">ܓܒܝܬ</w> <w xml:id="w583">ܐܡܪ</w> <w xml:id="w584">ܡܪܝܐ</w> <w xml:id="w585">ܚܝܠܬܢܐ</w></p>
               </div>
            </div>
         </div>
      </body>
