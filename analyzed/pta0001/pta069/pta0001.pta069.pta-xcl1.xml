            </head>
            <div type="textpart" subtype="section" n="1">
               <p> <w xml:id="w11">ԵՏԵՍ</w> <w xml:id="w12">զտէր</w> <w xml:id="w13">փրկիչ</w> <w xml:id="w14">եւ</w> <w xml:id="w15">զաստուած</w> <w xml:id="w16">կենարար</w> <w xml:id="w17">թշնամին</w> <w xml:id="w18">ճշմարտութեան</w><w xml:id="w19">`</w> <w xml:id="w20">քարոզեալ</w><w xml:id="w21">,</w> <w xml:id="w22">եւ</w> <w xml:id="w23">խռովեցաւ</w><w xml:id="w24">.</w> <w xml:id="w25">ետես</w> <w xml:id="w26">զտէրունական</w> <w xml:id="w27">գալուստն</w> <w xml:id="w28">յաւանակաւ</w><w xml:id="w29">,</w> <w xml:id="w30">փառաւորեալ</w> <w xml:id="w31">'ի</w> <w xml:id="w32">մէնջ</w> <w xml:id="w33">իբրեւ</w> <w xml:id="w34">յառաջինն</w><w xml:id="w35">,</w> <w xml:id="w36">եւ</w> <w xml:id="w37">ջանացաւ</w> <w xml:id="w38">'ի</w> <w xml:id="w39">խռովել</w> <w xml:id="w40">'ի</w> <w xml:id="w41">շաչիւն</w> <w xml:id="w42">կառաց</w> <w xml:id="w43">թրթրականաց</w><w xml:id="w44">`</w> <w xml:id="w45">առ</w> <w xml:id="w46">'ի</w> <w xml:id="w47">խափանել</w> <w xml:id="w48">զարշաւանս</w> <w xml:id="w49">յաւանակին</w><w xml:id="w50">,</w> <w xml:id="w51">որ</w> <w xml:id="w52">մեղմագնաց</w><w xml:id="w53">,</w> <w xml:id="w54">եւ</w> <w xml:id="w55">հանդարտագնաց</w> <w xml:id="w56">ոտիւք</w> <w xml:id="w57">խափանեաց</w> <w xml:id="w58">զկառամարտիկ</w> <w xml:id="w59">զերիվարս</w> <w xml:id="w60">պատերազմողաց</w><w xml:id="w61">.</w> <w xml:id="w62">քանզի</w> <w xml:id="w63">գիտէր</w><w xml:id="w64">,</w> <w xml:id="w65">եթէ</w> <w xml:id="w66">յովանակն</w> <w xml:id="w67">առ</w> <w xml:id="w68">'ի</w> <w xml:id="w69">պարտումն</w> <w xml:id="w70">կառաց</w> <w xml:id="w71">երիվարաց</w> <w xml:id="w72">պատրաստեցաւ</w><w xml:id="w73">.</w> <w xml:id="w74">քանզի</w> <w xml:id="w75">եկն</w> <w xml:id="w76">ձրկչին</w> <w xml:id="w77">յուանակաւ</w> <w xml:id="w78">ո'չ</w> <w xml:id="w79">եթէ</w> <w xml:id="w80">զտկարութիւն</w> <w xml:id="w81">ինչ</w> <w xml:id="w82">ցուցանէր</w><w xml:id="w83">,</w> <w xml:id="w84">այլ</w> <w xml:id="w85">զհեզութիւն</w> <w xml:id="w86">խոնարհութեան</w><w xml:id="w87">,</w> <w xml:id="w88">զի</w> <w xml:id="w89">զամբարտաւանութիւն</w> <w xml:id="w90">շիջուսցէ</w><w xml:id="w91">:</w> <w xml:id="w92">Եւ</w> <w xml:id="w93">քանզի</w> <w xml:id="w94">գիտէր</w> <w xml:id="w95">թշնամին</w><w xml:id="w96">,</w> <w xml:id="w97">եթէ</w> <w xml:id="w98">որ</w> <w xml:id="w99">ինչ</w> <w xml:id="w100">լինելոյ</w> <w xml:id="w101">են</w> <w xml:id="w102">իրք</w> <w xml:id="w103">ըստ</w> <w xml:id="w104">արգարէական</w> <w xml:id="w105">բարբառոյն</w><w xml:id="w106">,</w> <w xml:id="w107">նախանձեալ</w> <w xml:id="w108">քինացաւ</w> <w xml:id="w109">ընդ</w> <w xml:id="w110">յաւանակին</w><w xml:id="w111">.</w> <w xml:id="w112">այլ</w> <w xml:id="w113">զի</w> <w xml:id="w114">զհպարտութիւն</w> <w xml:id="w115">հպարտացելոյն</w> <w xml:id="w116">շիջուսցէ</w><w xml:id="w117">,</w> <w xml:id="w118">եւ</w> <w xml:id="w119">զմեծամեծ</w> <w xml:id="w120">ամբարտաւանութիւն</w> <w xml:id="w121">մեծամտեելոյ</w> <w xml:id="w122">'ի</w> <w xml:id="w123">կառս</w> <w xml:id="w124">եւ</w> <w xml:id="w125">յերիվարս</w> <w xml:id="w126">խոնարհեցուցէ</w><w xml:id="w127">:</w></p>
