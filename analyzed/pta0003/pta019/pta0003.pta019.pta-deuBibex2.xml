               <p>
            <w xml:id="w10">In</w> <w xml:id="w11">fünf</w> <w xml:id="w12">Abschnitte</w> <w xml:id="w13">nun</w> <w xml:id="w14">teilen</w> <w xml:id="w15">die</w> <w xml:id="w16">Juden</w> <w xml:id="w17">den</w> <w xml:id="w18">ganzen</w> <w xml:id="w19">Psalter</w> <w xml:id="w20">ein</w><w xml:id="w21">,</w> <w xml:id="w22">von</w> <w xml:id="w23">denen</w> <w xml:id="w24">der</w> <w xml:id="w25">erste</w> <w xml:id="w26">die</w> <w xml:id="w27">Psalmen</w> <w xml:id="w28">1</w><w xml:id="w29">–</w><w xml:id="w30">40</w><w xml:id="w31">,</w> <w xml:id="w32">der</w> <w xml:id="w33">zweite</w> <w xml:id="w34">die</w> <w xml:id="w35">Psalmen</w> <w xml:id="w36">41</w><w xml:id="w37">–</w><w xml:id="w38">71</w><w xml:id="w39">,</w> <w xml:id="w40">der</w> <w xml:id="w41">dritte</w> <w xml:id="w42">die</w> <w xml:id="w43">Psalmen</w> <w xml:id="w44">72</w><w xml:id="w45">–</w><w xml:id="w46">88</w><w xml:id="w47">,</w> <w xml:id="w48">der</w> <w xml:id="w49">vierte</w> <w xml:id="w50">die</w> <w xml:id="w51">Psalmen</w> <w xml:id="w52">89</w><w xml:id="w53">–</w><w xml:id="w54">105</w><w xml:id="w55">,</w> <w xml:id="w56">und</w> <w xml:id="w57">der</w> <w xml:id="w58">fünfte</w> <w xml:id="w59">die</w> <w xml:id="w60">Psalmen</w> <w xml:id="w61">von</w> <w xml:id="w62">106</w> <w xml:id="w63">bis</w> <w xml:id="w64">zum</w> <w xml:id="w65">Schluss</w> <w xml:id="w66">des</w> <w xml:id="w67">Buches</w> <w xml:id="w68">enthält</w><w xml:id="w69">.</w>
          </p>
               <p>
