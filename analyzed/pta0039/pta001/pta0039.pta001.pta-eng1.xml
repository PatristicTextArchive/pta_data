                  </quote><w xml:id="w67">.</w> <w xml:id="w68">Because</w> <w xml:id="w69">on</w> <w xml:id="w70">the</w> <w xml:id="w71">holy</w> <w xml:id="w72">day</w> <w xml:id="w73">of</w> <w xml:id="w74">the</w> <w xml:id="w75">Lord</w> <seg type="allusion"><w xml:id="w76">the</w> <w xml:id="w77">archangel</w> <w xml:id="w78">Gabrial</w> <w xml:id="w79">announced</w> <w xml:id="w80">to</w> <w xml:id="w81">the</w> <w xml:id="w82">Mother</w> <w xml:id="w83">of</w> <w xml:id="w84">God</w> <w xml:id="w85">the</w> <w xml:id="w86">conception</w><ref decls="#biblical" cRef="NA:Lk:1:26-33"/>
