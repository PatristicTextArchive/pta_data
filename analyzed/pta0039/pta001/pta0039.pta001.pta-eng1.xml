                  </seg><w xml:id="w103">.</w> <w xml:id="w104">And</w> <w xml:id="w105">on</w> <w xml:id="w106">the</w> <w xml:id="w107">holy</w> <w xml:id="w108">day</w> <w xml:id="w109">of</w> <w xml:id="w110">the</w> <w xml:id="w111">Lord</w> <seg type="allusion"><w xml:id="w112">he</w> <w xml:id="w113">received</w> <w xml:id="w114">the</w> <w xml:id="w115">baptism</w> <w xml:id="w116">from</w> <w xml:id="w117">the</w> <w xml:id="w118">hand</w> <w xml:id="w119">of</w> <w xml:id="w120">the</w> <w xml:id="w121">forerunner</w><ref decls="#biblical" cRef="NA:Lk:3:21"/>
