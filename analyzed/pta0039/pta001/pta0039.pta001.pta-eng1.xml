            <div type="textpart" subtype="section" n="1">
               <p><w xml:id="w27">Hear</w><w xml:id="w28">,</w> <w xml:id="w29">all</w> <w xml:id="w30">brother</w> <w xml:id="w31">Christians</w><w xml:id="w32">,</w> <w xml:id="w33">what</w> <w xml:id="w34">the</w> <w xml:id="w35">prophets</w> <w xml:id="w36">say</w><w xml:id="w37">:</w> <quote><w xml:id="w38">Study</w> <w xml:id="w39">and</w> <w xml:id="w40">learn</w> <w xml:id="w41">that</w> <w xml:id="w42">I</w> <w xml:id="w43">am</w> <w xml:id="w44">God</w><ref decls="#biblical" cRef="LXX:Ps:45:11"/>
